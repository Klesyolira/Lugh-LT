"\/><\/svg>\n                    <input type=\"password\" id=\"password\" placeholder=\"Senha\">\n                    <div class=\"eye-toggle\" onclick=\"togglePasswordVisibility('password', this)\">\n                        <svg class=\"eye-icon\" viewBox=\"0 0 24 24\"><path d=\"M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z\"\/><\/svg>\n                    <\/div>\n                <\/div>\n            <\/div>\n\n            <div class=\"input-wrapper hidden\" id=\"v2rayCredentialsFields\">\n                <svg class=\"field-icon\" viewBox=\"0 0 24 24\"><path d=\"M12.65 11.65c-.32-.32-.75-.47-1.18-.44l-2.06 2.06c.03.43-.12.86-.44 1.18L4 19.34V22h2.66l4.89-4.89c.32-.32.47-.75.44-1.18l2.06-2.06c.43.03.86-.12 1.18-.44l1.42-1.42-3.14-3.14-1.42 1.42zm7.07-7.07c-1.17-1.17-3.07-1.17-4.24 0l-1.41 1.41 4.24 4.24 1.41-1.41c1.17-1.17 1.17-3.07 0-4.24z\"\/><\/svg>\n                <input type=\"password\" id=\"v2ray_uuid\" placeholder=\"UUID XRAY \/ V2Ray\">\n            <\/div>\n        <\/div>\n        \n        <button id=\"connectBtn\" class=\"btn btn-purple\" onclick=\"toggleConnect()\">CONECTAR<\/button>\n        \n        <div class=\"status-container\">\n            <div class=\"status-badge\">\n                <svg width=\"10\" height=\"10\" fill=\"#00f3ff\" viewBox=\"0 0 24 24\" style=\"animation: pulseDot 1s infinite;\"><circle cx=\"12\" cy=\"12\" r=\"10\"\/><\/svg>\n                Status: <span id=\"statusText\">DESCONECTADO<\/span>\n            <\/div>\n            <div id=\"timerDisplay\">00:00:00<\/div>\n        <\/div>\n\n        <button class=\"btn btn-green\" onclick=\"openRenewUrl()\">Comprar ou Renovar<\/button>\n\n        <div class=\"btn-group\">\n            <button class=\"btn btn-dark\" onclick=\"checkAppUpdate()\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z\"\/><\/svg>\n                Atualizar\n            <\/button>\n            <button class=\"btn btn-dark\" onclick=\"Android.openServers()\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z\"\/><\/svg>\n                Lista Servidores\n            <\/button>\n        <\/div>\n\n        <button class=\"btn btn-outline\" id=\"termsBtn\">Termos de uso<\/button>\n\n    <\/div>\n\n    <!-- MODAIS DE INTERFACE (SERV, INFO, ETC) -->\n    <div class=\"modal-overlay\" id=\"serversModalOverlay\">\n        <div class=\"modal-card\">\n            <div class=\"modal-header\">\n                <div class=\"modal-title\">Selecionar Conexão<\/div>\n                <div class=\"modal-close\" id=\"closeServersModalBtn\"><svg viewBox=\"0 0 24 24\"><path d=\"M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z\"\/><\/svg><\/div>\n            <\/div>\n            <div class=\"modal-body\" id=\"serverListContainer\"><\/div>\n        <\/div>\n    <\/div>\n\n    <!-- CONFIGURAÇÕES -->\n    <div class=\"modal-overlay\" id=\"configModalOverlay\">\n        <div class=\"modal-card\">\n            <div class=\"modal-header\">\n                <div class=\"modal-title\">Ajustes de Conexão<\/div>\n                <div class=\"modal-close\" id=\"closeConfigModalBtn\"><svg viewBox=\"0 0 24 24\"><path d=\"M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z\"\/><\/svg><\/div>\n            <\/div>\n            <div class=\"modal-body\">\n                <button class=\"btn btn-dark\" style=\"width:100%;\" onclick=\"clearLocalLogs()\">Limpar Dados\/Cache<\/button>\n            <\/div>\n        <\/div>\n    <\/div>\n\n    <!-- REGISTROS (LOGS) -->\n    <div class=\"modal-overlay\" id=\"loggerModalOverlay\">\n        <div class=\"modal-card full-height-modal\">\n            <div class=\"modal-header header-centered\">\n                <div class=\"modal-close\" onclick=\"clearLocalLogs()\" style=\"background: rgba(255,255,255,0.08);\"><svg viewBox=\"0 0 24 24\" style=\"fill:#ffffff;\"><path d=\"M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z\"\/><\/svg><\/div>\n                <div class=\"modal-title\">REGISTRO<\/div>\n                <div class=\"modal-close\" id=\"closeLoggerModalBtn\" style=\"background: rgba(255,255,255,0.08);\"><svg viewBox=\"0 0 24 24\" style=\"fill:#ffffff;\"><path d=\"M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z\"\/><\/svg><\/div>\n            <\/div>\n            <div class=\"modal-body logger-body\">\n                <div class=\"logs-text-area\" id=\"fullLogContent\">Aguardando logs do sistema...<\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n\n    <div class=\"toast-container\" id=\"toastContainer\"><\/div>\n\n    <script>\n        \/\/ Imagens customizadas\n        const customLogoUrl = getComputedStyle(document.documentElement).getPropertyValue('--logo-image-url').trim().replace(\/^url\\([\"']?\/, '').replace(\/[\"']?\\)$\/, '');\n        if (customLogoUrl && customLogoUrl !== '') document.getElementById('appLogo').src = customLogoUrl; \n\n        \/\/ Variáveis Locais\n        let currentServers = [];\n        let selectedConfigId = 0;\n        let selectedConfigMode = \"ssh\";\n        let isConnected = false;\n        let isConnecting = false;\n        let timerInterval = null;\n        let timerStart = 0;\n\n        \/* TOAST E MODAIS *\/\n        window.showToast = function(message) {\n            const container = document.getElementById('toastContainer');\n            const toast = document.createElement('div');\n            toast.className = 'toast'; toast.innerText = message;\n            container.appendChild(toast);\n            setTimeout(() => toast.remove(), 3000);\n        };\n\n        const modais = {\n            servers: { overlay: document.getElementById('serversModalOverlay'), btn: document.getElementById('serverSelectorBtn'), close: document.getElementById('closeServersModalBtn') },\n            config: { overlay: document.getElementById('configModalOverlay'), btn: document.getElementById('gearIcon'), close: document.getElementById('closeConfigModalBtn') },\n            logger: { overlay: document.getElementById('loggerModalOverlay'), btn: document.getElementById('logsIcon'), close: document.getElementById('closeLoggerModalBtn') }\n        };\n\n        Object.keys(modais).forEach(key => {\n            modais[key].btn?.addEventListener('click', () => modais[key].overlay.classList.add('active'));\n            modais[key].close?.addEventListener('click', () => modais[key].overlay.classList.remove('active'));\n        });\n\n        \/\/ Visibilidade Senha e Nome do Usuário\n        function togglePasswordVisibility(fieldId, element) {\n            const inputField = document.getElementById(fieldId);\n            const isPassword = inputField.type === \"password\";\n            inputField.type = isPassword ? \"text\" : \"password\";\n        }\n        document.getElementById('username').addEventListener('input', function() {\n            const val = this.value.trim();\n            document.getElementById('dynamicName').textContent = val !== \"\" ? val.charAt(0).toUpperCase() + val.slice(1) : 'visitante';\n        });\n\n        \/* FUNÇÕES DE INTEGRAÇÃO COM ANDROID (WEBAPPBRIDGE) *\/\n        \n        \/\/ 1. Início e Carga\n        window.onload = function() {\n            if (typeof Android !== 'undefined') {\n                \/\/ Preenche Usuário e Senha salvas\n                try {\n                    const creds = JSON.parse(Android.getSavedCredentials());\n                    if(creds.sshUser) { document.getElementById('username').value = creds.sshUser; document.getElementById('username').dispatchEvent(new Event('input')); }\n                    if(creds.sshPass) { document.getElementById('password').value = creds.sshPass; }\n                    if(creds.xrayId || creds.v2uuid) { document.getElementById('v2ray_uuid').value = creds.xrayId || creds.v2uuid; }\n                } catch(e) {}\n\n                loadServersFromAndroid();\n                \n                \/\/ Monitoramento (Polling) - O JS atualiza status e logs nativos da Bridge\n                setInterval(() => {\n                    const currentStatus = Android.getStatus();\n                    window.onStatusChanged(currentStatus);\n                    \n                    try {\n                        const logs = JSON.parse(Android.getLogs());\n                        const box = document.getElementById('fullLogContent');\n                        if(logs && logs.length > 0) {\n                            box.innerHTML = logs.map(l => `<div><span style=\"color:#00f3ff\">[${l.time}]<\/span> <strong style=\"color:#a855f7\">${l.level}<\/strong>: ${l.message}<\/div>`).join('');\n                        }\n                    } catch (e) {}\n                }, 1000);\n            }\n            setDisconnectedUI();\n        };\n\n        \/\/ 2. Chamar Chat Nativo via Bridge\n        function openSupportChat() {\n            if (typeof Android !== 'undefined') {\n                window.showToast(\"Iniciando chat de suporte...\");\n                try {\n                    Android.openChat();\n                } catch (e) {\n                    console.error(\"Erro ao tentar abrir chat nativo\", e);\n                }\n            } else {\n                window.showToast(\"Chat indisponível fora do aplicativo Android.\");\n            }\n        }\n\n        \/\/ 3. Carregar Servidores Customizados\n        function loadServersFromAndroid() {\n            if (typeof Android === 'undefined') return;\n            try {\n                let serversJson = Android.getMultiServers();\n                let serverList = JSON.parse(serversJson);\n                let isPremium = true;\n\n                if (!serverList || serverList.length === 0) {\n                    serversJson = Android.getServers();\n                    serverList = JSON.parse(serversJson);\n                    isPremium = false;\n                }\n\n                \/\/ Renderiza na tela\n                renderServerList([{ category: isPremium ? \"SERVIDORES PREMIUM\" : \"SERVIDORES\", servers: serverList }]);\n\n                \/\/ Puxa o selecionado do Android\n                const selectedJson = isPremium ? Android.getSelectedMultiServer() : Android.getSelectedServer();\n                const selected = JSON.parse(selectedJson);\n\n                if (selected && selected.Name) {\n                    const mode = selected.Info.toLowerCase().includes('xray') || selected.Info.toLowerCase().includes('v2ray') ? 'xray' : 'ssh';\n                    window.selectServer(selected.position, selected.Name, selected.Info, mode, selected.FlagUrl);\n                }\n            } catch(e) { console.error(\"Erro renderizando servidores\", e); }\n        }\n\n        window.renderServerList = function(groups) {\n            const container = document.getElementById('serverListContainer');\n            container.innerHTML = '';\n            if (!groups || groups.length === 0) {\n                container.innerHTML = '<div style=\"color:var(--text-dim); text-align:center;\">Nenhum servidor encontrado.<\/div>';\n                return;\n            }\n            \n            groups.forEach(group => {\n                const header = document.createElement('div');\n                header.className = 'category-header active';\n                header.innerHTML = `<span>${group.category}<\/span>`;\n                \n                const content = document.createElement('div');\n                content.className = 'category-content';\n                content.style.maxHeight = '55vh'; content.style.overflowY = 'auto';\n\n                group.servers.forEach((srv) => {\n                    const item = document.createElement('div');\n                    item.className = 'server-item';\n                    const mode = srv.Info.toLowerCase().includes('xray') ? 'xray' : 'ssh';\n\n                    item.innerHTML = `\n                        <div class=\"server-info-left\">\n                            <div class=\"server-icon-frame\">${srv.FlagUrl ? `<img src=\"${srv.FlagUrl}\">` : '🚀'}<\/div>\n                            <div class=\"server-text-details\">\n                                <span class=\"server-title\">${srv.Name}<\/span>\n                                <span class=\"server-desc\">${srv.Info}<\/span>\n                            <\/div>\n                        <\/div>\n                        <span class=\"server-mode-tag\">${mode.toUpperCase()}<\/span>\n                    `;\n                    item.addEventListener('click', () => {\n                        window.selectServer(srv.position, srv.Name, srv.Info, mode, srv.FlagUrl);\n                    });\n                    content.appendChild(item);\n                });\n                container.appendChild(header); container.appendChild(content);\n            });\n        };\n\n        window.selectServer = function(id, name, desc, mode, icon) {\n            selectedConfigId = id;\n            selectedConfigMode = mode;\n            document.getElementById('selectedName').textContent = name;\n\n            if (typeof Android !== 'undefined') {\n                try { Android.selectMultiServer(id); } catch(e){}\n            }\n\n            const sshFields = document.getElementById('sshCredentialsFields');\n            const v2rayFields = document.getElementById('v2rayCredentialsFields');\n\n            if (mode === 'xray' || mode === 'v2ray') {\n                sshFields.classList.add('hidden'); v2rayFields.classList.remove('hidden');\n            } else {\n                sshFields.classList.remove('hidden'); v2rayFields.classList.add('hidden');\n            }\n            \n            document.getElementById('serversModalOverlay').classList.remove('active');\n        };\n\n        \/\/ 4. Conectar e Desconectar adaptado para o Android.connect() (Toggle)\n        function toggleConnect() {\n            const user = document.getElementById('username')?.value.trim() || '';\n            const pass = document.getElementById('password')?.value.trim() || '';\n            const uuid = document.getElementById('v2ray_uuid')?.value.trim() || '';\n\n            if (isConnected || isConnecting) {\n                if (typeof Android !== 'undefined') { Android.connect(); } \n                setDisconnectedUI();\n                return;\n            }\n\n            if (selectedConfigMode === 'xray' || selectedConfigMode === 'v2ray') {\n                if(!uuid) { window.showToast(\"Informe o UUID!\"); return; }\n                if (typeof Android !== 'undefined') {\n                    Android.saveCredentials(user, pass, \"\", uuid, uuid);\n                    Android.connect();\n                }\n            } else {\n                if(!user || !pass) { window.showToast(\"Informe seu Usuário e Senha!\"); return; }\n                if (typeof Android !== 'undefined') {\n                    Android.saveCredentials(user, pass, \"\", \"\", \"\");\n                    Android.connect();\n                }\n            }\n            setConnectingUI();\n        }\n\n        \/\/ Callbacks de Atualização UI\n        function setConnectedUI() {\n            isConnected = true; isConnecting = false;\n            const btn = document.getElementById('connectBtn');\n            btn.innerHTML = \"DESCONECTAR\"; btn.className = \"btn btn-purple connected\";\n            document.getElementById('statusText').textContent = \"CONECTADO\"; document.getElementById('statusText').style.color = \"#ef4444\";\n            if (!timerInterval) { timerStart = Math.floor(Date.now() \/ 1000); timerInterval = setInterval(updateTimer, 1000); }\n        }\n\n        function setDisconnectedUI() {\n            isConnected = false; isConnecting = false;\n            const btn = document.getElementById('connectBtn');\n            btn.innerHTML = \"CONECTAR\"; btn.className = \"btn btn-purple\";\n            document.getElementById('statusText').textContent = \"DESCONECTADO\"; document.getElementById('statusText').style.color = \"#00f3ff\";\n            if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }\n            document.getElementById('timerDisplay').textContent = \"00:00:00\";\n        }\n\n        function setConnectingUI() {\n            isConnected = false; isConnecting = true;\n            const btn = document.getElementById('connectBtn');\n            btn.innerHTML = \"CONECTANDO...\"; btn.className = \"btn btn-purple connecting\";\n            document.getElementById('statusText').textContent = \"CONECTANDO...\"; document.getElementById('statusText').style.color = \"#ffaa00\";\n        }\n\n        window.onStatusChanged = function(status) {\n            if(!status) return;\n            const s = status.toUpperCase();\n            if (s === 'CONECTADO') { \n                if(!isConnected) setConnectedUI(); \n            } else if (s === 'DESCONECTADO') { \n                if(isConnected || isConnecting) setDisconnectedUI(); \n            } else { \n                if(!isConnecting) setConnectingUI(); \n            }\n        };\n\n        window.onConfigReloaded = function() { loadServersFromAndroid(); window.showToast(\"Atualizado!\"); };\n        window.onServerChanged = function() { loadServersFromAndroid(); };\n        window.onLogsCleared = function() { document.getElementById('fullLogContent').innerHTML = \"Logs limpos.\"; };\n\n        function clearLocalLogs() { if (typeof Android !== 'undefined') { Android.clearLogs(); } }\n        function checkAppUpdate() { if (typeof Android !== 'undefined') { window.showToast(\"Buscando atualizações...\"); Android.checkUpdate(); } }\n        function openRenewUrl() { window.open(getComputedStyle(document.documentElement).getPropertyValue('--telegram-renew-url').trim().replace(\/['\"]\/g, ''), '_blank'); }\n\n        \/\/ Timer\n        function updateTimer() {\n            const d = Math.floor(Date.now() \/ 1000) - timerStart;\n            const pad = n => String(n).padStart(2, '0');\n            document.getElementById('timerDisplay').textContent = pad(~~(d \/ 3600)) + ':' + pad(~~((d % 3600) \/ 60)) + ':' + pad(d % 60);\n        }\n    <\/script>\n<\/body>\n<\/html>@"
}
