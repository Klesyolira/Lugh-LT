=\"creds-input-wrap\">\n            <span class=\"ci-icon\">🔑</span>\n            <input type=\"text\" id=\"ci-udp-token\" placeholder=\"Token / Password UDP Auth\">\n        </div>\n\n        <div class=\"creds-section-title\">🌐 Ajustes V2Ray / XRay Core</div>\n        <div class=\"creds-input-wrap\">\n            <span class=\"ci-icon\">🆔</span>\n            <input type=\"text\" id=\"ci-v2ray-uuid\" placeholder=\"USER ID / UUID V2Ray / vmess://\">\n        </div>\n    </div>\n    <div class=\"creds-modal-footer\">\n        <button class=\"creds-cancel-btn modal-close\">Cancelar</button>\n        <button class=\"creds-save-btn\" id=\"btn-creds-save\">Salvar</button>\n    </div>\n</div>\n\n<!-- Toast -->\n<div class=\"toast-box\"><div class=\"toast\" id=\"toast\"></div></div>\n\n<script>\n(function () {\n'use strict';\n\n/* Seu bridge original */\nvar A = {\n    call: function (m, arg) {\n        try {\n            if (window.Android && typeof window.Android[m] === 'function')\n                return arg !== undefined ? window.Android[m](arg) : window.Android[m]();\n        } catch (e) { console.warn('Bridge.' + m, e); }\n        return null;\n    },\n    parse: function (raw, fb) {\n        try { return JSON.parse(raw) || fb; } catch (e) { return fb; }\n    },\n    saveCredentials: function (jsonStr) { A.call('saveCredentials', jsonStr); },\n    getSavedCredentials: function () {\n        return A.parse(A.call('getSavedCredentials'), {});\n    }\n};\n\n// ... TODO O SEU JAVASCRIPT ORIGINAL FICA AQUI (STATE, app, functions, boot, etc.) ...\n\n/* ==================== FUNÇÕES DE CREDENCIAIS ==================== */\nfunction loadSavedCredentials() {\n    try {\n        var creds = A.getSavedCredentials() || {};\n        document.getElementById('ci-ssh-user').value = creds.sshUser || '';\n        document.getElementById('ci-ssh-pass').value = creds.sshPass || '';\n        document.getElementById('ci-udp-token').value = creds.udpToken || '';\n        document.getElementById('ci-v2ray-uuid').value = creds.v2uuid || '';\n    } catch (e) {\n        console.warn('loadSavedCredentials', e);\n    }\n}\n\nfunction openCredsModal() {\n    loadSavedCredentials();\n    openModal('modal-creds');\n}\n\n// Substitua ou adicione no seu bind()\ndocument.getElementById('btn-creds-save').onclick = function () {\n    var payload = JSON.stringify({\n        sshUser:  (document.getElementById('ci-ssh-user') || {}).value.trim(),\n        sshPass:  (document.getElementById('ci-ssh-pass') || {}).value.trim(),\n        udpToken: (document.getElementById('ci-udp-token') || {}).value.trim(),\n        v2uuid:   (document.getElementById('ci-v2ray-uuid') || {}).value.trim()\n    });\n    A.saveCredentials(payload);\n    toast('Credenciais salvas com sucesso!', 'ok');\n    closeModal();\n};\n\n// Toggle senha no modal\ndocument.getElementById('toggle-pass').onclick = function () {\n    var pass = document.getElementById('ci-ssh-pass');\n    if (pass.type === 'password') {\n        pass.type = 'text';\n        this.textContent = '🙈';\n    } else {\n        pass.type = 'password';\n        this.textContent = '👁';\n    }\n};\n\n// No final da função bind() adicione:\n// document.getElementById('creds-btn').onclick = openCredsModal;\n// document.getElementById('btn-creds-bottom').onclick = openCredsModal;\n// document.getElementById('tool-creds').onclick = openCredsModal;\n\n// ... resto do seu script original ...\n\n})();\n</script>\n</body>\n</html>\n@"
