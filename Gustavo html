  "HtmlUI": "@<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n    <title>YUMEKO VPN</title>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n\n        :root {\n            --bg:     #0d0f14;\n            --bg2:    #111318;\n            --card:   #1a1d24;\n            --card2:  #1e2128;\n            --line:   rgba(255,255,255,.07);\n            --text:   #e8eaf0;\n            --muted:  #6b7080;\n            --cyan:   #00d4ff;\n            --green:  #2ecc71;\n            --yellow: #f0c040;\n            --red:    #e74c3c;\n        }\n\n        * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }\n        html, body { min-height: 100%; background: var(--bg); font-family: Inter, system-ui, sans-serif; color: var(--text); overflow-x: hidden; }\n\n        button { cursor: pointer; border: none; background: none; }\n\n        /* Todo o CSS anterior mantido (resumido aqui por tamanho) */\n        .creds-input-wrap {\n            background: var(--card2); border-radius: 13px;\n            border: 1px solid var(--line);\n            display: flex; align-items: center; gap: 10px;\n            padding: 12px 14px; margin-bottom: 10px;\n        }\n        .creds-input-wrap input {\n            flex: 1; background: none; border: none; outline: none;\n            color: var(--text); font-size: 15px; font-weight: 600;\n        }\n        .ci-eye { color: var(--muted); font-size: 18px; background: none; border: none; cursor: pointer; }\n    </style>\n</head>\n<body>\n<div class=\"app-shell\">\n\n    <!-- === SEU HTML ORIGINAL (PÁGINAS, HERO, NAV, ETC) === -->\n    <!-- (Cole todo o conteúdo anterior dentro do .app-shell aqui) -->\n\n    <!-- Modal Credenciais ATUALIZADO -->\n    <div class=\"modal-box creds-modal-box\" id=\"modal-creds\">\n        <div class=\"creds-modal-head\">\n            <div class=\"creds-modal-title\">Credenciais</div>\n            <button class=\"icon-btn modal-close\">×</button>\n        </div>\n        <div class=\"creds-modal-sub\">Configure os dados de conexão</div>\n        <div class=\"creds-modal-body\">\n            <div class=\"creds-section-title\">👤 SSH / Principal</div>\n            <div class=\"creds-input-wrap\">\n                <span class=\"ci-icon\">👤</span>\n                <input type=\"text\" id=\"ci-ssh-user\" placeholder=\"Usuário\">\n            </div>\n            <div class=\"creds-input-wrap\">\n                <span class=\"ci-icon\">🔒</span>\n                <input type=\"password\" id=\"ci-ssh-pass\" placeholder=\"Senha\">\n                <button class=\"ci-eye\" id=\"toggle-pass\">👁</button>\n            </div>\n\n            <div class=\"creds-section-title\">📡 UDP / Hysteria</div>\n            <div class=\"creds-input-wrap\">\n                <span class=\"ci-icon\">🔑</span>\n                <input type=\"text\" id=\"ci-udp-token\" placeholder=\"Token / Password UDP\">\n            </div>\n\n            <div class=\"creds-section-title\">🌐 V2Ray / XRay</div>\n            <div class=\"creds-input-wrap\">\n                <span class=\"ci-icon\">🆔</span>\n                <input type=\"text\" id=\"ci-v2ray-uuid\" placeholder=\"UUID ou vmess://\">\n            </div>\n        </div>\n        <div class=\"creds-modal-footer\">\n            <button class=\"creds-cancel-btn modal-close\">Cancelar</button>\n            <button class=\"creds-save-btn\" id=\"btn-creds-save\">Salvar Credenciais</button>\n        </div>\n    </div>\n\n</div>\n\n<!-- Toast e outros modais permanecem iguais -->\n\n<script>\n(function () {\n'use strict';\n\n// === BRIDGE ===\nvar A = {\n    call: function (m, arg) {\n        try {\n            if (window.Android && typeof window.Android[m] === 'function')\n                return arg !== undefined ? window.Android[m](arg) : window.Android[m]();\n        } catch (e) { console.warn('Bridge.' + m, e); }\n        return null;\n    },\n    parse: function (raw, fb) { try { return JSON.parse(raw) || fb; } catch (e) { return fb; }},\n    saveCredentials: function (jsonStr) { A.call('saveCredentials', jsonStr); },\n    getSavedCredentials: function () { return A.parse(A.call('getSavedCredentials'), {}); }\n};\n\n// ... (Mantenha todo o seu JavaScript anterior: STATE, app, applyState, refreshSelected, etc.) ...\n\n// Funções de Credenciais\nfunction loadSavedCredentials() {\n    try {\n        var creds = A.getSavedCredentials() || {};\n        document.getElementById('ci-ssh-user').value = creds.sshUser || '';\n        document.getElementById('ci-ssh-pass').value = creds.sshPass || '';\n        document.getElementById('ci-udp-token').value = creds.udpToken || '';\n        document.getElementById('ci-v2ray-uuid').value = creds.v2uuid || '';\n    } catch (e) { console.warn('loadSavedCredentials', e); }\n}\n\nfunction openCredsModal() {\n    loadSavedCredentials();\n    document.getElementById('modal-mask').classList.add('show');\n    document.getElementById('modal-creds').classList.add('active');\n}\n\n// Bind Events (adicione ou substitua no seu bind())\ndocument.getElementById('btn-creds-save').onclick = function () {\n    var payload = JSON.stringify({\n        sshUser:  document.getElementById('ci-ssh-user').value.trim(),\n        sshPass:  document.getElementById('ci-ssh-pass').value.trim(),\n        udpToken: document.getElementById('ci-udp-token').value.trim(),\n        v2uuid:   document.getElementById('ci-v2ray-uuid').value.trim()\n    });\n    A.saveCredentials(payload);\n    toast('Credenciais salvas com sucesso!', 'ok');\n    closeModal();\n};\n\n// Toggle Senha\ndocument.getElementById('toggle-pass').onclick = function () {\n    var input = document.getElementById('ci-ssh-pass');\n    if (input.type === 'password') {\n        input.type = 'text';\n        this.textContent = '🙈';\n    } else {\n        input.type = 'password';\n        this.textContent = '👁';\n    }\n};\n\n// No final do bind() adicione:\n// document.getElementById('creds-btn').onclick = openCredsModal;\n// document.getElementById('btn-creds-bottom').onclick = openCredsModal;\n// document.getElementById('tool-creds').onclick = openCredsModal;\n\n})();\n</script>\n</body>\n</html>\n@"
