        </div>\n    </div>\n\n    <!-- Servidor + Credenciais -->\n    <div class=\"summary-list\">\n        <div class=\"summary-card\" id=\"select-server\">\n            <div class=\"circle\" id=\"server-flag-wrap\">🌐</div>\n            <div class=\"meta\">\n                <div class=\"label\">Operadora</div>\n                <div class=\"title\" id=\"server-title\">Selecionar operadora</div>\n                <div class=\"sub\"   id=\"server-sub\">Toque para escolher</div>\n            </div>\n            <span class=\"chev\">›</span>\n        </div>\n\n        <div class=\"summary-card\" id=\"select-premium\" style=\"display: none;\">\n            <div class=\"circle\" id=\"premium-flag-wrap\">💎</div>\n            <div class=\"meta\">\n                <div class=\"label\">Servidor Premium</div>\n                <div class=\"title\" id=\"premium-title\">Selecionar servidor</div>\n                <div class=\"sub\"   id=\"premium-sub\">Toque para escolher</div>\n            </div>\n            <span class=\"chev\">›</span>\n        </div>\n\n        <div class=\"summary-card\" id=\"creds-btn\">\n            <div class=\"circle\">🔐</div>\n            <div class=\"meta\">\n                <div class=\"label\">Credenciais</div>\n                <div class=\"title\" id=\"creds-title\">Configuradas</div>\n                <div class=\"sub\"   id=\"creds-sub\">Toque para ajustar</div>\n            </div>\n            <span class=\"chev\">›</span>\n        </div>\n    </div>\n\n    <!-- NOVO: Ações Rápidas -->\n    <div class=\"bottom-actions\">\n        <button class=\"action-btn\" id=\"btn-logs-bottom\">\n            <span class=\"ti\">📋</span>\n            <span>Logs</span>\n        </button>\n        <button class=\"action-btn\" id=\"btn-update-bottom\">\n            <span class=\"ti\">↻</span>\n            <span>Atualizar</span>\n        </button>\n        <button class=\"action-btn\" id=\"btn-servers-bottom\">\n            <span class=\"ti\">🌐</span>\n            <span>Operadoras</span>\n        </button>\n        <button class=\"action-btn\" id=\"btn-creds-bottom\">\n            <span class=\"ti\">🔐</span>\n            <span>Ajustes</span>\n        </button>\n    </div>\n\n    <!-- Rodapé -->\n    <div class=\"bottom-meta\">\n        <span>v<span id=\"config-version\">—</span></span>\n    </div>\n\n</div>\n\n<!-- Modal -->\n<div class=\"modal-mask\" id=\"modal-mask\">\n    <div class=\"modal-box\" id=\"modal-servers\">\n        <div class=\"modal-head\">\n            <div class=\"modal-title\">Listagem</div>\n            <button class=\"icon-btn modal-close\">×</button>\n        </div>\n        <div class=\"modal-body\" id=\"list-servers\"></div>\n    </div>\n\n    <div class=\"modal-box\" id=\"modal-logs\">\n        <div class=\"modal-head\">\n            <div class=\"modal-title\">Logs de conexão</div>\n            <button class=\"icon-btn modal-close\">×</button>\n        </div>\n        <div class=\"modal-body\">\n            <div class=\"logs-toolbar\">\n                <button class=\"log-action-btn\" id=\"btn-refresh-logs\">↻ Atualizar</button>\n                <button class=\"log-action-btn danger\" id=\"btn-clear-logs\">🗑 Limpar</button>\n            </div>\n            <div id=\"log-container\"></div>\n        </div>\n    </div>\n</div>\n\n<!-- Toast -->\n<div class=\"toast-box\"><div class=\"toast\" id=\"toast\"></div></div>\n\n<script>\n(function () {\n'use strict';\n\nvar A = {\n    call: function (m, arg) {\n        try {\n            if (window.Android && typeof window.Android[m] === 'function')\n                return arg !== undefined ? window.Android[m](arg) : window.Android[m]();\n        } catch (e) { console.warn('Bridge.' + m, e); }\n        return null;\n    },\n    parse: function (raw, fb) { try { return JSON.parse(raw) || fb; } catch (e) { return fb; } },\n\n    connect:      function ()    { A.call('connect'); },\n    getStatus:    function ()    { return A.call('getStatus')  || 'DESCONECTADO'; },\n    getServers:   function ()    { return A.parse(A.call('getServers'), []); },\n    getSelected:  function ()    { return A.parse(A.call('getSelectedServer'), {}); },\n    selectServer: function (pos) { A.call('selectServer', pos); },\n    \n    getMultiServers:   function ()    { return A.parse(A.call('getMultiServers'), []); },\n    getSelectedMulti:  function ()    { return A.parse(A.call('getSelectedMultiServer'), {}); },\n    selectMultiServer: function (pos) { A.call('selectMultiServer', pos); },\n\n    getNote:      function ()    { return A.call('getNote')    || ''; },\n    getVersion:   function ()    { return A.call('getVersion') || ''; },\n    getLogs:      function ()    { return A.parse(A.call('getLogs'), []); },\n    clearLogs:    function ()    { A.call('clearLogs'); },\n    openServers:  function ()    { A.call('openServers'); },\n    checkUpdate:  function ()    { A.call('checkUpdate'); }\n};\n\nvar STATE = {\n    CONECTADO:    { cls: 'st-conectado',  label: 'CONECTADO',     auth: 'ONLINE', authOk: true },\n    DESCONECTADO: { cls: 'st-desconectado', label: 'DESCONECTADO', auth: '—',     authOk: false },\n    INICIANDO:    { cls: 'st-conectando',  label: 'INICIANDO',     auth: '...',   authOk: false },\n    PARANDO:      { cls: 'st-conectando',  label: 'PARANDO',       auth: '...',   authOk: false },\n    CONECTANDO:   { cls: 'st-conectando',  label: 'CONECTANDO',    auth: '...',   authOk: false },\n    AGUARDANDO:   { cls: 'st-conectando',  label: 'AGUARDANDO',    auth: '...',   authOk: false },\n    AUTENTICANDO: { cls: 'st-conectando',  label: 'AUTENTICANDO',  auth: '...',   authOk: false },\n    RECONECTANDO: { cls: 'st-conectando',  label: 'RECONECTANDO',  auth: '...',   authOk: false },\n    NOPROCESS:    { cls: '',               label: 'PRONTO',         auth: '—',    authOk: false },\n    ERRO:         { cls: 'st-erro',        label: 'ERRO',           auth: 'FALHA', authOk: false }\n};\n\nvar ALL_STATE_CLASSES = ['st-conectado', 'st-conectando', 'st-desconectado', 'st-erro'];\n\nvar app = {\n    rawState:   'NOPROCESS',\n    connected:  false,\n    busy:       false,\n    startedAt:  0,\n    timerHandle: null,\n    pollHandle:  null\n};\n\nfunction $(id)       { return document.getElementById(id); }\nfunction setText(id, v) { var el = $(id); if (el) el.textContent = String(v == null ? '' : v); }\nfunction pad(n)      { return String(n).padStart(2, '0'); }\nfunction esc(s)      {\n    return String(s == null ? '' : s)\n        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')\n        .replace(/\"/g,'&quot;').replace(/'/g,'&#39;');\n}\n\nfunction toast(msg, kind) {\n    var el = $('toast'); if (!el) return;\n    el.textContent = msg;\n    el.className = 'toast show' + (kind ? ' ' + kind : '');\n    clearTimeout(el._t);\n    el._t = setTimeout(function () { el.className = 'toast'; }, 2800);\n}\n\nfunction applyState(raw, detail) {\n    raw = String(raw || 'NOPROCESS').toUpperCase().trim();\n    app.rawState = raw;\n\n    var s = STATE[raw] || STATE['NOPROCESS'];\n\n    ALL_STATE_CLASSES.forEach(function (c) { document.body.classList.remove(c); });\n    if (s.cls) document.body.classList.add(s.cls);\n\n    setText('status-label', s.label);\n    setText('status-detail', detail || '');\n\n    var authPill = $('auth-pill');\n    if (authPill) {\n        authPill.textContent = s.auth;\n        authPill.classList.toggle('ok', s.authOk);\n    }\n\n    var btn = $('btn-connect');\n    if (btn) {\n        if (raw === 'CONECTADO') {\n            btn.textContent = 'DESCONECTAR';\n        } else if (raw === 'INICIANDO' || raw === 'CONECTANDO' || raw === 'AUTENTICANDO' ||\n                   raw === 'AGUARDANDO' || raw === 'RECONECTANDO') {\n            btn.textContent = 'CANCELAR';\n        } else if (raw === 'PARANDO') {\n            btn.textContent = 'AGUARDE...';\n        } else {\n            btn.textContent = 'CONECTAR';\n        }\n    }\n\n    app.connected = (raw === 'CONECTADO');\n    app.busy      = (raw === 'INICIANDO' || raw === 'CONECTANDO' || raw === 'AUTENTICANDO' ||\n                     raw === 'AGUARDANDO' || raw === 'RECONECTANDO' || raw === 'PARANDO');\n\n    if (app.connected && !app.startedAt) {\n        app.startedAt = Date.now();\n        startTimer();\n    }\n    if (!app.connected && !app.busy) {\n        if (app.startedAt) { app.startedAt = 0; stopTimer(); setText('timer-val', '00:00'); }\n        var tb = $('timer-bar'); if (tb) tb.classList.remove('show');\n    }\n}\n\nfunction startTimer() {\n    stopTimer();\n    var tb = $('timer-bar'); if (tb) tb.classList.add('show');\n    app.timerHandle = setInterval(function () {\n        var sec = Math.floor((Date.now() - app.startedAt) / 1000);\n        var h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = sec % 60;\n        setText('timer-val', (h ? pad(h) + ':' : '') + pad(m) + ':' + pad(s));\n    }, 1000);\n}\nfunction stopTimer() {\n    if (app.timerHandle) { clearInterval(app.timerHandle); app.timerHandle = null; }\n}\n\nfunction startPolling() {\n    app.pollHandle = setInterval(function () {\n        var raw = A.getStatus();\n        if (raw !== app.rawState) applyState(raw);\n    }, 1200);\n}\n\nfunction renderLogs() {\n    var container = $('log-container');\n    if (!container) return;\n\n    var logs = A.getLogs(); \n    if (!logs || !logs.length) {\n        container.innerHTML = '<div style=\"color:var(--muted);font-size:12px;padding:8px\">Nenhum log disponível.</div>';\n        return;\n    }\n\n    var html = '';\n    for (var i = logs.length - 1; i >= 0; i--) {\n        var item  = logs[i];\n        var level = String(item.level || 'INFO').toUpperCase();\n        var msg   = esc(item.message || '');\n        var time  = item.time ? formatLogTime(item.time) : '';\n\n        html += '<div class=\"log-entry ' + level + '\">' +\n                    '<span class=\"log-time\">' + esc(time) + '</span>' +\n                    '<span class=\"log-msg\">'  + msg        + '</span>' +\n                '</div>';\n    }\n    container.innerHTML = html;\n}\n\nfunction formatLogTime(ms) {\n    var d = new Date(ms);\n    return pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());\n}\n\nfunction refreshInfo() {\n    var ver = A.getVersion();\n    if (ver) setText('config-version', ver);\n\n    var note = A.getNote();\n    var mc   = $('message-card');\n    if (mc) { mc.classList.toggle('show', !!note); setText('message-text', note); }\n}\n\nfunction refreshSelected() {\n    var s = A.getSelected();\n    if (s && typeof s === 'object' && s.Name) {\n        setText('server-title', s.Name || 'Selecionar operadora');\n        setText('server-sub',   s.Info || 'Direct');\n        setText('mode-pill',    s.Info || 'SSH');\n\n        var wrap = $('server-flag-wrap');\n        if (wrap && s.Flag) {\n            var src = 'file:///android_asset/flags/' + s.Flag + '.png';\n            wrap.innerHTML = '<img src=\"' + esc(src) + '\" ' +\n                'onerror=\"this.style.display=\\'none\\'\" ' +\n                'style=\"width:100%;height:100%;object-fit:cover;border-radius:12px\">';\n        }\n    }\n    \n    var p = A.getSelectedMulti();\n    var pCard = $('select-premium');\n    if (p && p.Name) {\n        if (pCard) pCard.style.display = 'flex';\n        setText('premium-title', p.Name || 'Selecionar servidor');\n        setText('premium-sub',   p.Info || 'Premium');\n\n        var pwrap = $('premium-flag-wrap');\n        if (pwrap && p.Flag) {\n            var psrc = 'file:///android_asset/flags/' + p.Flag + '.png';\n            pwrap.innerHTML = '<img src=\"' + esc(psrc) + '\" ' +\n                'onerror=\"this.style.display=\\'none\\'\" ' +\n                'style=\"width:100%;height:100%;object-fit:cover;border-radius:12px\">';\n        }\n    } else {\n        if (pCard) pCard.style.display = 'none';\n    }\n}\n\nfunction buildServerList(type) {\n    var root = $('list-servers'); if (!root) return;\n    root.innerHTML = '';\n\n    var isPremium = (type === 'premium');\n    var servers  = isPremium ? A.getMultiServers() : A.getServers();\n    var selected = isPremium ? A.getSelectedMulti() : A.getSelected();\n    var selPos   = selected ? selected.position : -1;\n\n    if (!servers || !servers.length) {\n        root.innerHTML = '<div style=\"color:var(--muted);font-size:13px;padding:8px\">Nenhuma opção disponível no momento.</div>';\n        return;\n    }\n\n    var mTitleEl = document.querySelector('#modal-servers .modal-title');\n    if (mTitleEl) mTitleEl.textContent = isPremium ? 'Servidores Premium' : 'Operadoras';\n\n    servers.forEach(function (s, i) {\n        var isSel   = (s.position === selPos || i === selPos);\n        var flagSrc = s.Flag ? 'file:///android_asset/flags/' + s.Flag + '.png' : '';\n\n        var el = document.createElement('div');\n        el.className = 'list-item' + (isSel ? ' selected' : '');\n        el.innerHTML =\n            '<div class=\"li-icon\">' +\n                (flagSrc ? '<img src=\"' + esc(flagSrc) + '\" onerror=\"this.style.display=\\'none\\'\">' : (isPremium ? '💎' : '🌐')) +\n            '</div>' +\n            '<div class=\"li-main\">' +\n                '<div class=\"li-title\">' + esc(s.Name || 'Servidor') + '</div>' +\n                '<div class=\"li-sub\">'  + esc(s.Info || (isPremium ? 'Premium' : 'Direct'))   + '</div>' +\n            '</div>' +\n            '<span class=\"li-check\">✓</span>';\n\n        el.onclick = function () {\n            if (app.connected) { toast('Desconecte antes de trocar a seleção.', 'err'); return; }\n            if (isPremium) {\n                A.selectMultiServer(s.position !== undefined ? s.position : i);\n            } else {\n                A.selectServer(s.position !== undefined ? s.position : i);\n            }\n            closeModal();\n            setTimeout(function () { refreshSelected(); }, 250);\n            toast(isPremium ? 'Servidor selecionado!' : 'Operadora selecionada!', 'ok');\n        };\n        root.appendChild(el);\n    });\n}\n\nfunction openModal(id) {\n    $('modal-mask').classList.add('show');\n    document.querySelectorAll('.modal-box').forEach(function (b) { b.classList.remove('active'); });\n    var box = $(id); if (box) box.classList.add('active');\n}\nfunction closeModal() {\n    $('modal-mask').classList.remove('show');\n    document.querySelectorAll('.modal-box').forEach(function (b) { b.classList.remove('active'); });\n}\n\nwindow.onShowInterstitial = function () {\n    if (window.Android && typeof Android.requestInterstitial === 'function') {\n        Android.requestInterstitial();\n    }\n};\nwindow.onVpnStatus = function (rawState, detail) {\n    applyState(rawState, detail || '');\n};\nwindow.onCheckUserReceived = function (data) {\n    var card = $('checkuser-card');\n    if (!card) return;\n    card.classList.add('show');\n\n    var u = typeof data === 'string' ? JSON.parse(data) : data;\n    setText('cu-username',    u.username        || '—');\n    setText('cu-connections', (u.count_connection || '—') + ' / ' + (u.limiter_user || '—'));\n    setText('cu-expiration',  u.expiration_date  || '—');\n    setText('cu-days',        (u.expiration_days || '—') + ' dias');\n};\nwindow.onLogAdded = function (itemJson) {\n    var container = $('log-container');\n    if (!container) return;\n    try {\n        var item  = typeof itemJson === 'string' ? JSON.parse(itemJson) : itemJson;\n        var level = String(item.level || 'INFO').toUpperCase();\n        var time  = item.time ? formatLogTime(item.time) : '';\n        var div   = document.createElement('div');\n        div.className = 'log-entry ' + level;\n        div.innerHTML = '<span class=\"log-time\">' + esc(time) + '</span>' +\n                        '<span class=\"log-msg\">'  + esc(item.message || '') + '</span>';\n        container.insertBefore(div, container.firstChild);\n    } catch (e) {}\n};\nwindow.onLogsCleared = function () {\n    var c = $('log-container'); if (c) c.innerHTML = '';\n};\nwindow.onServerChanged = function () { refreshSelected(); };\nwindow.onConfigUpdated = function () {\n    refreshInfo();\n    refreshSelected();\n    toast('Configuração atualizada!', 'ok');\n};\n\nvar MAX_FREE_MS  = 999999999;\nvar timeCard     = null;\nvar timeFillEl   = null;\nvar timeValEl    = null;\nvar timeHandle   = null;\nvar baseTimeMs   = 0; \n\nfunction initTimeCard() {\n    timeCard   = $('time-card');\n    timeFillEl = $('time-bar-fill');\n    timeValEl  = $('time-remaining-val');\n\n    var adsOn   = window.Android && typeof Android.isAdsEnabled === 'function'\n                  ? Android.isAdsEnabled() : false;\n    var left    = window.Android && typeof Android.getTimeLeft === 'function'\n                  ? Android.getTimeLeft() : 0;\n\n    if (!adsOn || left >= MAX_FREE_MS) {\n        if (timeCard) timeCard.classList.remove('show');\n        return;\n    }\n\n    if (timeCard) timeCard.classList.add('show');\n    baseTimeMs = 7200000; \n    updateTimeDisplay(left);\n    startTimeCountdown(left);\n}\n\nfunction startTimeCountdown(ms) {\n    if (timeHandle) clearInterval(timeHandle);\n    var remaining = ms;\n    timeHandle = setInterval(function () {\n        remaining -= 1000;\n        if (remaining <= 0) {\n            remaining = 0;\n            clearInterval(timeHandle);\n            if (app.connected) A.connect();\n            updateTimeDisplay(0);\n            toast('Seu tempo expirou! Assista um anúncio para continuar.', 'warn');\n        }\n        updateTimeDisplay(remaining);\n    }, 1000);\n}\n\nfunction updateTimeDisplay(ms) {\n    if (!timeValEl) return;\n    if (ms <= 0) { timeValEl.textContent = '00:00'; if (timeFillEl) timeFillEl.style.width = '0%'; return; }\n\n    var totalSec = Math.floor(ms / 1000);\n    var h = Math.floor(totalSec / 3600);\n    var m = Math.floor((totalSec % 3600) / 60);\n    var s = totalSec % 60;\n    timeValEl.textContent = (h ? pad(h) + ':' : '') + pad(m) + ':' + pad