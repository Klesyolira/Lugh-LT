{
  "Version": "7.7",
  "HtmlUI": "@<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n    <title>YUMEKO VPN</title>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n\n        :root {\n            --bg:     #070b20;\n            --bg2:    #0b102a;\n            --card:   rgba(18,24,55,.78);\n            --line:   rgba(137,155,255,.18);\n            --line2:  rgba(0,229,255,.38);\n            --text:   #f4f7ff;\n            --muted:  #8992b5;\n            --cyan:   #19e6ff;\n            --green:  #41f19a;\n            --yellow: #ffd66b;\n            --red:    #ff4c79;\n            --orange: #ff8c42;\n            --shadow: 0 20px 60px rgba(0,0,0,.45);\n        }\n\n        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0; padding: 0; }\n        html, body { min-height: 100%; }\n\n        body {\n            font-family: Inter, system-ui, sans-serif;\n            color: var(--text);\n            background:\n                radial-gradient(circle at 15% 0%,  rgba(25,230,255,.14), transparent 28%),\n                radial-gradient(circle at 85% 18%, rgba(154,108,255,.14), transparent 30%),\n                linear-gradient(180deg, var(--bg), var(--bg2));\n            overflow-x: hidden;\n        }\n\n        body::after {\n            content: '';\n            position: fixed; inset: 0; z-index: 0;\n            background-image:\n                linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),\n                linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);\n            background-size: 34px 34px;\n            mask-image: linear-gradient(to bottom, rgba(0,0,0,.9), transparent 70%);\n            pointer-events: none;\n        }\n\n        button { cursor: pointer; touch-action: manipulation; user-select: none; border: none; background: none; }\n\n        /* ── Shell ── */\n        .app-shell {\n            position: relative; z-index: 1;\n            width: min(100%, 480px); margin: 0 auto;\n            min-height: 100vh;\n            padding: 14px 14px calc(24px + env(safe-area-inset-bottom));\n            display: flex;\n            flex-direction: column;\n        }\n\n        /* ── Topbar ── */\n        .topbar {\n            display: flex; align-items: center; justify-content: space-between;\n            gap: 12px; padding: 8px 2px 14px;\n        }\n        .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }\n        .brand-logo-wrap {\n            width: 52px; height: 52px; border-radius: 18px; overflow: hidden; flex: 0 0 auto;\n            background: radial-gradient(circle at 30% 20%, rgba(34,229,255,.22), rgba(255,255,255,.06));\n            box-shadow: 0 0 0 1px rgba(255,255,255,.08), 0 8px 28px rgba(0,0,0,.35);\n            display: grid; place-items: center;\n        }\n        .brand-logo { width: 100%; height: 100%; object-fit: cover; display: none; }\n        .brand-logo.loaded { display: block; }\n        .brand-logo-fallback { color: #eaf7ff; font-weight: 900; font-size: 18px; }\n        .brand-title { font-weight: 900; font-size: 20px; }\n        .brand-sub   { color: var(--muted); font-weight: 700; font-size: 12px; margin-top: 3px; }\n\n        /* ── Status Card ── */\n        .status-card {\n            position: relative; z-index: 2;\n            border-radius: 30px; padding: 24px;\n            background: linear-gradient(145deg, rgba(22,31,70,.88), rgba(9,13,34,.88));\n            border: 1.5px solid rgba(25,230,255,.35);\n            box-shadow: var(--shadow), 0 0 34px rgba(25,230,255,.10);\n            display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: center;\n            transition: border-color .4s, box-shadow .4s;\n        }\n        body.st-conectado  .status-card { border-color: rgba(65,241,154,.55);  box-shadow: var(--shadow), 0 0 40px rgba(65,241,154,.16); }\n        body.st-conectando .status-card { border-color: rgba(255,214,107,.45); box-shadow: var(--shadow), 0 0 34px rgba(255,214,107,.12); }\n        body.st-erro       .status-card { border-color: rgba(255,76,121,.45);  box-shadow: var(--shadow), 0 0 34px rgba(255,76,121,.12); }\n\n        /* ── Orb power ── */\n        .power-orb {\n            width: 96px; height: 96px; border-radius: 32px;\n            display: grid; place-items: center; position: relative;\n            background: radial-gradient(circle, rgba(25,230,255,.24), rgba(25,230,255,.04) 60%);\n            box-shadow: inset 0 0 0 1.5px rgba(25,230,255,.22), 0 0 40px rgba(25,230,255,.16);\n            transition: background .4s, box-shadow .4s;\n        }\n        body.st-conectado  .power-orb { background: radial-gradient(circle, rgba(65,241,154,.22), rgba(65,241,154,.04) 60%); box-shadow: inset 0 0 0 1.5px rgba(65,241,154,.3), 0 0 40px rgba(65,241,154,.18); }\n        body.st-conectando .power-orb { background: radial-gradient(circle, rgba(255,214,107,.2),  rgba(255,214,107,.04) 60%); box-shadow: inset 0 0 0 1.5px rgba(255,214,107,.3), 0 0 34px rgba(255,214,107,.14); }\n        body.st-erro       .power-orb { background: radial-gradient(circle, rgba(255,76,121,.2),   rgba(255,76,121,.04)  60%); box-shadow: inset 0 0 0 1.5px rgba(255,76,121,.3),  0 0 34px rgba(255,76,121,.14); }\n\n        .power-orb::before {\n            content: '';\n            position: absolute; inset: -4px;\n            border-radius: 36px;\n            border: 2px solid transparent;\n            border-top-color: var(--yellow);\n            opacity: 0;\n            transition: opacity .3s;\n        }\n        body.st-conectando .power-orb::before { opacity: 1; animation: spin .9s linear infinite; }\n        @keyframes spin { to { transform: rotate(360deg); } }\n\n        .power-svg { width: 40px; height: 40px; transition: color .4s; color: var(--cyan); }\n        body.st-conectado  .power-svg { color: var(--green); }\n        body.st-conectando .power-svg { color: var(--yellow); }\n        body.st-erro       .power-svg { color: var(--red); }\n\n        .eyebrow { color: var(--muted); font-weight: 900; letter-spacing: .25em; font-size: 11px; text-transform: uppercase; }\n\n        .status-label {\n            margin-top: 8px; font-size: 28px; font-weight: 900;\n            letter-spacing: .07em; text-transform: uppercase;\n            color: var(--cyan); transition: color .4s;\n        }\n        body.st-conectado  .status-label { color: var(--green); }\n        body.st-conectando .status-label { color: var(--yellow); }\n        body.st-erro       .status-label { color: var(--red); }\n\n        .status-detail {\n            margin-top: 6px; font-size: 12px; color: var(--muted);\n            font-weight: 700; min-height: 18px;\n            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n        }\n\n        .status-mini { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 7px; }\n        .mini-pill {\n            padding: 5px 9px; border-radius: 999px;\n            background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.07);\n            color: var(--muted); font-size: 10px; font-weight: 800; text-transform: uppercase;\n            transition: color .3s, border-color .3s;\n        }\n        .mini-pill.ok { color: var(--green); border-color: rgba(65,241,154,.3); }\n\n        /* ── Timer ── */\n        .timer-bar {\n            display: none; align-items: center; justify-content: center; gap: 8px;\n            padding: 10px; border-radius: 18px; margin: 10px 0 0;\n            background: rgba(65,241,154,.07); border: 1px solid rgba(65,241,154,.22);\n        }\n        .timer-bar.show { display: flex; }\n        .timer-label { color: var(--green); font-weight: 900; font-size: 12px; letter-spacing: .06em; }\n        .timer-val   { color: var(--green); font-weight: 900; font-size: 18px; font-variant-numeric: tabular-nums; }\n\n        /* ── Botão conectar ── */\n        .connect-row { margin: 14px 0; }\n        .connect-btn {\n            width: 100%; min-height: 66px; border-radius: 23px;\n            font-size: 17px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase;\n            background: linear-gradient(135deg, #19e6ff, #5f7dff);\n            color: #051022;\n            box-shadow: 0 14px 40px rgba(25,230,255,.22);\n            transition: opacity .15s, transform .1s, background .3s, box-shadow .3s;\n        }\n        .connect-btn:active { transform: scale(.97); opacity: .88; }\n        body.st-conectado  .connect-btn { background: linear-gradient(135deg, #ff4c79, #ff8c42); color: #fff; box-shadow: 0 14px 40px rgba(255,76,121,.22); }\n        body.st-conectando .connect-btn { background: linear-gradient(135deg, #ffd66b, #ff8c42); color: #1a0e00; box-shadow: 0 14px 40px rgba(255,214,107,.22); }\n\n        /* ── Aviso ── */\n        .message-card {\n            display: none; align-items: center; gap: 12px;\n            padding: 13px 15px; border-radius: 20px; margin: 8px 0;\n            background: var(--card); border: 1px solid rgba(255,214,107,.28);\n        }\n        .message-card.show { display: flex; }\n        .msg-icon  { font-size: 20px; }\n        .msg-title { font-size: 11px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; color: var(--yellow); }\n        .msg-text  { font-size: 13px; color: rgba(255,255,255,.88); margin-top: 2px; }\n\n        /* ── Cards de seleção ── */\n        .summary-list { display: grid; gap: 10px; margin-top: 12px; flex: 1; }\n        .summary-card {\n            border-radius: 22px; padding: 15px;\n            display: flex; align-items: center; gap: 13px; min-height: 74px;\n            background: var(--card); border: 1px solid var(--line);\n            box-shadow: 0 12px 40px rgba(0,0,0,.18);\n            cursor: pointer; transition: opacity .15s;\n        }\n        .summary-card:active { opacity: .8; }\n        .summary-card .circle {\n            width: 46px; height: 46px; flex: 0 0 46px; border-radius: 16px;\n            display: grid; place-items: center;\n            background: rgba(25,230,255,.1); color: var(--cyan); font-size: 22px; overflow: hidden;\n        }\n        .summary-card .circle img { width: 100%; height: 100%; object-fit: cover; }\n        .summary-card .meta  { min-width: 0; flex: 1; }\n        .summary-card .label { font-size: 11px; font-weight: 900; color: var(--muted); letter-spacing: .08em; text-transform: uppercase; }\n        .summary-card .title { margin-top: 5px; font-size: 15px; font-weight: 900; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n        .summary-card .sub   { margin-top: 4px; color: var(--muted); font-size: 11px; font-weight: 700; }\n        .summary-card .chev  { color: rgba(255,255,255,.3); font-size: 20px; }\n\n        /* ── Ações Rápidas (Bottom) ── */\n        .bottom-actions {\n            display: grid;\n            grid-template-columns: repeat(4, 1fr);\n            gap: 10px;\n            margin: 20px 0 10px;\n        }\n        .action-btn {\n            background: var(--card);\n            border: 1px solid var(--line);\n            border-radius: 16px;\n            padding: 12px 4px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            gap: 6px;\n            color: var(--muted);\n            font-size: 10px;\n            font-weight: 800;\n            text-transform: uppercase;\n            letter-spacing: .02em;\n            transition: all .2s;\n        }\n        .action-btn:active { opacity: .7; transform: scale(.95); }\n        .action-btn .ti {\n            font-size: 22px;\n            color: var(--cyan);\n            margin-bottom: 2px;\n        }\n\n        /* ── Rodapé ── */\n        .bottom-meta {\n            display: flex; justify-content: center; flex-wrap: wrap; gap: 8px;\n            margin: 8px 0 4px; color: var(--muted); font-size: 12px; font-weight: 800;\n        }\n        .bottom-meta span { background: rgba(255,255,255,.055); padding: 7px 10px; border-radius: 999px; }\n\n        /* ── Modal ── */\n        .modal-mask {\n            position: fixed; inset: 0; z-index: 80;\n            display: flex; align-items: flex-end; justify-content: center;\n            padding: 14px; background: rgba(0,0,0,.5);\n            opacity: 0; pointer-events: none; transition: .22s;\n        }\n        .modal-mask.show { opacity: 1; pointer-events: auto; }\n        .modal-box {\n            display: none; flex-direction: column;\n            width: min(100%, 460px); max-height: 80vh;\n            border-radius: 28px 28px 22px 22px;\n            background: rgba(10,14,36,.97); border: 1px solid var(--line);\n            overflow: hidden;\n            transform: translateY(24px); opacity: 0;\n            transition: transform .22s, opacity .22s;\n        }\n        .modal-mask.show .modal-box.active {\n            display: flex;\n            transform: translateY(0); opacity: 1;\n        }\n        .modal-head {\n            display: flex; align-items: center; justify-content: space-between;\n            padding: 16px 16px 12px; border-bottom: 1px solid rgba(255,255,255,.07);\n            flex: 0 0 auto;\n        }\n        .icon-btn {\n            width: 46px; height: 46px; border-radius: 16px;\n            display: inline-flex; align-items: center; justify-content: center;\n            color: var(--text); background: rgba(255,255,255,.07);\n            box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);\n            font-size: 22px;\n        }\n        .icon-btn:active { opacity: .75; }\n        .modal-title { font-weight: 950; font-size: 16px; }\n        .modal-body  { padding: 14px; overflow-y: auto; flex: 1; }\n\n        /* ── Lista de servidores ── */\n        .list-item {\n            display: flex; align-items: center; gap: 12px;\n            padding: 12px; border-radius: 18px; margin-bottom: 9px;\n            background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.06);\n            cursor: pointer; transition: opacity .15s;\n        }\n        .list-item:active { opacity: .75; }\n        .list-item.selected { border-color: rgba(25,230,255,.5); background: rgba(25,230,255,.08); }\n        .li-icon {\n            width: 40px; height: 40px; flex: 0 0 40px; border-radius: 14px;\n            display: grid; place-items: center;\n            background: rgba(25,230,255,.1); color: var(--cyan); overflow: hidden; font-size: 18px;\n        }\n        .li-icon img { width: 100%; height: 100%; object-fit: cover; }\n        .li-main  { min-width: 0; flex: 1; }\n        .li-title { font-weight: 900; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n        .li-sub   { color: var(--muted); font-size: 11px; margin-top: 4px; }\n        .li-check { color: var(--cyan); display: none; font-size: 18px; }\n        .list-item.selected .li-check { display: block; }\n\n        /* ── Logs ── */\n        #log-container {\n            font-family: 'Courier New', monospace;\n            font-size: 11.5px;\n            line-height: 1.65;\n        }\n        .log-entry {\n            display: flex; gap: 8px; align-items: flex-start;\n            padding: 5px 8px; border-radius: 10px; margin-bottom: 3px;\n            border-left: 2.5px solid transparent;\n        }\n        .log-entry.INFO    { background: rgba(255,255,255,.03); border-left-color: rgba(137,155,255,.4); }\n        .log-entry.DEBUG   { background: rgba(25,230,255,.04);  border-left-color: rgba(25,230,255,.3); }\n        .log-entry.WARNING { background: rgba(255,214,107,.06); border-left-color: var(--yellow); }\n        .log-entry.ERROR   { background: rgba(255,76,121,.07);  border-left-color: var(--red); }\n        .log-time  { color: var(--muted); font-size: 10px; white-space: nowrap; padding-top: 1px; flex: 0 0 auto; }\n        .log-msg   { color: var(--text); word-break: break-all; }\n        .log-entry.WARNING .log-msg { color: var(--yellow); }\n        .log-entry.ERROR   .log-msg { color: var(--red); }\n        .log-entry.DEBUG   .log-msg { color: rgba(25,230,255,.85); }\n\n        .logs-toolbar {\n            display: flex; gap: 8px; justify-content: flex-end;\n            padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,.06);\n            margin-bottom: 10px;\n        }\n        .log-action-btn {\n            padding: 6px 12px; border-radius: 10px; font-size: 11px; font-weight: 900;\n            background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.1);\n            color: var(--text);\n        }\n        .log-action-btn:active { opacity: .7; }\n        .log-action-btn.danger { background: rgba(255,76,121,.12); border-color: rgba(255,76,121,.3); color: var(--red); }\n\n        /* ── Toast ── */\n        .toast-box { position: fixed; z-index: 120; left: 14px; right: 14px; bottom: calc(16px + env(safe-area-inset-bottom)); display: grid; place-items: center; pointer-events: none; }\n        .toast {\n            padding: 12px 15px; border-radius: 16px;\n            background: rgba(7,10,27,.94); color: var(--text);\n            border: 1px solid rgba(25,230,255,.24);\n            font-size: 13px; font-weight: 800;\n            opacity: 0; transform: translateY(10px); transition: .2s ease;\n            max-width: min(92vw, 400px); text-align: center;\n        }\n        .toast.show { opacity: 1; transform: translateY(0); }\n        .toast.ok  { border-color: rgba(65,241,154,.4); }\n        .toast.err { border-color: rgba(255,76,121,.45); }\n        .toast.warn { border-color: rgba(255,214,107,.4); }\n\n        /* ── CheckUser card ── */\n        .checkuser-card {\n            display: none; border-radius: 18px; padding: 14px 16px;\n            background: var(--card); border: 1px solid rgba(25,230,255,.22);\n            margin: 10px 0;\n        }\n        .checkuser-card.show { display: block; }\n        .cu-title { font-size: 11px; font-weight: 900; letter-spacing: .1em;\n            text-transform: uppercase; color: var(--cyan); margin-bottom: 10px; }\n        .cu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n        .cu-item-label { font-size: 10px; color: var(--muted); font-weight: 700; }\n        .cu-item-value { font-size: 13px; font-weight: 900; color: #fff; margin-top: 2px; }\n        .cu-item-value.green { color: var(--green); }\n\n        /* ── Tempo restante ── */\n        .time-card {\n            display: none; border-radius: 22px; padding: 14px 16px;\n            background: var(--card); border: 1px solid rgba(255,214,107,.28);\n            margin: 10px 0;\n        }\n        .time-card.show { display: block; }\n        .time-card-head {\n            display: flex; align-items: center; justify-content: space-between;\n            margin-bottom: 10px;\n        }\n        .time-card-title { font-size: 11px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; color: var(--yellow); }\n        .time-remaining  { font-size: 22px; font-weight: 900; font-variant-numeric: tabular-nums; color: var(--yellow); }\n        .time-bar-track  { height: 5px; background: rgba(255,255,255,.08); border-radius: 999px; overflow: hidden; margin-bottom: 12px; }\n        .time-bar-fill   { height: 100%; background: linear-gradient(90deg, var(--yellow), var(--orange)); border-radius: 999px; transition: width .5s; }\n        .watch-ad-btn {\n            width: 100%; padding: 13px; border-radius: 16px; border: none;\n            background: linear-gradient(135deg, rgba(255,214,107,.18), rgba(255,140,66,.18));\n            border: 1px solid rgba(255,214,107,.35);\n            color: var(--yellow); font-size: 14px; font-weight: 900;\n            letter-spacing: .08em; cursor: pointer; transition: opacity .15s;\n        }\n        .watch-ad-btn:active { opacity: .75; }\n        .watch-ad-btn:disabled { opacity: .4; cursor: not-allowed; }\n        .watch-ad-btn.loading { opacity: .6; }\n\n        @media (max-width: 370px) {\n            .status-card { grid-template-columns: 1fr; text-align: center; place-items: center; }\n            .power-orb { width: 80px; height: 80px; }\n            .bottom-actions { gap: 6px; margin: 15px 0 10px; }\n            .action-btn { padding: 10px 2px; font-size: 9px; }\n        }\n    </style>\n</head>\n<body>\n<div class=\"app-shell\">\n\n    <!-- Topbar Limpa -->\n    <div class=\"topbar\">\n        <div class=\"brand\">\n            <div class=\"brand-logo-wrap\">\n                <img class=\"brand-logo\" id=\"logo-img\" alt=\"\">\n                <div class=\"brand-logo-fallback\" id=\"logo-fallback\">BK</div>\n            </div>\n            <div>\n                <div class=\"brand-title\" id=\"app-name\">BK VPN</div>\n                <div class=\"brand-sub\" id=\"app-sub\">Conexão segura</div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Status -->\n    <section class=\"status-card\">\n        <div class=\"power-orb\">\n            <svg class=\"power-svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M18.36 6.64A9 9 0 1 1 5.64 6.64\"/>\n                <line x1=\"12\" y1=\"2\" x2=\"12\" y2=\"12\"/>\n            </svg>\n        </div>\n        <div>\n            <div class=\"eyebrow\">Status</div>\n            <div class=\"status-label\" id=\"status-label\">PRONTO</div>\n            <div class=\"status-detail\" id=\"status-detail\"></div>\n            <div class=\"status-mini\">\n                <span class=\"mini-pill\" id=\"mode-pill\">SSH</span>\n                <span class=\"mini-pill\" id=\"auth-pill\">—</span>\n            </div>\n        </div>\n    </section>\n\n    <!-- Timer -->\n    <div class=\"timer-bar\" id=\"timer-bar\">\n        <span class=\"timer-label\">⏱ CONECTADO