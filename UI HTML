{
  "Version": "6.2",
  "HtmlUI": "@<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n<title>BK VPN</title>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n\n:root {\n    --bg:     #070b20;\n    --bg2:    #0b102a;\n    --card:   rgba(18,24,55,.78);\n    --line:   rgba(137,155,255,.18);\n    --line2:  rgba(0,229,255,.38);\n    --text:   #f4f7ff;\n    --muted:  #8992b5;\n    --cyan:   #19e6ff;\n    --purple: #9a6cff;\n    --green:  #41f19a;\n    --yellow: #ffd66b;\n    --red:    #ff4c79;\n    --orange: #ff8c42;\n    --shadow: 0 20px 60px rgba(0,0,0,.45);\n}\n\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;margin:0;padding:0}\nhtml,body{min-height:100%}\n\nbody{\n    font-family:Inter,system-ui,sans-serif;\n    color:var(--text);\n    background:\n        radial-gradient(circle at 15% 0%,rgba(25,230,255,.14),transparent 28%),\n        radial-gradient(circle at 85% 18%,rgba(154,108,255,.14),transparent 30%),\n        linear-gradient(180deg,var(--bg),var(--bg2));\n    overflow-x:hidden;\n}\n\n/* wallpaper */\nbody::before{content:'';position:fixed;inset:0;background:var(--bk-bg,none) center/cover no-repeat;opacity:.1;pointer-events:none;z-index:0}\n/* grid */\nbody::after{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:34px 34px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.9),transparent 70%);pointer-events:none;z-index:0}\n\nbutton{cursor:pointer;touch-action:manipulation;user-select:none;border:none;background:none}\n\n/* ── Ícones fallback ── */\n.bi{font-style:normal;display:inline-flex;align-items:center;justify-content:center;line-height:1;font-weight:900}\n.bi-list:before{content:'☰'}.bi-x-lg:before{content:'×'}.bi-megaphone-fill:before{content:'📣'}\n.bi-hdd-network-fill:before{content:'▤'}.bi-shield-lock-fill:before{content:'▣'}\n.bi-chevron-right:before{content:'›'}.bi-arrow-repeat:before{content:'↻'}\n.bi-card-list:before{content:'▤'}.bi-check-circle:before{content:'✓'}\n.bi-person-check:before{content:'☑'}.bi-stars:before{content:'✦'}\n.bi-diagram-3:before{content:'⌘'}.bi-wifi:before{content:'◌'}\n.bi-trash3:before{content:'⌫'}.bi-share:before{content:'⌯'}\n\n/* ── Shell ── */\n.app-shell{position:relative;z-index:1;width:min(100%,480px);margin:0 auto;min-height:100vh;padding:14px 14px calc(24px + env(safe-area-inset-bottom))}\n\n/* ── Topbar ── */\n.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 2px 14px;position:relative;z-index:70}\n.brand{display:flex;align-items:center;gap:12px;min-width:0;flex:1}\n.brand-logo-wrap{position:relative;width:52px;height:52px;border-radius:18px;overflow:hidden;flex:0 0 auto;background:radial-gradient(circle at 30% 20%,rgba(34,229,255,.22),rgba(255,255,255,.06));box-shadow:0 0 0 1px rgba(255,255,255,.08),0 8px 28px rgba(0,0,0,.35)}\n.brand-logo{width:100%;height:100%;object-fit:cover;display:none}\n.brand-logo.loaded{display:block}\n.brand-logo-fallback{position:absolute;inset:0;display:grid;place-items:center;color:#eaf7ff;font-weight:900;font-size:18px;text-shadow:0 0 18px rgba(34,229,255,.34)}\n.brand-title{font-weight:900;font-size:20px;line-height:1.05}\n.brand-sub{color:var(--muted);font-weight:700;font-size:12px;margin-top:3px}\n.icon-btn{width:46px;height:46px;border-radius:16px;display:inline-flex;align-items:center;justify-content:center;color:var(--text);background:rgba(255,255,255,.07);box-shadow:inset 0 0 0 1px rgba(255,255,255,.08);font-size:22px;flex:0 0 auto}\n.icon-btn:active{opacity:.75}\n\n/* ── Status card ── */\n.status-card{position:relative;z-index:2;border-radius:30px;padding:24px;background:linear-gradient(145deg,rgba(22,31,70,.88),rgba(9,13,34,.88));border:1.5px solid rgba(25,230,255,.35);box-shadow:var(--shadow),0 0 34px rgba(25,230,255,.10);display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:center;transition:border-color .4s,box-shadow .4s}\n\nbody.st-conectado  .status-card{border-color:rgba(65,241,154,.55);box-shadow:var(--shadow),0 0 40px rgba(65,241,154,.16)}\nbody.st-conectando .status-card{border-color:rgba(255,214,107,.45);box-shadow:var(--shadow),0 0 34px rgba(255,214,107,.12)}\nbody.st-erro       .status-card{border-color:rgba(255,76,121,.45);box-shadow:var(--shadow),0 0 34px rgba(255,76,121,.12)}\n\n/* power orb */\n.power-orb{width:96px;height:96px;border-radius:32px;display:grid;place-items:center;position:relative;background:radial-gradient(circle,rgba(25,230,255,.24),rgba(25,230,255,.04) 60%);box-shadow:inset 0 0 0 1.5px rgba(25,230,255,.22),0 0 40px rgba(25,230,255,.16);transition:background .4s,box-shadow .4s}\nbody.st-conectado  .power-orb{background:radial-gradient(circle,rgba(65,241,154,.22),rgba(65,241,154,.04) 60%);box-shadow:inset 0 0 0 1.5px rgba(65,241,154,.3),0 0 40px rgba(65,241,154,.18)}\nbody.st-conectando .power-orb{background:radial-gradient(circle,rgba(255,214,107,.2),rgba(255,214,107,.04) 60%);box-shadow:inset 0 0 0 1.5px rgba(255,214,107,.3),0 0 34px rgba(255,214,107,.14)}\nbody.st-erro       .power-orb{background:radial-gradient(circle,rgba(255,76,121,.2),rgba(255,76,121,.04) 60%);box-shadow:inset 0 0 0 1.5px rgba(255,76,121,.3),0 0 34px rgba(255,76,121,.14)}\n\n/* anel girando */\n.power-orb::before{content:'';position:absolute;inset:-4px;border-radius:36px;border:2px solid transparent;border-top-color:var(--yellow);opacity:0;transition:opacity .3s}\nbody.st-conectando .power-orb::before{opacity:1;animation:spin .9s linear infinite}\n@keyframes spin{to{transform:rotate(360deg)}}\n\n/* ícone power SVG */\n.power-svg{width:40px;height:40px;transition:color .4s;color:var(--cyan)}\nbody.st-conectado  .power-svg{color:var(--green)}\nbody.st-conectando .power-svg{color:var(--yellow)}\nbody.st-erro       .power-svg{color:var(--red)}\n\n.eyebrow{color:var(--muted);font-weight:900;letter-spacing:.25em;font-size:11px;text-transform:uppercase}\n.status-label{margin-top:8px;font-size:28px;font-weight:900;letter-spacing:.07em;text-transform:uppercase;color:var(--cyan);transition:color .4s}\nbody.st-conectado  .status-label{color:var(--green)}\nbody.st-conectando .status-label{color:var(--yellow)}\nbody.st-erro       .status-label{color:var(--red)}\n.status-detail{margin-top:5px;font-size:12px;color:var(--muted);font-weight:700;min-height:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.status-mini{margin-top:10px;display:flex;flex-wrap:wrap;gap:7px}\n.mini-pill{padding:5px 9px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.07);color:var(--muted);font-size:10px;font-weight:800;text-transform:uppercase;transition:color .3s,border-color .3s}\n.mini-pill.ok{color:var(--green);border-color:rgba(65,241,154,.3)}\n\n/* ── CheckUser card ── */\n.checkuser-card{display:none;border-radius:20px;padding:14px 16px;background:var(--card);border:1px solid rgba(25,230,255,.22);margin:10px 0}\n.checkuser-card.show{display:block}\n.cu-title{font-size:11px;font-weight:900;letter-spacing:.1em;text-transform:uppercase;color:var(--cyan);margin-bottom:10px}\n.cu-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n.cu-label{font-size:10px;color:var(--muted);font-weight:700}\n.cu-value{font-size:13px;font-weight:900;color:#fff;margin-top:2px}\n.cu-value.green{color:var(--green)}\n\n/* ── Timer conexão ── */\n.timer-bar{display:none;align-items:center;justify-content:center;gap:8px;padding:10px;border-radius:18px;margin:10px 0 0;background:rgba(65,241,154,.07);border:1px solid rgba(65,241,154,.22)}\n.timer-bar.show{display:flex}\n.timer-label{color:var(--green);font-weight:900;font-size:12px;letter-spacing:.06em}\n.timer-val{color:var(--green);font-weight:900;font-size:18px;font-variant-numeric:tabular-nums}\n\n/* ── Tempo restante (free) ── */\n.time-card{display:none;border-radius:20px;padding:14px 16px;background:var(--card);border:1px solid rgba(255,214,107,.28);margin:10px 0}\n.time-card.show{display:block}\n.time-card-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}\n.time-card-title{font-size:11px;font-weight:900;letter-spacing:.1em;text-transform:uppercase;color:var(--yellow)}\n.time-remaining{font-size:22px;font-weight:900;font-variant-numeric:tabular-nums;color:var(--yellow)}\n.time-bar-track{height:5px;background:rgba(255,255,255,.08);border-radius:999px;overflow:hidden;margin-bottom:12px}\n.time-bar-fill{height:100%;background:linear-gradient(90deg,var(--yellow),var(--orange));border-radius:999px;transition:width .5s}\n.watch-ad-btn{width:100%;padding:13px;border-radius:16px;background:rgba(255,214,107,.12);border:1px solid rgba(255,214,107,.35);color:var(--yellow);font-size:14px;font-weight:900;letter-spacing:.06em;transition:opacity .15s}\n.watch-ad-btn:active{opacity:.75}\n.watch-ad-btn:disabled{opacity:.4;cursor:not-allowed}\n\n/* ── Botão conectar ── */\n.connect-row{margin:14px 0;display:grid;grid-template-columns:1fr auto;gap:12px}\n.connect-btn{min-height:66px;border-radius:23px;font-size:17px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;background:linear-gradient(135deg,#19e6ff,#5f7dff);color:#051022;box-shadow:0 14px 40px rgba(25,230,255,.22);transition:opacity .15s,transform .1s,background .3s}\n.connect-btn:active{transform:scale(.97);opacity:.88}\nbody.st-conectado  .connect-btn{background:linear-gradient(135deg,#ff4c79,#ff8c42);color:#fff;box-shadow:0 14px 40px rgba(255,76,121,.22)}\nbody.st-conectando .connect-btn{background:linear-gradient(135deg,#ffd66b,#ff8c42);color:#1a0e00;box-shadow:0 14px 40px rgba(255,214,107,.22)}\n\n/* botão atualizar ao lado */\n.update-btn{width:66px;min-height:66px;border-radius:23px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.08);color:var(--cyan);font-size:22px;display:flex;align-items:center;justify-content:center}\n.update-btn:active{opacity:.75}\n\n/* ── Aviso ── */\n.message-card{display:none;align-items:center;gap:12px;padding:13px 15px;border-radius:20px;margin:8px 0;background:var(--card);border:1px solid rgba(255,214,107,.28)}\n.message-card.show{display:flex}\n.msg-icon{font-size:20px}\n.msg-title{font-size:11px;font-weight:900;letter-spacing:.1em;text-transform:uppercase;color:var(--yellow)}\n.msg-text{font-size:13px;color:rgba(255,255,255,.88);margin-top:2px}\n\n/* ── Speed grid ── */\n.speed-grid{display:none;grid-template-columns:repeat(3,1fr);gap:8px;padding:12px;border-radius:22px;margin:10px 0;background:var(--card);border:1px solid var(--line)}\n.speed-grid.show{display:grid}\n.speed-cell{padding:9px 6px;border-radius:16px;background:rgba(255,255,255,.045);text-align:center}\n.speed-label{font-size:9px;color:var(--muted);font-weight:900;letter-spacing:.08em;text-transform:uppercase}\n.speed-val{margin-top:4px;font-size:12px;font-weight:900;color:var(--cyan)}\n\n/* ── Cards ── */\n.summary-list{display:grid;gap:10px;margin-top:12px;position:relative;z-index:3}\n.summary-card{border-radius:22px;padding:15px;display:flex;align-items:center;gap:13px;min-height:74px;background:var(--card);border:1px solid var(--line);box-shadow:0 12px 40px rgba(0,0,0,.18);cursor:pointer;transition:opacity .15s}\n.summary-card:active{opacity:.8}\n.summary-card .circle{width:46px;height:46px;flex:0 0 46px;border-radius:16px;display:grid;place-items:center;background:rgba(25,230,255,.1);color:var(--cyan);font-size:22px;overflow:hidden}\n.summary-card .circle img{width:100%;height:100%;object-fit:cover;border-radius:12px}\n.summary-card .meta{min-width:0;flex:1}\n.summary-card .s-label{font-size:11px;font-weight:900;color:var(--muted);letter-spacing:.08em;text-transform:uppercase}\n.summary-card .s-title{margin-top:5px;font-size:15px;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.summary-card .s-sub{margin-top:4px;color:var(--muted);font-size:11px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.summary-card .chev{color:rgba(255,255,255,.3);font-size:20px}\n\n/* ── Rodapé ── */\n.bottom-meta{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin:18px 0 4px;color:var(--muted);font-size:12px;font-weight:800;position:relative;z-index:3}\n.bottom-meta span{background:rgba(255,255,255,.055);padding:7px 10px;border-radius:999px}\n\n/* ── Drawer ── */\n.drawer-mask{position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.5);opacity:0;pointer-events:none;transition:.22s}\n.drawer-mask.show{opacity:1;pointer-events:auto}\n.drawer{position:fixed;z-index:60;top:0;right:0;width:min(88vw,340px);height:100vh;overflow-y:auto;background:linear-gradient(180deg,rgba(12,17,43,.98),rgba(7,10,27,.98));border-left:1px solid var(--line2);box-shadow:-26px 0 80px rgba(0,0,0,.6);transform:translateX(105%);transition:.25s ease;padding:18px}\n.drawer.show{transform:translateX(0)}\n.drawer-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}\n.drawer-title{font-size:18px;font-weight:950}\n.side-section{border-radius:20px;padding:14px;margin-bottom:12px;background:var(--card);border:1px solid var(--line)}\n.side-title{font-size:11px;color:var(--muted);font-weight:950;letter-spacing:.14em;text-transform:uppercase;margin-bottom:10px}\n.tool-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}\n.tool-btn{min-height:72px;border:1px solid rgba(255,255,255,.08);border-radius:18px;background:rgba(255,255,255,.04);color:var(--text);padding:10px 12px;text-align:left;font-weight:900;font-size:12px}\n.tool-btn:active{opacity:.7}\n.tool-btn .ti{display:block;font-size:22px;margin-bottom:8px;color:var(--cyan)}\n.toggle-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 0;border-top:1px solid rgba(255,255,255,.06)}\n.toggle-row:first-child{border-top:0}\n.toggle-info b{display:block;font-size:13px}\n.toggle-info small{color:var(--muted);font-size:11px}\n\n/* ── Modal ── */\n.modal-mask{position:fixed;inset:0;z-index:80;display:flex;align-items:flex-end;justify-content:center;padding:14px;background:rgba(0,0,0,.5);opacity:0;pointer-events:none;transition:.22s}\n.modal-mask.show{opacity:1;pointer-events:auto}\n.modal-box{display:none;flex-direction:column;width:min(100%,460px);max-height:80vh;border-radius:28px 28px 22px 22px;background:rgba(10,14,36,.97);border:1px solid var(--line);overflow:hidden;transform:translateY(24px);opacity:0;transition:transform .22s,opacity .22s}\n.modal-mask.show .modal-box.active{display:flex;transform:translateY(0);opacity:1}\n.modal-head{display:flex;align-items:center;justify-content:space-between;padding:16px 16px 12px;border-bottom:1px solid rgba(255,255,255,.07);flex:0 0 auto}\n.modal-title{font-weight:950;font-size:16px}\n.modal-body{padding:14px;overflow-y:auto;flex:1}\n\n/* lista servidores */\n.list-item{display:flex;align-items:center;gap:12px;padding:12px;border-radius:18px;margin-bottom:9px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);cursor:pointer;transition:opacity .15s}\n.list-item:active{opacity:.75}\n.list-item.selected{border-color:rgba(25,230,255,.5);background:rgba(25,230,255,.08)}\n.li-icon{width:40px;height:40px;flex:0 0 40px;border-radius:14px;display:grid;place-items:center;background:rgba(25,230,255,.1);color:var(--cyan);overflow:hidden;font-size:18px}\n.li-icon img{width:100%;height:100%;object-fit:cover}\n.li-main{min-width:0;flex:1}\n.li-title{font-weight:900;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.li-sub{color:var(--muted);font-size:11px;margin-top:4px}\n.li-check{color:var(--cyan);display:none;font-size:18px}\n.list-item.selected .li-check{display:block}\n.group-title{color:var(--cyan);font-size:11px;font-weight:950;letter-spacing:.12em;margin:14px 4px 8px;text-transform:uppercase}\n\n/* logs */\n#log-container{font-family:'Courier New',monospace;font-size:11.5px;line-height:1.65}\n.log-entry{display:flex;gap:8px;align-items:flex-start;padding:5px 8px;border-radius:10px;margin-bottom:3px;border-left:2.5px solid transparent}\n.log-entry.INFO{background:rgba(255,255,255,.03);border-left-color:rgba(137,155,255,.4)}\n.log-entry.DEBUG{background:rgba(25,230,255,.04);border-left-color:rgba(25,230,255,.3)}\n.log-entry.WARNING{background:rgba(255,214,107,.06);border-left-color:var(--yellow)}\n.log-entry.ERROR{background:rgba(255,76,121,.07);border-left-color:var(--red)}\n.log-time{color:var(--muted);font-size:10px;white-space:nowrap;padding-top:1px;flex:0 0 auto}\n.log-msg{color:var(--text);word-break:break-all}\n.log-entry.WARNING .log-msg{color:var(--yellow)}\n.log-entry.ERROR   .log-msg{color:var(--red)}\n.log-entry.DEBUG   .log-msg{color:rgba(25,230,255,.85)}\n.logs-toolbar{display:flex;gap:8px;justify-content:flex-end;padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,.06);margin-bottom:10px}\n.log-action-btn{padding:6px 12px;border-radius:10px;font-size:11px;font-weight:900;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);color:var(--text)}\n.log-action-btn.danger{background:rgba(255,76,121,.12);border-color:rgba(255,76,121,.3);color:var(--red)}\n\n/* toast */\n.toast-box{position:fixed;z-index:120;left:14px;right:14px;bottom:calc(16px + env(safe-area-inset-bottom));display:grid;place-items:center;pointer-events:none}\n.toast{padding:12px 15px;border-radius:16px;background:rgba(7,10,27,.94);color:var(--text);border:1px solid rgba(25,230,255,.24);font-size:13px;font-weight:800;opacity:0;transform:translateY(10px);transition:.2s ease;max-width:min(92vw,400px);text-align:center}\n.toast.show{opacity:1;transform:translateY(0)}\n.toast.ok{border-color:rgba(65,241,154,.4)}\n.toast.err{border-color:rgba(255,76,121,.45)}\n.toast.warn{border-color:rgba(255,214,107,.4)}\n\n@media(max-width:370px){\n    .status-card{grid-template-columns:1fr;text-align:center;place-items:center}\n    .power-orb{width:80px;height:80px}\n    .connect-row{grid-template-columns:1fr}\n}\n</style>\n</head>\n<body>\n<div class=\"app-shell\">\n\n    <!-- Topbar -->\n    <div class=\"topbar\">\n        <div class=\"brand\">\n            <div class=\"brand-logo-wrap\">\n                <img class=\"brand-logo\" id=\"logo-img\" alt=\"\">\n                <div class=\"brand-logo-fallback\" id=\"logo-fallback\">BK</div>\n            </div>\n            <div>\n                <div class=\"brand-title\" id=\"app-name\">BK VPN</div>\n                <div class=\"brand-sub\" id=\"app-sub\">Conexão segura</div>\n            </div>\n        </div>\n        <button class=\"icon-btn\" id=\"btn-menu\">☰</button>\n    </div>\n\n    <!-- Status -->\n    <section class=\"status-card\">\n        <div class=\"power-orb\">\n            <svg class=\"power-svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M18.36 6.64A9 9 0 1 1 5.64 6.64\"/>\n                <line x1=\"12\" y1=\"2\" x2=\"12\" y2=\"12\"/>\n            </svg>\n        </div>\n        <div>\n            <div class=\"eyebrow\">Status</div>\n            <div class=\"status-label\" id=\"status-label\">PRONTO</div>\n            <div class=\"status-detail\" id=\"status-detail\"></div>\n            <div class=\"status-mini\">\n                <span class=\"mini-pill\" id=\"mode-pill\">SSH</span>\n                <span class=\"mini-pill\" id=\"auth-pill\">—</span>\n            </div>\n        </div>\n    </section>\n\n    <!-- Timer conexão -->\n    <div class=\"timer-bar\" id=\"timer-bar\">\n        <span class=\"timer-label\">⏱ CONECTADO HÁ</span>\n        <span class=\"timer-val\" id=\"timer-val\">00:00</span>\n    </div>\n\n    <!-- Speed grid -->\n    <div class=\"speed-grid\" id=\"speed-grid\">\n        <div class=\"speed-cell\"><div class=\"speed-label\">Download</div><div class=\"speed-val\" id=\"speed-down\">0 KB/s</div></div>\n        <div class=\"speed-cell\"><div class=\"speed-label\">Upload</div><div class=\"speed-val\" id=\"speed-up\">0 KB/s</div></div>\n        <div class=\"speed-cell\"><div class=\"speed-label\">Tempo</div><div class=\"speed-val\" id=\"speed-time\">00:00</div></div>\n    </div>\n\n    <!-- Botão conectar + atualizar -->\n    <div class=\"connect-row\">\n        <button class=\"connect-btn\" id=\"btn-connect\">CONECTAR</button>\n        <button class=\"update-btn\" id=\"btn-update\" title=\"Atualizar\">↻</button>\n    </div>\n\n    <!-- Aviso -->\n    <div class=\"message-card\" id=\"message-card\">\n        <span class=\"msg-icon\">📣</span>\n        <div>\n            <div class=\"msg-title\">Aviso</div>\n            <div class=\"msg-text\" id=\"message-text\"></div>\n        </div>\n    </div>\n\n    <!-- CheckUser -->\n    <div class=\"checkuser-card\" id=\"checkuser-card\">\n        <div class=\"cu-title\">👤 Informações da Conta</div>\n        <div class=\"cu-grid\">\n            <div><div class=\"cu-label\">Usuário</div><div class=\"cu-value\" id=\"cu-username\">—</div></div>\n            <div><div class=\"cu-label\">Conexões / Limite</div><div class=\"cu-value\" id=\"cu-connections\">—</div></div>\n            <div><div class=\"cu-label\">Vencimento</div><div class=\"cu-value\" id=\"cu-expiration\">—</div></div>\n            <div><div class=\"cu-label\">Dias restantes</div><div class=\"cu-value green\" id=\"cu-days\">—</div></div>\n        </div>\n    </div>\n\n    <!-- Tempo restante (free) -->\n    <div class=\"time-card\" id=\"time-card\">\n        <div class=\"time-card-head\">\n            <span class=\"time-card-title\">⏳ Tempo restante</span>\n            <span class=\"time-remaining\" id=\"time-remaining-val\">--:--</span>\n        </div>\n        <div class=\"time-bar-track\"><div class=\"time-bar-fill\" id=\"time-bar-fill\" style=\"width:100%\"></div></div>\n        <button class=\"watch-ad-btn\" id=\"btn-watch-ad\">📺 Assistir anúncio e ganhar +2 horas</button>\n    </div>\n\n    <!-- Cards -->\n    <div class=\"summary-list\">\n        <div class=\"summary-card\" id=\"select-server\">\n            <div class=\"circle\" id=\"server-flag-wrap\">🌐</div>\n            <div class=\"meta\">\n                <div class=\"s-label\">Servidor</div>\n                <div class=\"s-title\" id=\"server-title\">Selecionar servidor</div>\n                <div class=\"s-sub\"   id=\"server-sub\">Toque para escolher</div>\n            </div>\n            <span class=\"chev\">›</span>\n        </div>\n\n        <div class=\"summary-card multi-card\" id=\"select-multi\">\n            <div class=\"circle\" id=\"multi-flag-wrap\">⭐</div>\n            <div class=\"meta\">\n                <div class=\"s-label\">Servidor Premium</div>\n                <div class=\"s-title\" id=\"multi-title\">Selecionar premium</div>\n                <div class=\"s-sub\"   id=\"multi-sub\">Toque para escolher</div>\n            </div>\n            <span class=\"chev\">›</span>\n        </div>\n\n        <div class=\"summary-card\" id=\"creds-btn\">\n            <div class=\"circle\">🔐</div>\n            <div class=\"meta\">\n                <div class=\"s-label\">Credenciais</div>\n                <div class=\"s-title\" id=\"creds-title\">Configuradas</div>\n                <div class=\"s-sub\"   id=\"creds-sub\">Toque para ajustar</div>\n            </div>\n            <span class=\"chev\">›</span>\n        </div>\n    </div>\n\n    <!-- Rodapé -->\n    <div class=\"bottom-meta\">\n        <span>v<span id=\"config-version\">—</span></span>\n    </div>\n\n</div><!-- /app-shell -->\n\n<!-- Drawer -->\n<div class=\"drawer-mask\" id=\"drawer-mask\"></div>\n<aside class=\"drawer\" id=\"drawer\">\n    <div class=\"drawer-head\">\n        <div><div class=\"drawer-title\">Menu</div><div class=\"brand-sub\">Ferramentas</div></div>\n        <button class=\"icon-btn\" id=\"btn-menu-close\">×</button>\n    </div>\n    <section class=\"side-section\">\n        <div class=\"side-title\">Ações rápidas</div>\n        <div class=\"tool-grid\">\n            <button class=\"tool-btn\" id=\"btn-logs\"><span class=\"ti\">📋</span>Logs</button>\n            <button class=\"tool-btn\" id=\"btn-drawer-update\"><span class=\"ti\">↻</span>Atualizar</button>\n            <button class=\"tool-btn\" id=\"btn-servers-drawer\"><span class=\"ti\">🌐</span>Servidores</button>\n            <button class=\"tool-btn\" id=\"btn-creds-drawer\"><span class=\"ti\">🔐</span>Credenciais</button>\n        </div>\n    </section>\n    <section class=\"side-section\">\n        <div class=\"side-title\">Informações</div>\n        <div class=\"toggle-row\">\n            <div class=\"toggle-info\"><b>Multi servidor</b><small id=\"multi-info\">—</small></div>\n            <span style=\"color:var(--cyan)\"><i class=\"bi bi-diagram-3\"></i></span>\n        </div>\n        <div class=\"toggle-row\">\n            <div class=\"toggle-info\"><b>Rede</b><small id=\"network-info\">—</small></div>\n            <span style=\"color:var(--cyan)\"><i class=\"bi bi-wifi\"></i></span>\n        </div>\n    </section>\n</aside>\n\n<!-- Modal -->\n<div class=\"modal-mask\" id=\"modal-mask\">\n    <!-- Servidores + Premium -->\n    <div class=\"modal-box\" id=\"modal-servers\">\n        <div class=\"modal-head\">\n            <div class=\"modal-title\">Servidores</div>\n            <button class=\"icon-btn modal-close\">×</button>\n        </div>\n        <div class=\"modal-tabs\">\n            <button class=\"modal-tab active\" id=\"tab-servers\" type=\"button\">Operadoras</button>\n            <button class=\"modal-tab modal-tab-multi\" id=\"tab-multi\" type=\"button\">⭐ Premium</button>\n        </div>\n        <div class=\"modal-body\">\n            <div class=\"tab-panel show\" id=\"panel-servers\"></div>\n            <div class=\"tab-panel\"      id=\"panel-multi\"></div>\n        </div>\n    </div>\n    <!-- Logs -->\n    <div class=\"modal-box\" id=\"modal-logs\">\n        <div class=\"modal-head\">\n            <div class=\"modal-title\">Logs de conexão</div>\n            <button class=\"icon-btn modal-close\">×</button>\n        </div>\n        <div class=\"modal-body\">\n            <div class=\"logs-toolbar\">\n                <button class=\"log-action-btn\" id=\"btn-refresh-logs\">↻ Atualizar</button>\n                <button class=\"log-action-btn danger\" id=\"btn-clear-logs\">🗑 Limpar</button>\n            </div>\n            <div id=\"log-container\"></div>\n        </div>\n    </div>\n</div>\n\n<!-- Toast -->\n<div class=\"toast-box\"><div class=\"toast\" id=\"toast\"></div></div>\n\n<script>\n(function(){\n'use strict';\n\n/* ═══════════════════════════════════\n   BRIDGE — Android.metodo()\n═══════════════════════════════════ */\nvar A={\n    _c:function(m,a){try{if(window.Android&&typeof window.Android[m]==='function')return a!==undefined?window.Android[m](a):window.Android[m]()}catch(e){}return null},\n    _j:function(r,f){try{return JSON.parse(r)||f}catch(e){return f}},\n    connect:      function(){A._c('connect')},\n    getStatus:    function(){return A._c('getStatus')||'DESCONECTADO'},\n    getServers:    function(){return A._j(A._c('getServers'),[])},\n    getSelected:   function(){return A._j(A._c('getSelectedServer'),{})},\n    selectServer:  function(p){A._c('selectServer',p)},\n    getMultiServs: function(){return A._j(A._c('getMultiServs'),[])},\n    getSelMulti:   function(){return A._j(A._c('getSelectedMultiServer'),{})},\n    selectMulti:   function(p){A._c('selectMultiServer',p)},\n    getNote:      function(){return A._c('getNote')||''},\n    getVersion:   function(){return A._c('getVersion')||''},\n    getLogs:      function(){return A._j(A._c('getLogs'),[])},\n    clearLogs:    function(){A._c('clearLogs')},\n    openServers:  function(){A._c('openServers')},\n    checkUpdate:  function(){A._c('checkUpdate')},\n    isAdsEnabled: function(){try{if(window.Android&&typeof window.Android.isAdsEnabled==='function')return window.Android.isAdsEnabled()}catch(e){}return false},\n    getTimeLeft:  function(){try{if(window.Android&&typeof window.Android.getTimeLeft==='function')return window.Android.getTimeLeft()}catch(e){}return 0},\n    watchAd:      function(){A._c('watchAd')}\n};\n\n/* ═══════════════════════════════════\n   Estado\n═══════════════════════════════════ */\nvar app={rawState:'NOPROCESS',connected:false,busy:false,startedAt:0,timerHandle:null,pollHandle:null};\nvar MAX_FREE_MS=999999999;\nvar baseTimeMs=7200000;\nvar timeHandle=null;\n\n/* ═══════════════════════════════════\n   Utilitários\n═══════════════════════════════════ */\nfunction $(id){return document.getElementById(id)}\nfunction setText(id,v){var el=$(id);if(el)el.textContent=String(v==null?'':v)}\nfunction pad(n){return String(n).padStart(2,'0')}\nfunction esc(s){return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c])})}\nfunction toast(msg,kind){var el=$('toast');if(!el)return;el.textContent=msg;el.className='toast show'+(kind?' '+kind:'');clearTimeout(el._t);el._t=setTimeout(function(){el.className='toast'},2800)}\n\n/* ═══════════════════════════════════\n   Estados VPN\n═══════════════════════════════════ */\nvar ALL_CLASSES=['st-conectado','st-conectando','st-desconectado','st-erro'];\nvar STATE_MAP={\n    CONECTADO:    {cls:'st-conectado',  label:'CONECTADO',    auth:'ONLINE', authOk:true},\n    DESCONECTADO: {cls:'',              label:'DESCONECTADO', auth:'—',      authOk:false},\n    INICIANDO:    {cls:'st-conectando', label:'INICIANDO',    auth:'...',    authOk:false},\n    PARANDO:      {cls:'st-conectando', label:'PARANDO',      auth:'...',    authOk:false},\n    CONECTANDO:   {cls:'st-conectando', label:'CONECTANDO',   auth:'...',    authOk:false},\n    AGUARDANDO:   {cls:'st-conectando', label:'AGUARDANDO',   auth:'...',    authOk:false},\n    AUTENTICANDO: {cls:'st-conectando', label:'AUTENTICANDO', auth:'...',    authOk:false},\n    RECONECTANDO: {cls:'st-conectando', label:'RECONECTANDO', auth:'...',    authOk:false},\n    NOPROCESS:    {cls:'',              label:'PRONTO',        auth:'—',     authOk:false},\n    ERRO:         {cls:'st-erro',       label:'ERRO',          auth:'FALHA', authOk:false}\n};\n\nfunction applyState(raw,detail){\n    raw=String(raw||'NOPROCESS').toUpperCase().trim();\n    app.rawState=raw;\n    var s=STATE_MAP[raw]||STATE_MAP['NOPROCESS'];\n    ALL_CLASSES.forEach(function(c){document.body.classList.remove(c)});\n    if(s.cls)document.body.classList.add(s.cls);\n    setText('status-label',s.label);\n    setText('status-detail',detail||'');\n    var ap=$('auth-pill');if(ap){ap.textContent=s.auth;ap.classList.toggle('ok',s.authOk)}\n    var btn=$('btn-connect');\n    if(btn){\n        if(raw==='CONECTADO')btn.textContent='DESCONECTAR';\n        else if(raw==='INICIANDO'||raw==='CONECTANDO'||raw==='AUTENTICANDO'||raw==='AGUARDANDO'||raw==='RECONECTANDO')btn.textContent='CANCELAR';\n        else if(raw==='PARANDO')btn.textContent='AGUARDE...';\n        else btn.textContent='CONECTAR';\n    }\n    app.connected=(raw==='CONECTADO');\n    app.busy=(raw==='INICIANDO'||raw==='CONECTANDO'||raw==='AUTENTICANDO'||raw==='AGUARDANDO'||raw==='RECONECTANDO'||raw==='PARANDO');\n    var sg=$('speed-grid');if(sg)sg.classList.toggle('show',app.connected);\n    if(app.connected&&!app.startedAt){app.startedAt=Date.now();startTimer()}\n    if(!app.connected&&!app.busy){app.startedAt=0;stopTimer();setText('timer-val','00:00');var tb=$('timer-bar');if(tb)tb.classList.remove('show')}\n}\n\nfunction startTimer(){stopTimer();var tb=$('timer-bar');if(tb)tb.classList.add('show');app.timerHandle=setInterval(function(){var sec=Math.floor((Date.now()-app.startedAt)/1000);var h=Math.floor(sec/3600),m=Math.floor((sec%3600)/60),s=sec%60;setText('timer-val',(h?pad(h)+':':'')+pad(m)+':'+pad(s));updateSpeedTime(sec)},1000)}\nfunction stopTimer(){if(app.timerHandle){clearInterval(app.timerHandle);app.timerHandle=null}}\n\nfunction updateSpeedTime(sec){var h=Math.floor(sec/3600),m=Math.floor((sec%3600)/60),s=sec%60;setText('speed-time',(h?pad(h)+':':'')+pad(m)+':'+pad(s))}\n\n/* ═══════════════════════════════════\n   Tempo restante (free)\n═══════════════════════════════════ */\nfunction initTimeCard(){\n    var adsOn=A.isAdsEnabled();\n    var left=A.getTimeLeft();\n    var tc=$('time-card');\n    if(!adsOn||left>=MAX_FREE_MS){if(tc)tc.classList.remove('show');return}\n    if(tc)tc.classList.add('show');\n    baseTimeMs=7200000;\n    updateTimeDisplay(left);\n    startTimeCountdown(left);\n}\n\nfunction startTimeCountdown(ms){\n    if(timeHandle)clearInterval(timeHandle);\n    var remaining=ms;\n    timeHandle=setInterval(function(){\n        remaining-=1000;\n        if(remaining<=0){remaining=0;clearInterval(timeHandle);if(app.connected)A.connect();updateTimeDisplay(0);toast('Seu tempo expirou!','warn');return}\n        updateTimeDisplay(remaining);\n    },1000);\n}\n\nfunction updateTimeDisplay(ms){\n    var tv=$('time-remaining-val');if(!tv)return;\n    if(ms<=0){tv.textContent='00:00';var bf=$('time-bar-fill');if(bf)bf.style.width='0%';return}\n    var tot=Math.floor(ms/1000),h=Math.floor(tot/3600),m=Math.floor((tot%3600)/60),s=tot%60;\n    tv.textContent=(h?pad(h)+':':'')+pad(m)+':'+pad(s);\n    var bf=$('time-bar-fill');\n    if(bf){var pct=Math.min(100,(ms/baseTimeMs)*100);bf.style.width=pct+'%';bf.style.background=pct<20?'linear-gradient(90deg,#ff4c79,#ff8c42)':'linear-gradient(90deg,#ffd66b,#ff8c42)'}\n}\n\n/* ═══════════════════════════════════\n   Info geral\n═══════════════════════════════════ */\nfunction refreshInfo(){\n    var ver=A.getVersion();if(ver)setText('config-version',ver);\n    var note=A.getNote();var mc=$('message-card');if(mc){mc.classList.toggle('show',!!note);setText('message-text',note)}\n    setText('multi-info','—');\n    setText('network-info','—');\n}\n\n/* ═══════════════════════════════════\n   Servidor selecionado\n═══════════════════════════════════ */\nfunction refreshSelected(){\n    var s=A.getSelected();if(!s||typeof s!=='object')return;\n    setText('server-title',s.Name||'Selecionar servidor');\n    setText('server-sub',s.Info||'Direct');\n    setText('mode-pill',s.Info||'SSH');\n    var wrap=$('server-flag-wrap');\n    if(wrap&&s.Flag){var src='file:///android_asset/flags/'+s.Flag+'.png';wrap.innerHTML='<img src=\"'+esc(src)+'\" onerror=\"this.style.display=\\'none\\'\" style=\"width:100%;height:100%;object-fit:cover;border-radius:12px\">'}\n}\n\n/* ═══════════════════════════════════\n   CheckUser callback\n═══════════════════════════════════ */\nwindow.onCheckUserReceived=function(data){\n    var card=$('checkuser-card');if(!card)return;\n    card.classList.add('show');\n    var u=typeof data==='string'?JSON.parse(data):data;\n    setText('cu-username',u.username||'—');\n    setText('cu-connections',(u.count_connection||'—')+' / '+(u.limiter_user||'—'));\n    setText('cu-expiration',u.expiration_date||'—');\n    setText('cu-days',(u.expiration_days||'—')+' dias');\n};\n\n/* ═══════════════════════════════════\n   Servidores\n═══════════════════════════════════ */\nfunction buildServerList(){\n    var root=$('panel-servers');if(!root)return;root.innerHTML='';\n    var servers=A.getServers();var selected=A.getSelected();var selPos=selected?selected.position:-1;\n    if(!servers||!servers.length){root.innerHTML='<div class=\"list-item\"><div class=\"li-main\"><div class=\"li-title\">Nenhum servidor disponível</div></div></div>';return}\n    // Agrupa por Aba 1 e MultiServs se houver\n    var groups={};\n    servers.forEach(function(s,i){\n        var g=s.group||'Servidores';\n        if(!groups[g])groups[g]=[];\n        groups[g].push({s:s,i:i});\n    });\n    Object.keys(groups).forEach(function(g){\n        var gt=document.createElement('div');gt.className='group-title';gt.textContent=g;root.appendChild(gt);\n        groups[g].forEach(function(obj){\n            var s=obj.s,i=obj.i;\n            var isSel=(s.position===selPos||i===selPos);\n            var flagSrc=s.Flag?'file:///android_asset/flags/'+s.Flag+'.png':'';\n            var el=document.createElement('div');el.className='list-item'+(isSel?' selected':'');\n            el.innerHTML='<div class=\"li-icon\">'+(flagSrc?'<img src=\"'+esc(flagSrc)+'\" onerror=\"this.style.display=\\'none\\'\">'+'':'🌐')+'</div><div class=\"li-main\"><div class=\"li-title\">'+esc(s.Name||'Servidor')+'</div><div class=\"li-sub\">'+esc(s.Info||'Direct')+'</div></div><span class=\"li-check\">✓</span>';\n            el.onclick=function(){if(app.connected){toast('Desconecte antes de trocar.','err');return}A.selectServer(s.position!==undefined?s.position:i);closeModal();setTimeout(function(){refreshSelected()},250);toast('Servidor selecionado!','ok')};\n            root.appendChild(el);\n        });\n    });\n}\n\n/* ═══════════════════════════════════\n   Logs\n═══════════════════════════════════ */\nfunction renderLogs(){\n    var container=$('log-container');if(!container)return;\n    var logs=A.getLogs();\n    if(!logs||!logs.length){container.innerHTML='<div style=\"color:var(--muted);font-size:12px;padding:8px\">Nenhum log disponível.</div>';return}\n    var html='';\n    for(var i=logs.length-1;i>=0;i--){var item=logs[i];var level=String(item.level||'INFO').toUpperCase();var time=item.time?formatLogTime(item.time):'';html+='<div class=\"log-entry '+level+'\"><span class=\"log-time\">'+esc(time)+'</span><span class=\"log-msg\">'+esc(item.message||'')+'</span></div>'}\n    container.innerHTML=html;\n}\nfunction formatLogTime(ms){var d=new Date(ms);return pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds())}\n\n/* ═══════════════════════════════════\n   Modal / Drawer\n═══════════════════════════════════ */\nfunction openDrawer(){$('drawer-mask').classList.add('show');$('drawer').classList.add('show')}\nfunction closeDrawer(){$('drawer-mask').classList.remove('show');$('drawer').classList.remove('show')}\nfunction openModal(id){closeDrawer();$('modal-mask').classList.add('show');document.querySelectorAll('.modal-box').forEach(function(b){b.classList.remove('active')});var box=$(id);if(box)box.classList.add('active')}\nfunction closeModal(){$('modal-mask').classList.remove('show');document.querySelectorAll('.modal-box').forEach(function(b){b.classList.remove('active')})}\n\n/* ═══════════════════════════════════\n   Callbacks Java → HTML\n═══════════════════════════════════ */\nwindow.onVpnStatus=function(raw,detail){applyState(raw,detail||'')};\nwindow.onLogAdded=function(itemJson){\n    var container=$('log-container');if(!container)return;\n    try{var item=typeof itemJson==='string'?JSON.parse(itemJson):itemJson;var level=String(item.level||'INFO').toUpperCase();var time=item.time?formatLogTime(item.time):'';var div=document.createElement('div');div.className='log-entry '+level;div.innerHTML='<span class=\"log-time\">'+esc(time)+'</span><span class=\"log-msg\">'+esc(item.message||'')+'</span>';container.insertBefore(div,container.firstChild)}catch(e){}\n};\nwindow.onLogsCleared=function(){var c=$('log-container');if(c)c.innerHTML=''};\nwindow.onServerChanged=function(){refreshSelected();refreshSelectedMulti()};\nwindow.onConfigUpdated=function(){refreshInfo();refreshSelected();toast('Configuração atualizada!','ok')};\nwindow.onAdLoading=function(){var btn=$('btn-watch-ad');if(btn){btn.textContent='⏳ Carregando...';btn.disabled=true}};\nwindow.onTimeAdded=function(newTotalMs){if(timeHandle)clearInterval(timeHandle);updateTimeDisplay(newTotalMs);startTimeCountdown(newTotalMs);baseTimeMs=Math.max(baseTimeMs,7200000);var btn=$('btn-watch-ad');if(btn){btn.textContent='📺 Assistir anúncio e ganhar +2 horas';btn.disabled=false}toast('+2 horas adicionadas!','ok')};\nwindow.onAdFailed=function(){var btn=$('btn-watch-ad');if(btn){btn.textContent='📺 Assistir anúncio e ganhar +2 horas';btn.disabled=false}toast('Falha ao carregar anúncio.','err')};\n\n/* ═══════════════════════════════════\n   Bind\n═══════════════════════════════════ */\n\nfunction buildMultiList(){\n    var root=$('panel-multi');if(!root)return;root.innerHTML='';\n    var multis=A.getMultiServs();var selM=A.getSelMulti();var selPos=selM?selM.position:-1;\n    if(!multis||!multis.length){root.innerHTML='<div class=\"list-item\"><div class=\"li-main\"><div class=\"li-title\">Nenhum servidor premium disponível</div></div></div>';return}\n    multis.forEach(function(m,i){\n        var isSel=(m.position===selPos||i===selPos);\n        var flagSrc=m.Flag?'file:///android_asset/flags/'+m.Flag+'.png':'';\n        var el=document.createElement('div');el.className='list-item'+(isSel?' selected':'');\n        el.innerHTML='<div class=\"li-icon\" style=\"background:rgba(154,108,255,.15);color:var(--purple)\">'+(flagSrc?'<img src=\"'+esc(flagSrc)+'\" onerror=\"this.style.display='none'\">'+'':'⭐')+'</div><div class=\"li-main\"><div class=\"li-title\">'+esc(m.Name||'Premium')+'</div><div class=\"li-sub\">'+esc(m.Type||'Premium')+'</div></div><span class=\"li-check\" style=\"color:var(--purple)\">✓</span>';\n        el.onclick=function(){if(app.connected){toast('Desconecte antes de trocar.','err');return}A.selectMulti(m.position!==undefined?m.position:i);closeModal();setTimeout(function(){refreshSelectedMulti()},250);toast('Servidor premium selecionado!','ok')};\n        root.appendChild(el);\n    });\n}\n\nfunction showTab(tab){\n    var ts=$('tab-servers'),tm=$('tab-multi'),ps=$('panel-servers'),pm=$('panel-multi');\n    if(tab==='multi'){\n        if(ts)ts.classList.remove('active');if(tm)tm.classList.add('active');\n        if(ps)ps.classList.remove('show');if(pm)pm.classList.add('show');\n    }else{\n        if(ts)ts.classList.add('active');if(tm)tm.classList.remove('active');\n        if(ps)ps.classList.add('show');if(pm)pm.classList.remove('show');\n    }\n}\n\nfunction bind(){\n    $('btn-menu').onclick=openDrawer;\n    $('btn-menu-close').onclick=closeDrawer;\n    $('drawer-mask').onclick=closeDrawer;\n    document.querySelectorAll('.modal-close').forEach(function(b){b.onclick=closeModal});\n    $('modal-mask').onclick=function(e){if(e.target===$('modal-mask'))closeModal()};\n\n    $('btn-connect').onclick=function(){\n        var raw=app.rawState;\n        if(raw==='PARANDO')return;\n        A.connect();\n        if(raw==='CONECTADO')applyState('PARANDO','Encerrando...');\n        else if(raw!=='INICIANDO'&&raw!=='CONECTANDO'&&raw!=='AUTENTICANDO'&&raw!=='AGUARDANDO')applyState('INICIANDO','Preparando...');\n    };\n\n    var doUpdate=function(){toast('Verificando atualização...','');A.checkUpdate();closeDrawer()};\n    $('btn-update').onclick=doUpdate;\n    $('btn-drawer-update').onclick=doUpdate;\n\n    $('select-server').onclick=function(){showTab('servers');buildServerList();buildMultiList();openModal('modal-servers')};\n    $('select-multi').onclick=function(){showTab('multi');buildServerList();buildMultiList();openModal('modal-servers')};\n    $('tab-servers').onclick=function(){showTab('servers')};\n    $('tab-multi').onclick=function(){showTab('multi')};\n    $('creds-btn').onclick=function(){A.openServers()};\n    $('btn-servers-drawer').onclick=function(){buildServerList();openModal('modal-servers')};\n    $('btn-creds-drawer').onclick=function(){closeDrawer();A.openServers()};\n\n    $('btn-logs').onclick=function(){renderLogs();openModal('modal-logs')};\n    $('btn-refresh-logs').onclick=function(){renderLogs()};\n    $('btn-clear-logs').onclick=function(){A.clearLogs();var c=$('log-container');if(c)c.innerHTML='';toast('Log limpo.','')};\n\n    var btnAd=$('btn-watch-ad');\n    if(btnAd)btnAd.onclick=function(){btnAd.textContent='⏳ Carregando...';btnAd.disabled=true;A.watchAd()};\n}\n\n/* ═══════════════════════════════════\n   Boot\n═══════════════════════════════════ */\nfunction boot(){\n    bind();\n    refreshInfo();\n    refreshSelected();\n   