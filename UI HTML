{
  "Version": "1.0",
  "Description": "Interface HTML do BK VPN. Edite HtmlUI para trocar visual sem update na loja.",
  "HtmlUI": "@<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n    <title>BK VPN</title>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n\n        :root {\n            --bg: #070b20;\n            --bg2: #0b102a;\n            --card: rgba(18,24,55,.78);\n            --line: rgba(137,155,255,.18);\n            --line2: rgba(0,229,255,.38);\n            --text: #f4f7ff;\n            --muted: #8992b5;\n            --cyan: #19e6ff;\n            --green: #41f19a;\n            --yellow: #ffd66b;\n            --red: #ff4c79;\n            --shadow: 0 20px 60px rgba(0,0,0,.45);\n        }\n\n        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }\n        html, body { min-height: 100%; margin: 0; }\n\n        body {\n            font-family: Inter, system-ui, sans-serif;\n            color: var(--text);\n            background:\n                radial-gradient(circle at 15% 0%, rgba(25,230,255,.14), transparent 28%),\n                radial-gradient(circle at 85% 18%, rgba(154,108,255,.14), transparent 30%),\n                linear-gradient(180deg, var(--bg), var(--bg2));\n            overflow-x: hidden;\n        }\n\n        /* grade de fundo */\n        body::after {\n            content: '';\n            position: fixed; inset: 0;\n            background-image:\n                linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),\n                linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);\n            background-size: 34px 34px;\n            mask-image: linear-gradient(to bottom, rgba(0,0,0,.9), transparent 70%);\n            pointer-events: none; z-index: 0;\n        }\n\n        /* wallpaper do JSON (Fundo) */\n        body::before {\n            content: '';\n            position: fixed; inset: 0;\n            background: var(--bk-wallpaper, none) center/cover no-repeat;\n            opacity: .12;\n            pointer-events: none; z-index: 0;\n        }\n\n        button { cursor: pointer; touch-action: manipulation; user-select: none; border: none; }\n\n        /* ── Fallback de ícones Bootstrap (WebView sem CDN) ── */\n        .bi { font-style: normal; display: inline-flex; align-items: center; line-height: 1; }\n        .bi-list:before { content: '☰' }\n        .bi-x-lg:before { content: '×' }\n        .bi-hdd-network-fill:before { content: '▤' }\n        .bi-shield-lock-fill:before { content: '▣' }\n        .bi-chevron-right:before { content: '›' }\n        .bi-arrow-repeat:before { content: '↻' }\n        .bi-card-list:before { content: '▤' }\n        .bi-check-circle:before { content: '✓' }\n        .bi-megaphone-fill:before { content: '📣' }\n        .bi-diagram-3-fill:before { content: '⌁' }\n\n        /* ── Shell ── */\n        .app-shell {\n            position: relative; z-index: 1;\n            width: min(100%, 480px);\n            margin: 0 auto;\n            min-height: 100vh;\n            padding: 14px 14px calc(24px + env(safe-area-inset-bottom));\n        }\n\n        /* ── Topbar ── */\n        .topbar {\n            display: flex; align-items: center; justify-content: space-between;\n            gap: 12px; padding: 8px 2px 14px;\n            position: relative; z-index: 70;\n        }\n        .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }\n        .brand-logo-wrap {\n            width: 52px; height: 52px; border-radius: 18px; overflow: hidden; flex: 0 0 auto;\n            background: radial-gradient(circle at 30% 20%, rgba(34,229,255,.22), rgba(255,255,255,.06));\n            box-shadow: 0 0 0 1px rgba(255,255,255,.08), 0 8px 28px rgba(0,0,0,.35);\n            display: grid; place-items: center;\n        }\n        .brand-logo { width: 100%; height: 100%; object-fit: cover; display: none; }\n        .brand-logo.loaded { display: block; }\n        .brand-logo-fallback { color: #eaf7ff; font-weight: 900; font-size: 18px; }\n        .brand-title { font-weight: 900; font-size: 20px; }\n        .brand-sub { color: var(--muted); font-weight: 700; font-size: 12px; margin-top: 3px; }\n        .icon-btn {\n            width: 46px; height: 46px; border-radius: 16px;\n            display: inline-flex; align-items: center; justify-content: center;\n            color: var(--text); background: rgba(255,255,255,.07);\n            box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);\n            font-size: 22px; position: relative; z-index: 75;\n        }\n\n        /* ── Status Card ── */\n        .status-card {\n            position: relative; z-index: 2;\n            border-radius: 30px; padding: 24px; min-height: 162px;\n            background: linear-gradient(145deg, rgba(22,31,70,.88), rgba(9,13,34,.88));\n            border: 1px solid var(--line2);\n            box-shadow: var(--shadow), 0 0 34px rgba(25,230,255,.12);\n            display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: center;\n            transition: border-color .3s, box-shadow .3s;\n        }\n        .status-card.connected {\n            border-color: rgba(65,241,154,.5);\n            box-shadow: var(--shadow), 0 0 34px rgba(65,241,154,.14);\n        }\n        .status-card.connecting { border-color: rgba(255,214,107,.4); }\n\n        /* orb power em CSS puro */\n        .power-orb {\n            width: 96px; height: 96px; border-radius: 32px;\n            display: grid; place-items: center;\n            background: radial-gradient(circle, rgba(25,230,255,.27), rgba(25,230,255,.05) 58%, rgba(255,255,255,.03));\n            box-shadow: inset 0 0 0 1px rgba(25,230,255,.15), 0 0 44px rgba(25,230,255,.18);\n            color: var(--cyan);\n            transition: background .3s, color .3s;\n        }\n        .status-card.connected .power-orb {\n            color: var(--green);\n            background: radial-gradient(circle, rgba(65,241,154,.24), rgba(65,241,154,.06) 60%);\n        }\n        .status-card.connecting .power-orb { color: var(--yellow); }\n        .power-icon {\n            width: 44px; height: 44px; display: block;\n            border: 3.5px solid currentColor;\n            border-top-color: transparent;\n            border-radius: 50%;\n            filter: drop-shadow(0 0 10px currentColor);\n            transition: filter .3s;\n        }\n        .power-icon::before {\n            content: '';\n            position: absolute; left: 50%; top: -10px;\n            width: 4px; height: 28px; border-radius: 999px;\n            background: currentColor; transform: translateX(-50%);\n            box-shadow: 0 0 14px currentColor;\n        }\n        .power-orb { position: relative; }\n        .power-icon { position: relative; }\n        @keyframes spin { to { transform: rotate(360deg); } }\n        .status-card.connecting .power-icon { animation: spin 1.1s linear infinite; }\n\n        .eyebrow { color: var(--muted); font-weight: 900; letter-spacing: .25em; font-size: 11px; text-transform: uppercase; }\n        .status-label { margin-top: 8px; color: var(--cyan); font-size: 28px; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; transition: color .3s; }\n        .status-card.connected .status-label { color: var(--green); }\n        .status-card.connecting .status-label { color: var(--yellow); }\n        .status-mini { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 7px; }\n        .mini-pill {\n            padding: 6px 9px; border-radius: 999px;\n            background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.07);\n            color: var(--muted); font-size: 10px; font-weight: 800; text-transform: uppercase;\n        }\n        .mini-pill.good { color: var(--green); border-color: rgba(65,241,154,.24); }\n\n        /* ── Botão conectar ── */\n        .connect-row { position: relative; z-index: 3; margin: 14px 0; }\n        .connect-btn {\n            width: 100%; min-height: 66px; border-radius: 23px;\n            background: linear-gradient(135deg, rgba(25,230,255,.95), rgba(95,125,255,.88));\n            color: #051022; font-size: 17px; font-weight: 900; letter-spacing: .16em;\n            box-shadow: 0 16px 42px rgba(25,230,255,.22);\n            text-transform: uppercase; transition: opacity .15s, transform .1s;\n        }\n        .connect-btn:active { transform: scale(.97); opacity: .9; }\n        .connect-btn.stop {\n            background: linear-gradient(135deg, rgba(255,76,121,.95), rgba(255,145,79,.88));\n            color: white; box-shadow: 0 16px 42px rgba(255,76,121,.22);\n        }\n\n        /* ── Aviso do JSON (ReleaseNotes) ── */\n        .message-card {\n            display: none; align-items: center; gap: 12px;\n            padding: 13px 15px; border-radius: 20px; margin: 10px 0 12px;\n            background: var(--card); border: 1px solid rgba(255,214,107,.26);\n            backdrop-filter: blur(18px);\n        }\n        .message-card.show { display: flex; }\n        .message-card .msg-icon { color: var(--yellow); font-size: 20px; }\n        .message-card .msg-title { font-size: 11px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; color: var(--yellow); }\n        .message-card .msg-text { font-size: 13px; color: rgba(255,255,255,.9); margin-top: 2px; }\n\n        /* ── Contador de tempo ── */\n        .timer-row {\n            display: none; align-items: center; justify-content: center;\n            gap: 8px; padding: 10px; border-radius: 18px; margin: 6px 0;\n            background: rgba(65,241,154,.07); border: 1px solid rgba(65,241,154,.2);\n        }\n        .timer-row.show { display: flex; }\n        .timer-label { color: var(--green); font-weight: 900; font-size: 13px; letter-spacing: .08em; }\n        .timer-val { color: var(--green); font-weight: 900; font-size: 18px; font-variant-numeric: tabular-nums; }\n\n        /* ── Cards de seleção ── */\n        .summary-list { position: relative; z-index: 3; display: grid; gap: 10px; margin-top: 12px; }\n        .summary-card {\n            border-radius: 22px; padding: 15px; display: flex; align-items: center; gap: 13px;\n            min-height: 74px; cursor: pointer;\n            background: var(--card); border: 1px solid var(--line);\n            box-shadow: 0 12px 40px rgba(0,0,0,.18); backdrop-filter: blur(18px);\n        }\n        .summary-card:active { opacity: .85; }\n        .summary-card .circle {\n            width: 46px; height: 46px; flex: 0 0 46px; border-radius: 16px;\n            display: grid; place-items: center;\n            background: rgba(25,230,255,.1); color: var(--cyan); font-size: 22px; overflow: hidden;\n        }\n        .summary-card .circle img { width: 100%; height: 100%; object-fit: cover; }\n        .summary-card .meta { min-width: 0; flex: 1; }\n        .summary-card .label { font-size: 11px; font-weight: 900; color: var(--muted); letter-spacing: .08em; text-transform: uppercase; }\n        .summary-card .title { margin-top: 5px; font-size: 15px; font-weight: 900; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n        .summary-card .sub { margin-top: 5px; color: var(--muted); font-size: 11px; font-weight: 700; }\n        .summary-card .chev { color: rgba(255,255,255,.38); font-size: 20px; }\n\n        /* ── Rodapé ── */\n        .bottom-meta {\n            position: relative; z-index: 3;\n            display: flex; justify-content: center; flex-wrap: wrap; gap: 8px;\n            margin: 18px 0 4px; color: var(--muted); font-size: 12px; font-weight: 800;\n        }\n        .bottom-meta span { background: rgba(255,255,255,.055); padding: 7px 10px; border-radius: 999px; }\n\n        /* ── Drawer (menu lateral) ── */\n        .drawer-mask {\n            position: fixed; inset: 0; z-index: 50;\n            background: rgba(0,0,0,.48); opacity: 0; pointer-events: none; transition: .22s;\n        }\n        .drawer-mask.show { opacity: 1; pointer-events: auto; }\n        .drawer {\n            position: fixed; z-index: 60; top: 0; right: 0;\n            width: min(90vw, 360px); height: 100vh;\n            background: linear-gradient(180deg, rgba(12,17,43,.98), rgba(7,10,27,.98));\n            border-left: 1px solid var(--line2);\n            box-shadow: -26px 0 80px rgba(0,0,0,.55);\n            transform: translateX(105%); transition: .25s ease;\n            padding: 18px; overflow-y: auto;\n        }\n        .drawer.show { transform: translateX(0); }\n        .drawer-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }\n        .drawer-title { font-size: 18px; font-weight: 950; }\n        .side-section {\n            border-radius: 22px; padding: 14px; margin-bottom: 12px;\n            background: var(--card); border: 1px solid var(--line);\n        }\n        .side-title { font-size: 11px; color: var(--muted); font-weight: 950; letter-spacing: .14em; text-transform: uppercase; margin: 2px 0 10px; }\n        .tool-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }\n        .tool-btn {\n            min-height: 72px; border: 1px solid rgba(255,255,255,.08); border-radius: 18px;\n            background: rgba(255,255,255,.045); color: var(--text);\n            padding: 10px; text-align: left; font-weight: 900; font-size: 12px;\n        }\n        .tool-btn .ti { display: block; color: var(--cyan); font-size: 22px; margin-bottom: 8px; }\n\n        /* ── Modal de servidores ── */\n        .modal-mask {\n            position: fixed; inset: 0; z-index: 80;\n            display: flex; align-items: flex-end; justify-content: center; padding: 14px;\n            background: rgba(0,0,0,.48); opacity: 0; pointer-events: none; transition: .22s;\n        }\n        .modal-mask.show { opacity: 1; pointer-events: auto; }\n        .modal-box {\n            width: min(100%, 460px); max-height: 80vh; overflow: hidden;\n            border-radius: 28px 28px 22px 22px;\n            background: var(--card); border: 1px solid var(--line);\n            backdrop-filter: blur(18px);\n            transform: translateY(30px); opacity: 0; transition: .22s;\n            display: none;\n        }\n        .modal-mask.show .modal-box.active { display: flex; flex-direction: column; transform: translateY(0); opacity: 1; }\n        .modal-head {\n            display: flex; align-items: center; justify-content: space-between;\n            padding: 16px 16px 12px; border-bottom: 1px solid rgba(255,255,255,.07);\n            flex: 0 0 auto;\n        }\n        .modal-title { font-weight: 950; font-size: 16px; }\n        .modal-body { padding: 14px; overflow-y: auto; flex: 1; }\n        .list-item {\n            display: flex; align-items: center; gap: 12px;\n            padding: 12px; border-radius: 18px;\n            background: rgba(255,255,255,.045); border: 1px solid rgba(255,255,255,.06);\n            margin-bottom: 9px; cursor: pointer;\n        }\n        .list-item.selected { border-color: rgba(25,230,255,.55); background: rgba(25,230,255,.09); }\n        .list-item .li-icon {\n            width: 40px; height: 40px; flex: 0 0 40px; border-radius: 14px;\n            display: grid; place-items: center;\n            background: rgba(25,230,255,.1); color: var(--cyan); overflow: hidden; font-size: 18px;\n        }\n        .list-item .li-icon img { width: 100%; height: 100%; object-fit: cover; }\n        .list-item .li-main { min-width: 0; flex: 1; }\n        .list-item .li-title { font-weight: 900; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n        .list-item .li-sub { color: var(--muted); font-size: 11px; margin-top: 4px; }\n        .li-check { color: var(--cyan); display: none; font-size: 18px; }\n        .list-item.selected .li-check { display: block; }\n        .group-title { color: var(--cyan); font-size: 11px; font-weight: 950; letter-spacing: .12em; margin: 14px 4px 8px; text-transform: uppercase; }\n\n        /* ── Toast ── */\n        .toast-box { position: fixed; z-index: 120; left: 14px; right: 14px; bottom: calc(16px + env(safe-area-inset-bottom)); display: grid; place-items: center; pointer-events: none; }\n        .toast {\n            padding: 12px 15px; border-radius: 16px;\n            background: rgba(7,10,27,.94); color: var(--text);\n            border: 1px solid rgba(25,230,255,.24); box-shadow: var(--shadow);\n            font-size: 13px; font-weight: 800;\n            opacity: 0; transform: translateY(10px); transition: .2s ease;\n            max-width: min(92vw,420px);\n        }\n        .toast.show { opacity: 1; transform: translateY(0); }\n        .toast.ok { border-color: rgba(65,241,154,.4); }\n        .toast.err { border-color: rgba(255,76,121,.45); }\n\n        .hidden { display: none !important; }\n\n        @media (max-width: 370px) {\n            .status-card { grid-template-columns: 1fr; text-align: center; place-items: center; }\n            .power-orb { width: 80px; height: 80px; }\n        }\n    </style>\n</head>\n<body>\n<div class=\"app-shell\">\n\n    <!-- Topbar -->\n    <div class=\"topbar\">\n        <div class=\"brand\">\n            <div class=\"brand-logo-wrap\">\n                <img class=\"brand-logo\" id=\"logo-img\" alt=\"\">\n                <div class=\"brand-logo-fallback\" id=\"logo-fallback\">BK</div>\n            </div>\n            <div>\n                <div class=\"brand-title\" id=\"app-name\">BK VPN</div>\n                <div class=\"brand-sub\" id=\"app-sub\">Conexão segura</div>\n            </div>\n        </div>\n        <div style=\"display:flex;gap:8px\">\n            <button class=\"icon-btn\" id=\"btn-update\" title=\"Atualizar\"><i class=\"bi bi-arrow-repeat\"></i></button>\n            <button class=\"icon-btn\" id=\"btn-menu\" title=\"Menu\"><i class=\"bi bi-list\"></i></button>\n        </div>\n    </div>\n\n    <!-- Status -->\n    <section class=\"status-card\" id=\"status-card\">\n        <div class=\"power-orb\">\n            <div class=\"power-icon\" id=\"power-icon\"></div>\n        </div>\n        <div>\n            <div class=\"eyebrow\">Status</div>\n            <div class=\"status-label\" id=\"status-label\">PRONTO</div>\n            <div class=\"status-mini\">\n                <span class=\"mini-pill\" id=\"mode-pill\">SSH</span>\n                <span class=\"mini-pill good\" id=\"auth-pill\">OK</span>\n            </div>\n        </div>\n    </section>\n\n    <!-- Botão conectar -->\n    <div class=\"connect-row\">\n        <button class=\"connect-btn\" id=\"btn-connect\">CONECTAR</button>\n    </div>\n\n    <!-- Aviso / ReleaseNotes do JSON -->\n    <div class=\"message-card\" id=\"message-card\">\n        <span class=\"msg-icon\"><i class=\"bi bi-megaphone-fill\"></i></span>\n        <div>\n            <div class=\"msg-title\">Aviso</div>\n            <div class=\"msg-text\" id=\"message-text\"></div>\n        </div>\n    </div>\n\n    <!-- Timer (tempo de conexão) -->\n    <div class=\"timer-row\" id=\"timer-row\">\n        <span class=\"timer-label\">⏱ TEMPO</span>\n        <span class=\"timer-val\" id=\"timer-val\">00:00</span>\n    </div>\n\n    <!-- Servidor selecionado -->\n    <div class=\"summary-list\">\n        <div class=\"summary-card\" id=\"select-server\">\n            <div class=\"circle\" id=\"server-flag-wrap\">\n                <i class=\"bi bi-hdd-network-fill\"></i>\n            </div>\n            <div class=\"meta\">\n                <div class=\"label\">Servidor</div>\n                <div class=\"title\" id=\"server-title\">Selecionar servidor</div>\n                <div class=\"sub\" id=\"server-sub\">Toque para escolher</div>\n            </div>\n            <span class=\"chev\"><i class=\"bi bi-chevron-right\"></i></span>\n        </div>\n\n        <div class=\"summary-card\" id=\"creds-btn\">\n            <div class=\"circle\"><i class=\"bi bi-shield-lock-fill\"></i></div>\n            <div class=\"meta\">\n                <div class=\"label\">Credenciais</div>\n                <div class=\"title\" id=\"creds-title\">Configuradas</div>\n                <div class=\"sub\" id=\"creds-sub\">Toque para ajustar</div>\n            </div>\n            <span class=\"chev\"><i class=\"bi bi-chevron-right\"></i></span>\n        </div>\n    </div>\n\n    <!-- Rodapé -->\n    <div class=\"bottom-meta\">\n        <span>v<span id=\"config-version\">1.0</span></span>\n    </div>\n\n</div><!-- /app-shell -->\n\n<!-- ── Drawer (menu) ── -->\n<div class=\"drawer-mask\" id=\"drawer-mask\"></div>\n<aside class=\"drawer\" id=\"drawer\">\n    <div class=\"drawer-head\">\n        <div>\n            <div class=\"drawer-title\">Menu</div>\n            <div class=\"brand-sub\">Ferramentas</div>\n        </div>\n        <button class=\"icon-btn\" id=\"btn-menu-close\"><i class=\"bi bi-x-lg\"></i></button>\n    </div>\n    <section class=\"side-section\">\n        <div class=\"side-title\">Ações rápidas</div>\n        <div class=\"tool-grid\">\n            <button class=\"tool-btn\" id=\"btn-logs\"><span class=\"ti\"><i class=\"bi bi-card-list\"></i></span>Logs</button>\n            <button class=\"tool-btn\" id=\"btn-drawer-update\"><span class=\"ti\"><i class=\"bi bi-arrow-repeat\"></i></span>Atualizar</button>\n        </div>\n    </section>\n</aside>\n\n<!-- ── Modal de servidores ── -->\n<div class=\"modal-mask\" id=\"modal-mask\">\n    <div class=\"modal-box\" id=\"modal-servers\">\n        <div class=\"modal-head\">\n            <div class=\"modal-title\">Servidores</div>\n            <button class=\"icon-btn modal-close\"><i class=\"bi bi-x-lg\"></i></button>\n        </div>\n        <div class=\"modal-body\" id=\"list-servers\"></div>\n    </div>\n\n    <div class=\"modal-box\" id=\"modal-logs\">\n        <div class=\"modal-head\">\n            <div class=\"modal-title\">Logs</div>\n            <button class=\"icon-btn modal-close\"><i class=\"bi bi-x-lg\"></i></button>\n        </div>\n        <div class=\"modal-body\" id=\"list-logs\" style=\"font-size:12px;color:var(--muted);line-height:1.6;white-space:pre-wrap;word-break:break-all;\"></div>\n    </div>\n</div>\n\n<!-- ── Toast ── -->\n<div class=\"toast-box\"><div class=\"toast\" id=\"toast\"></div></div>\n\n<script>\n(function () {\n    'use strict';\n\n    /* ─────────────────────────────────────────\n       BRIDGE — chama Android.metodo()\n       Todos os métodos têm fallback seguro se\n       o bridge ainda não estiver pronto.\n    ───────────────────────────────────────── */\n    var Bridge = {\n        connect:     function () { return _call('connect'); },\n        getStatus:   function () { return _call('getStatus') || 'DISCONNECTED'; },\n        getServers:  function () { return _parse(_call('getServers'), []); },\n        getSelected: function () { return _parse(_call('getSelectedServer'), {}); },\n        selectServer:function (pos) { _call('selectServer', pos); },\n        getNote:     function () { return _call('getNote') || ''; },\n        getVersion:  function () { return _call('getVersion') || ''; },\n        getLogs:     function () { return _call('getLogs') || ''; }\n    };\n\n    function _call(method, arg) {\n        try {\n            if (window.Android && typeof window.Android[method] === 'function') {\n                return arg !== undefined\n                    ? window.Android[method](arg)\n                    : window.Android[method]();\n            }\n        } catch (e) { console.warn('Bridge.' + method, e); }\n        return null;\n    }\n\n    function _parse(raw, fallback) {\n        try { return JSON.parse(raw) || fallback; } catch (e) { return fallback; }\n    }\n\n    /* ─────────────────────────────────────────\n       Estado local\n    ───────────────────────────────────────── */\n    var state = { connected: false, busy: false, startedAt: 0, timerHandle: null };\n\n    /* ─────────────────────────────────────────\n       Utilitários\n    ───────────────────────────────────────── */\n    function $(id) { return document.getElementById(id); }\n    function setText(id, v) { var el = $(id); if (el) el.textContent = String(v == null ? '' : v); }\n    function esc(s) { return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]); }); }\n\n    function toast(msg, kind) {\n        var el = $('toast'); if (!el) return;\n        el.textContent = msg;\n        el.className = 'toast show' + (kind ? ' ' + kind : '');\n        clearTimeout(el._t);\n        el._t = setTimeout(function () { el.className = 'toast'; }, 2600);\n    }\n\n    /* ─────────────────────────────────────────\n       Status VPN\n    ───────────────────────────────────────── */\n    var CONNECTED_STATES  = ['SSH_CONECTADO', 'CONNECTED', 'RUNNING'];\n    var BUSY_STATES       = ['SSH_INICIANDO', 'SSH_PARANDO', 'CONNECTING', 'STOPPING', 'STARTING'];\n\n    function applyStatus(raw) {\n        raw = String(raw || 'DISCONNECTED').toUpperCase();\n        state.connected = CONNECTED_STATES.indexOf(raw) >= 0;\n        state.busy      = BUSY_STATES.indexOf(raw) >= 0;\n\n        var label = 'PRONTO';\n        if (state.connected)                label = 'CONECTADO';\n        else if (raw === 'SSH_INICIANDO' || raw === 'CONNECTING' || raw === 'STARTING') label = 'CONECTANDO';\n        else if (raw === 'SSH_PARANDO'  || raw === 'STOPPING')  label = 'DESCONECTANDO';\n        else if (raw === 'SSH_DESCONECTADO' || raw === 'DISCONNECTED') label = 'DESCONECTADO';\n\n        setText('status-label', label);\n\n        var card = $('status-card');\n        if (card) {\n            card.classList.toggle('connected',  state.connected);\n            card.classList.toggle('connecting', state.busy);\n        }\n\n        var btn = $('btn-connect');\n        if (btn) {\n            btn.textContent = (state.connected || state.busy) ? 'DESCONECTAR' : 'CONECTAR';\n            btn.classList.toggle('stop', state.connected || state.busy);\n        }\n\n        // timer de conexão\n        if (state.connected && !state.startedAt) {\n            state.startedAt = Date.now();\n            startTimer();\n        }\n        if (!state.connected && !state.busy) {\n            state.startedAt = 0;\n            stopTimer();\n            setText('timer-val', '00:00');\n            $('timer-row') && $('timer-row').classList.remove('show');\n        }\n    }\n\n    function startTimer() {\n        stopTimer();\n        $('timer-row') && $('timer-row').classList.add('show');\n        state.timerHandle = setInterval(function () {\n            var sec = Math.floor((Date.now() - state.startedAt) / 1000);\n            var h = Math.floor(sec / 3600);\n            var m = Math.floor((sec % 3600) / 60);\n            var s = sec % 60;\n            var str = (h ? pad(h) + ':' : '') + pad(m) + ':' + pad(s);\n            setText('timer-val', str);\n        }, 1000);\n    }\n\n    function stopTimer() {\n        if (state.timerHandle) { clearInterval(state.timerHandle); state.timerHandle = null; }\n    }\n\n    function pad(n) { return String(n).padStart(2, '0'); }\n\n    /* ─────────────────────────────────────────\n       Info geral (versão, aviso)\n    ───────────────────────────────────────── */\n    function refreshInfo() {\n        var ver = Bridge.getVersion();\n        if (ver) setText('config-version', ver);\n\n        var note = Bridge.getNote();\n        var msgCard = $('message-card');\n        if (msgCard) {\n            msgCard.classList.toggle('show', !!note);\n            setText('message-text', note);\n        }\n    }\n\n    /* ─────────────────────────────────────────\n       Servidor selecionado\n    ───────────────────────────────────────── */\n    function refreshSelected() {\n        var s = Bridge.getSelected();\n        if (!s || typeof s !== 'object') return;\n\n        setText('server-title', s.Name || 'Selecionar servidor');\n        setText('server-sub', s.Info || 'Toque para escolher');\n        setText('mode-pill', s.Info || 'SSH');\n\n        // Tenta carregar a flag como imagem de assets\n        var wrap = $('server-flag-wrap');\n        if (wrap && s.Flag) {\n            var flag = String(s.Flag).replace('.png', '');\n            // O WebView acessa assets via file:///android_asset/\n            var src = 'file:///android_asset/flags/' + flag + '.png';\n            wrap.innerHTML = '<img src=\"' + esc(src) + '\" onerror=\"this.style.display=\\'none\\'\" style=\"width:100%;height:100%;object-fit:cover;border-radius:12px\">';\n        }\n    }\n\n    /* ─────────────────────────────────────────\n       Lista de servidores no modal\n    ───────────────────────────────────────── */\n    function buildServers() {\n        var root = $('list-servers'); if (!root) return;\n        root.innerHTML = '';\n\n        var servers = Bridge.getServers();\n        var selected = Bridge.getSelected();\n        var selectedPos = selected ? selected.position : -1;\n\n        if (!Array.isArray(servers) || !servers.length) {\n            root.innerHTML = '<div class=\"list-item\"><div class=\"li-main\"><div class=\"li-title\">Nenhum servidor disponível</div></div></div>';\n            return;\n        }\n\n        servers.forEach(function (s, i) {\n            var isSelected = (s.position === selectedPos || i === selectedPos);\n            var flag = String(s.Flag || s.flag || '').replace('.png', '');\n            var flagSrc = flag ? 'file:///android_asset/flags/' + flag + '.png' : '';\n\n            var el = document.createElement('div');\n            el.className = 'list-item' + (isSelected ? ' selected' : '');\n            el.innerHTML =\n                '<div class=\"li-icon\">' +\n                    (flagSrc ? '<img src=\"' + esc(flagSrc) + '\" onerror=\"this.style.display=\\'none\\'\">' : '<i class=\"bi bi-hdd-network-fill\"></i>') +\n                '</div>' +\n                '<div class=\"li-main\">' +\n                    '<div class=\"li-title\">' + esc(s.Name || 'Servidor') + '</div>' +\n                    '<div class=\"li-sub\">' + esc(s.Info || 'Direct') + '</div>' +\n                '</div>' +\n                '<span class=\"li-check\"><i class=\"bi bi-check-circle\"></i></span>';\n\n            el.onclick = function () {\n                if (state.connected) { toast('Desconecte antes de trocar servidor.', 'err'); return; }\n                Bridge.selectServer(s.position !== undefined ? s.position : i);\n                closeModal();\n                setTimeout(function () { refreshSelected(); refreshStatus(); }, 300);\n            };\n\n            root.appendChild(el);\n        });\n    }\n\n    /* ─────────────────────────────────────────\n       Logs\n    ───────────────────────────────────────── */\n    function buildLogs() {\n        var box = $('list-logs'); if (!box) return;\n        var logs = Bridge.getLogs();\n        box.textContent = logs || 'Nenhum log disponível.';\n        box.scrollTop = box.scrollHeight;\n    }\n\n    /* ─────────────────────────────────────────\n       Modal / Drawer\n    ───────────────────────────────────────── */\n    function openDrawer() {\n        $('drawer-mask').classList.add('show');\n        $('drawer').classList.add('show');\n    }\n    function closeDrawer() {\n        $('drawer-mask').classList.remove('show');\n        $('drawer').classList.remove('show');\n    }\n    function openModal(id) {\n        closeDrawer();\n        $('modal-mask').classList.add('show');\n        document.querySelectorAll('.modal-box').forEach(function (b) { b.classList.remove('active'); });\n        var box = $(id); if (box) box.classList.add('active');\n    }\n    function closeModal() {\n        $('modal-mask').classList.remove('show');\n        document.querySelectorAll('.modal-box').forEach(function (b) { b.classList.remove('active'); });\n    }\n\n    /* ─────────────────────────────────────────\n       Polling de status\n    ───────────────────────────────────────── */\n    function refreshStatus() {\n        applyStatus(Bridge.getStatus());\n    }\n\n    /* ─────────────────────────────────────────\n       Callbacks chamados pelo Java via\n       webView.evaluateJavascript(...)\n    ───────────────────────────────────────── */\n\n    // Java chama: onVpnStatus('SSH_CONECTADO')\n    window.onVpnStatus = function (raw) { applyStatus(raw); };\n\n    // Java chama: onServerChanged()  depois de selectServer()\n    window.onServerChanged = function () { refreshSelected(); };\n\n    // Java chama: onConfigUpdated()  depois de baixar novo JSON\n    window.onConfigUpdated = function () { refreshInfo(); refreshSelected(); toast('Configuração atualizada', 'ok'); };\n\n    /* ─────────────────────────────────────────\n       Bind de eventos\n    ───────────────────────────────────────── */\n    function bind() {\n        $('btn-menu').onclick       = openDrawer;\n        $('btn-menu-close').onclick = closeDrawer;\n        $('drawer-mask').onclick    = closeDrawer;\n\n        document.querySelectorAll('.modal-close').forEach(function (b) { b.onclick = closeModal; });\n        $('modal-mask').addEventListener('click', function (e) { if (e.target === $('modal-mask')) closeModal(); });\n\n        $('btn-connect').onclick = function () {\n            Bridge.connect();\n            // otimismo: muda pra conectando imediatamente, o polling corrige se necessário\n            if (!state.connected && !state.busy) applyStatus('SSH_INICIANDO');\n            else applyStatus('SSH_PARANDO');\n        };\n\n        $('select-server').onclick = function () { buildServers(); openModal('modal-servers'); };\n\n        $('creds-btn').onclick = function () {\n            // Abre a tela de credenciais nativa (ServersActivity)\n            if (window.Android && typeof window.Android.openServers === 'function') {\n                window.Android.openServers();\n            } else {\n                toast('Abra a tela de servidores para ajustar credenciais.', '');\n            }\n        };\n\n        var updateFn = function () {\n            toast('Verificando atualização...', '');\n            if (window.Android && typeof window.Android.checkUpdate === 'function') {\n                window.Android.checkUpdate();\n            }\n            closeDrawer();\n        };\n        $('btn-update').onclick        = updateFn;\n        $('btn-drawer-update').onclick = updateFn;\n\n        $('btn-logs').onclick = function () { buildLogs(); openModal('modal-logs'); closeDrawer(); };\n    }\n\n    /* ─────────────────────────────────────────\n       Boot\n    ───────────────────────────────────────── */\n    function boot() {\n        bind();\n        refreshInfo();\n        refreshSelected();\n        refreshStatus();\n\n        // Polling a cada 1.5s pra manter status sincronizado\n        setInterval(refreshStatus, 1500);\n        // Atualiza info a cada 10s\n        setInterval(refreshInfo, 10000);\n    }\n\n    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);\n    else boot();\n\n})();\n</script>\n</body>\n</html>\n@"
}
