lti') ? A.getMultiServers() : A.getServers();\n  var arr = [];\n  try { arr = JSON.parse(raw); } catch(e){}\n  \n  var selRaw = (type === 'multi') ? A.getSelectedMultiServer() : A.getSelectedServer();\n  var selObj = {};\n  try { selObj = JSON.parse(selRaw); } catch(e){}\n  \n  if(arr.length === 0) {\n    container.innerHTML = '<div style=\"color:var(--muted);text-align:center;padding:20px;font-size:13px;\">Nenhum servidor disponível.</div>';\n    return;\n  }\n  \n  arr.forEach(function(s) {\n    var isSel = (s.position === selObj.position);\n    var div = document.createElement('div');\n    div.className = isSel ? 'server-item selected' : 'server-item';\n    div.style.cursor = 'pointer';\n    \n    var flagHtml = '<i class=\"fa-solid fa-globe\" style=\"color:var(--muted);\"></i>';\n    if (s.FlagUrl) {\n      flagHtml = '<img src=\"' + s.FlagUrl + '\">';\n    } else if (s.Flag) {\n      flagHtml = '<i class=\"fa-solid fa-flag-usa\"></i>';\n    }\n    \n    div.innerHTML = \n      '<div class=\"s-left\">' +\n        '<div class=\"s-flag\">' + flagHtml + '</div>' +\n        '<div class=\"s-details\">' +\n          '<div class=\"s-name\">' + s.Name + '</div>' +\n          '<div class=\"s-info\">' + s.Info + '</div>' +\n        '</div>' +\n      '</div>' +\n      '<div class=\"s-radio\"></div>';\n      \n    div.onclick = function() {\n      if(type === 'multi') {\n        A.selectMultiServer(s.position);\n      } else {\n        A.selectServer(s.position);\n      }\n      closeModal();\n    };\n    container.appendChild(div);\n  });\n}\n\nfunction openCredsModal() {\n  var raw = A.getSavedCredentials();\n  var obj = {}; try{obj=JSON.parse(raw);}catch(e){}\n  $('input-user').value = obj.sshUser || '';\n  $('input-pass').value = obj.sshPass || '';\n  $('input-udp').value  = obj.udpToken || '';\n  $('input-v2ray').value = obj.v2uuid || '';\n  \n  var selRaw = A.getSelectedServer();\n  var s = {}; try{s=JSON.parse(selRaw);}catch(e){}\n  var info = (s.Info || '').toUpperCase();\n  \n  $('group-udp').style.display   = (info.indexOf('UDP')!==-1) ? 'block' : 'none';\n  $('group-v2ray').style.display = (info.indexOf('V2RAY')!==-1 || info.indexOf('CHORE')!==-1) ? 'block' : 'none';\n  \n  openModal('modal-creds');\n}\n\nfunction renderLogs() {\n  var c = $('log-container'); if(!c) return;\n  var raw = A.getLogs();\n  var arr = []; try{arr=JSON.parse(raw);}catch(e){}\n  if(arr.length===0){\n    c.innerHTML = '<div style=\"color:var(--muted);font-size:12px;padding:8px\">Nenhum log disponível.</div>';\n    return;\n  }\n  c.innerHTML = '';\n  arr.forEach(function(l){\n    var d = document.createElement('div');\n    d.className = 'log-line ' + (l.level || 'INFO');\n    d.textContent = '[' + (l.time || '') + '] ' + (l.message || '');\n    c.appendChild(d);\n  });\n  c.scrollTop = c.scrollHeight;\n}\n\nfunction updateStatusUI() {\n  var st = A.getStatus();\n  var card = $('card-status');\n  var txt = $('txt-status');\n  var iconBox = $('box-status-icon');\n  var btn = $('btn-connect-action');\n  var btnTxt = $('txt-btn-connect');\n  \n  card.className = 'status-card';\n  btn.className = 'btn-connect';\n  \n  if(st==='CONECTADO'){\n    card.classList.add('connected');\n    btn.classList.add('connected');\n    txt.textContent = 'CONECTADO';\n    txt.style.color = 'var(--green)';\n    btnTxt.textContent = 'DESCONECTAR';\n    iconBox.innerHTML = '<i class=\"fa-solid fa-shield-checkmark\"></i>';\n  } else if(st==='CONECTANDO'||st==='INICIANDO'||st==='AUTENTICANDO'||st==='RECONECTANDO'){\n    card.classList.add('connecting');\n    btn.classList.add('connecting');\n    txt.textContent = st;\n    txt.style.color = 'var(--yellow)';\n    btnTxt.textContent = 'PARAR';\n    iconBox.innerHTML = '<i class=\"fa-solid fa-circle-notch fa-spin\"></i>';\n  } else {\n    txt.textContent = st;\n    txt.style.color = 'var(--muted)';\n    btnTxt.textContent = 'CONECTAR';\n    iconBox.innerHTML = '<i class=\"fa-solid fa-shield-halved\"></i>';\n  }\n}\n\nfunction syncServerUI() {\n  var raw = A.getSelectedServer();\n  var s = {}; try{s=JSON.parse(raw);}catch(e){}\n  if(s.Name){\n    $('txt-srv-name').textContent = s.Name;\n    $('txt-srv-info').textContent = s.Info || 'Direct';\n    $('txt-srv-type').textContent = (s.Info || 'Direct').toUpperCase();\n    if(s.FlagUrl){\n      $('server-flag-img').src = s.FlagUrl;\n      $('server-flag-img').style.display = 'block';\n      $('server-flag-def').style.display = 'none';\n    }else{\n      $('server-flag-img').style.display = 'none';\n      $('server-flag-def').style.display = 'block';\n    }\n    var info = (s.Info || '').toUpperCase();\n    var isMulti = (info.indexOf('MULTI') !== -1);\n    $('btn-select-multiserver').style.display = isMulti ? 'flex' : 'none';\n    if(isMulti) syncMultiServerUI();\n  }\n}\n\nfunction syncMultiServerUI() {\n  var raw = A.getSelectedMultiServer();\n  var s = {}; try{s=JSON.parse(raw);}catch(e){}\n  if(s.Name){\n    $('txt-multi-name').textContent = s.Name;\n    $('txt-multi-info').textContent = s.Info || 'Premium';\n    if(s.FlagUrl){\n      $('multi-flag-img').src = s.FlagUrl;\n      $('multi-flag-img').style.display = 'block';\n      $('multi-flag-def').style.display = 'none';\n    }else{\n      $('multi-flag-img').style.display = 'none';\n      $('multi-flag-def').style.display = 'block';\n    }\n  }\n}\n\nwindow.onServerChanged = function() {\n  syncServerUI();\n  toast('Configuração alterada.', '');\n};\n\nwindow.onLogsCleared = function() {\n  renderLogs();\n};\n\nfunction formatTime(ms) {\n  if(ms<=0) return \"00:00:00\";\n  var sec = Math.floor(ms / 1000);\n  var hr = Math.floor(sec / 3600); sec %= 3600;\n  var min = Math.floor(sec / 60); sec %= 60;\n  if(hr<10) hr='0'+hr; if(min<10) min='0'+min; if(sec<10) sec='0'+sec;\n  return hr + ':' + min + ':' + sec;\n}\n\nfunction initTimer() {\n  var lastLeft = A.getTimeLeft();\n  $('txt-time-left').textContent = formatTime(lastLeft);\n  setInterval(function(){\n    var left = A.getTimeLeft();\n    $('txt-time-left').textContent = formatTime(left);\n    var btnAd = $('btn-watch-ad');\n    if(btnAd && btnAd.disabled && left > lastLeft) {\n      btnAd.textContent = '＋ GANHAR TEMPO';\n      btnAd.disabled = false;\n      toast('Tempo adicionado com sucesso!', '');\n    }\n    lastLeft = left;\n  }, 1000);\n}\n\nfunction bind() {\n  $('btn-top-servers').onclick = function () { buildServerList('normal'); openModal('modal-servers'); };\n  $('btn-top-logs').onclick    = function () { renderLogs(); openModal('modal-logs'); };\n  $('btn-select-server').onclick = function () { buildServerList('normal'); openModal('modal-servers'); };\n  $('btn-select-multiserver').onclick = function () { buildServerList('multi'); openModal('modal-servers'); };\n  \n  $('btn-connect-action').onclick = function () { A.connect(); };\n  \n  $('btn-save-creds').onclick = function () {\n    var u = $('input-user').value.trim();\n    var p = $('input-pass').value.trim();\n    var udp = $('input-udp').value.trim();\n    var v2  = $('input-v2ray').value.trim();\n    A.saveCredentials(u, p, udp, v2);\n    closeModal();\n    toast('Configurações salvas.', '');\n  };\n\n  $('nav-home').onclick = function () {\n    document.querySelectorAll('.nav-item').forEach(function(n){n.classList.remove('active');});\n    $('nav-home').classList.add('active');\n    closeModal();\n  };\n  $('nav-servers-bottom').onclick = function () {\n    document.querySelectorAll('.nav-item').forEach(function(n){n.classList.remove('active');});\n    $('nav-servers-bottom').classList.add('active');\n    buildServerList('normal');\n    openModal('modal-servers');\n  };\n  $('nav-tools-bottom').onclick = function () {\n    document.querySelectorAll('.nav-item').forEach(function(n){n.classList.remove('active');});\n    $('nav-tools-bottom').classList.add('active');\n    openModal('modal-tools');\n  };\n  $('nav-logs-bottom').onclick = function () {\n    document.querySelectorAll('.nav-item').forEach(function(n){n.classList.remove('active');});\n    $('nav-logs-bottom').classList.add('active');\n    renderLogs();\n    openModal('modal-logs');\n  };\n\n  $('tool-update').onclick  = function () { toast('Verificando atualização...', ''); A.checkUpdate(); };\n  $('tool-servers').onclick = function () { buildServerList('normal'); openModal('modal-servers'); };\n  \n  /* INVOCAÇÃO DO CHAT VIA WEBAPPBRIDGE */\n  $('tool-chat-room').onclick = function () { \n    closeModal(); \n    A.openChat(); \n  };\n  \n  $('tool-logs').onclick    = function () { renderLogs(); openModal('modal-logs'); };\n\n  $('btn-refresh-logs').onclick = function () { renderLogs(); };\n  $('btn-clear-logs').onclick   = function () {\n    A.clearLogs();\n    var c = $('log-container'); if (c) c.innerHTML = '<div style=\"color:var(--muted);font-size:12px;padding:8px\">Log limpo.</div>';\n    toast('Log limpo.', '');\n  };\n\n  document.querySelectorAll('.modal-close').forEach(function (b) { b.onclick = closeModal; });\n  $('modal-mask').onclick = function (e) { if (e.target === $('modal-mask')) closeModal(); };\n\n  var btnAd = $('btn-watch-ad');\n  if (btnAd) btnAd.onclick = function () { btnAd.textContent = '⏳ Carregando...'; btnAd.disabled = true; A.watchAd(); };\n}\n\nfunction boot() {\n  bind();\n  initTime_left_counter_if_needed = function(){};\n  initTimer();\n  updateStatusUI();\n  syncServerUI();\n  var note = A.getNote(); if(note) $('txt-dev-note').innerHTML = note;\n  \n  setInterval(updateStatusUI, 1000);\n  \n  var rx = 0, tx = 0;\n  setInterval(function(){\n    rx += Math.floor(Math.random()*500);\n    tx += Math.floor(Math.random()*100);\n    $('txt-download').textContent = (rx/1024).toFixed(2) + ' KB';\n    $('txt-upload').textContent = (tx/1024).toFixed(2) + ' KB';\n  }, 1500);\n}\n\nwindow.onload = boot;\n</script>\n</body>\n</html>\n@"}
