    "HtmlUI": "@<!DOCTYPE html>\n<html lang=\"pt-BR\" data-theme=\"dark\">\n<head>\n<meta charset=\"UTF-8\"\/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\/>\n<title>Yumeko BK — Dashboard<\/title>\n<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Orbitron:wght@400;700;900&family=Noto+Sans+JP:wght@300;400;700&family=Rajdhani:wght@300;400;600;700&display=swap\" rel=\"stylesheet\"\/>\n<link href=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/font-awesome\/6.5.0\/css\/all.min.css\" rel=\"stylesheet\"\/>\n<style>\n\/* ═══════════════════════════════════════════════════\n   YUMEKO BK — CORE VARIABLES & THEMES\n═══════════════════════════════════════════════════ *\/\n:root {\n  --crimson:      #e01b3c;\n  --crimson-deep: #a0102a;\n  --crimson-glow: rgba(224,27,60,0.45);\n  --sakura:       #ff6b8a;\n  --sakura-light: #ffc2ce;\n  --ivory:        #f5f0eb;\n  --white:        #ffffff;\n  --gold:         #ffd166;\n  --cyan-edge:    #00f5ff;\n  --purple-neon:  #b829ff;\n  --glass:        rgba(255,255,255,0.07);\n  --glass-border: rgba(255,255,255,0.13);\n  --glass-hover:  rgba(255,255,255,0.12);\n  --bg-primary:   #0a0608;\n  --bg-secondary: #110a0d;\n  --bg-card:      rgba(20,8,12,0.85);\n  --text-primary: #f5f0eb;\n  --text-muted:   rgba(245,240,235,0.55);\n  --text-dim:     rgba(245,240,235,0.3);\n  --shadow-red:   0 0 40px rgba(224,27,60,0.3);\n  --shadow-glass: 0 8px 32px rgba(0,0,0,0.5);\n  --radius-lg:    18px;\n  --radius-md:    12px;\n  --radius-sm:    8px;\n  --font-title:   'Orbitron', monospace;\n  --font-body:    'Rajdhani', sans-serif;\n  --font-jp:      'Noto Sans JP', sans-serif;\n  --transition:   all 0.3s cubic-bezier(0.4,0,0.2,1);\n}\n[data-theme=\"light\"] {\n  --bg-primary:   #fdf0f2;\n  --bg-secondary: #f5e6ea;\n  --bg-card:      rgba(255,250,252,0.9);\n  --glass:        rgba(255,255,255,0.6);\n  --glass-border: rgba(200,100,120,0.25);\n  --glass-hover:  rgba(255,255,255,0.8);\n  --text-primary: #1a0508;\n  --text-muted:   rgba(26,5,8,0.6);\n  --text-dim:     rgba(26,5,8,0.35);\n  --shadow-red:   0 0 40px rgba(224,27,60,0.15);\n  --shadow-glass: 0 8px 32px rgba(100,0,20,0.12);\n}\n[data-theme=\"sakura\"] {\n  --bg-primary:   #1a0a12;\n  --bg-secondary: #230e18;\n  --crimson:      #ff6b8a;\n  --crimson-glow: rgba(255,107,138,0.4);\n  --gold:         #ff9ed2;\n  --cyan-edge:    #ff6bc8;\n}\n[data-theme=\"cyber\"] {\n  --bg-primary:   #000d1a;\n  --bg-secondary: #001428;\n  --crimson:      #00f5ff;\n  --crimson-deep: #007a8a;\n  --crimson-glow: rgba(0,245,255,0.4);\n  --sakura:       #b829ff;\n  --gold:         #00f5ff;\n  --shadow-red:   0 0 40px rgba(0,245,255,0.3);\n}\n[data-theme=\"obsidian\"] {\n  --bg-primary:   #050505;\n  --bg-secondary: #0a0a0a;\n  --crimson:      #c0c0c0;\n  --crimson-deep: #808080;\n  --crimson-glow: rgba(192,192,192,0.3);\n  --sakura:       #e0e0e0;\n  --gold:         #ffffff;\n}\n\n\/* ═══════════════════════════════════════════════════\n   RESET & BASE\n═══════════════════════════════════════════════════ *\/\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\nhtml { scroll-behavior: smooth; }\nbody {\n  font-family: var(--font-body);\n  background: var(--bg-primary);\n  color: var(--text-primary);\n  min-height: 100vh;\n  overflow-x: hidden;\n  position: relative;\n}\n\n\/* Animated BG *\/\nbody::before {\n  content: '';\n  position: fixed; inset: 0; z-index: 0;\n  background:\n    radial-gradient(ellipse 60% 50% at 20% 20%, rgba(224,27,60,0.12) 0%, transparent 70%),\n    radial-gradient(ellipse 40% 60% at 80% 80%, rgba(184,41,255,0.07) 0%, transparent 70%),\n    radial-gradient(ellipse 30% 40% at 60% 10%, rgba(0,245,255,0.05) 0%, transparent 60%);\n  pointer-events: none;\n  animation: bgPulse 8s ease-in-out infinite alternate;\n}\n@keyframes bgPulse {\n  0%  { opacity: 0.7; transform: scale(1); }\n  100%{ opacity: 1;   transform: scale(1.05); }\n}\n\n\/* Floating particles *\/\n.particles { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }\n.particle {\n  position: absolute;\n  width: 2px; height: 2px;\n  background: var(--crimson);\n  border-radius: 50%;\n  animation: floatUp linear infinite;\n  opacity: 0;\n}\n@keyframes floatUp {\n  0%   { transform: translateY(100vh) scale(0); opacity: 0; }\n  10%  { opacity: 0.6; }\n  90%  { opacity: 0.3; }\n  100% { transform: translateY(-10vh) scale(1.5); opacity: 0; }\n}\n\n\/* ═══════════════════════════════════════════════════\n   GLASS UTILITY\n═══════════════════════════════════════════════════ *\/\n.glass {\n  background: var(--glass);\n  backdrop-filter: blur(20px) saturate(1.4);\n  -webkit-backdrop-filter: blur(20px) saturate(1.4);\n  border: 1px solid var(--glass-border);\n  border-radius: var(--radius-lg);\n  box-shadow: var(--shadow-glass);\n}\n.glass-sm {\n  background: var(--glass);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  border: 1px solid var(--glass-border);\n  border-radius: var(--radius-md);\n}\n\n\/* ═══════════════════════════════════════════════════\n   SCROLLBAR\n═══════════════════════════════════════════════════ *\/\n::-webkit-scrollbar { width: 5px; }\n::-webkit-scrollbar-track { background: transparent; }\n::-webkit-scrollbar-thumb { background: var(--crimson); border-radius: 99px; }\n\n\/* ═══════════════════════════════════════════════════\n   LAYOUT\n═══════════════════════════════════════════════════ *\/\n.app-wrapper {\n  position: relative; z-index: 1;\n  display: grid;\n  grid-template-rows: auto 1fr auto;\n  min-height: 100vh;\n  max-width: 1400px;\n  margin: 0 auto;\n  padding: 0 16px;\n}\n\n\/* ═══════════════════════════════════════════════════\n   HEADER\n═══════════════════════════════════════════════════ *\/\n.app-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 16px 0;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n.logo-block {\n  display: flex; align-items: center; gap: 14px;\n}\n.logo-icon {\n  width: 52px; height: 52px;\n  background: linear-gradient(135deg, var(--crimson), var(--crimson-deep));\n  border-radius: 14px;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 1.5rem;\n  box-shadow: 0 0 20px var(--crimson-glow), inset 0 1px 0 rgba(255,255,255,0.2);\n  position: relative;\n  overflow: hidden;\n  flex-shrink: 0;\n}\n.logo-icon::after {\n  content: '';\n  position: absolute; inset: 0;\n  background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 60%);\n}\n.logo-text { display: flex; flex-direction: column; }\n.logo-name {\n  font-family: var(--font-title);\n  font-size: 1.4rem;\n  font-weight: 900;\n  letter-spacing: 0.05em;\n  background: linear-gradient(90deg, var(--white) 0%, var(--sakura) 50%, var(--crimson) 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  text-shadow: none;\n  line-height: 1;\n}\n.logo-sub {\n  font-family: var(--font-jp);\n  font-size: 0.65rem;\n  color: var(--text-muted);\n  letter-spacing: 0.2em;\n  margin-top: 2px;\n  text-transform: uppercase;\n}\n.header-right {\n  display: flex; align-items: center; gap: 10px;\n  flex-wrap: wrap;\n}\n.clock-block {\n  display: flex; flex-direction: column; align-items: flex-end;\n}\n#clock-time {\n  font-family: var(--font-title);\n  font-size: 1.1rem;\n  color: var(--crimson);\n  letter-spacing: 0.08em;\n  text-shadow: 0 0 12px var(--crimson-glow);\n}\n#clock-date {\n  font-size: 0.7rem;\n  color: var(--text-muted);\n  font-family: var(--font-jp);\n}\n.header-btns { display: flex; align-items: center; gap: 8px; }\n.icon-btn {\n  width: 38px; height: 38px;\n  background: var(--glass);\n  backdrop-filter: blur(12px);\n  border: 1px solid var(--glass-border);\n  border-radius: var(--radius-sm);\n  color: var(--text-primary);\n  display: flex; align-items: center; justify-content: center;\n  cursor: pointer;\n  font-size: 0.9rem;\n  transition: var(--transition);\n  position: relative;\n}\n.icon-btn:hover {\n  background: var(--crimson);\n  border-color: var(--crimson);\n  box-shadow: 0 0 16px var(--crimson-glow);\n  transform: translateY(-1px);\n  color: white;\n}\n.notification-dot {\n  position: absolute; top: 6px; right: 6px;\n  width: 7px; height: 7px;\n  background: var(--crimson);\n  border-radius: 50%;\n  animation: pulse 1.5s ease-in-out infinite;\n}\n\n\/* ═══════════════════════════════════════════════════\n   VERSION BADGES\n═══════════════════════════════════════════════════ *\/\n.version-badges {\n  display: flex; gap: 8px; flex-wrap: wrap; align-items: center;\n}\n.badge {\n  padding: 3px 10px;\n  border-radius: 99px;\n  font-size: 0.68rem;\n  font-family: var(--font-title);\n  letter-spacing: 0.05em;\n  font-weight: 700;\n  border: 1px solid;\n}\n.badge-app  { color: var(--crimson); border-color: var(--crimson); background: rgba(224,27,60,0.1); }\n.badge-json { color: var(--gold);    border-color: var(--gold);    background: rgba(255,209,102,0.1); }\n.badge-live { color: #4ade80;        border-color: #4ade80;        background: rgba(74,222,128,0.1);\n              animation: pulseBadge 2s infinite; }\n@keyframes pulseBadge { 0%,100%{opacity:1} 50%{opacity:.6} }\n\n\/* ═══════════════════════════════════════════════════\n   NAV TABS\n═══════════════════════════════════════════════════ *\/\n.nav-tabs {\n  display: flex; gap: 6px;\n  padding: 6px;\n  background: var(--glass);\n  backdrop-filter: blur(20px);\n  border: 1px solid var(--glass-border);\n  border-radius: var(--radius-lg);\n  margin-bottom: 20px;\n  overflow-x: auto;\n  scrollbar-width: none;\n  flex-wrap: wrap;\n}\n.nav-tabs::-webkit-scrollbar { display: none; }\n.nav-tab {\n  display: flex; align-items: center; gap: 7px;\n  padding: 9px 18px;\n  border-radius: var(--radius-md);\n  border: none;\n  background: transparent;\n  color: var(--text-muted);\n  font-family: var(--font-body);\n  font-size: 0.88rem;\n  font-weight: 600;\n  letter-spacing: 0.03em;\n  cursor: pointer;\n  transition: var(--transition);\n  white-space: nowrap;\n}\n.nav-tab:hover { color: var(--text-primary); background: var(--glass-hover); }\n.nav-tab.active {\n  background: linear-gradient(135deg, var(--crimson), var(--crimson-deep));\n  color: white;\n  box-shadow: 0 0 20px var(--crimson-glow);\n}\n.tab-panel { display: none; }\n.tab-panel.active { display: block; animation: fadeIn 0.4s ease; }\n@keyframes fadeIn { from{opacity:0; transform:translateY(8px)} to{opacity:1; transform:translateY(0)} }\n\n\/* ═══════════════════════════════════════════════════\n   CONNECT SECTION — HERO\n═══════════════════════════════════════════════════ *\/\n.connect-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 16px;\n  margin-bottom: 16px;\n}\n@media(max-width:768px){ .connect-grid { grid-template-columns: 1fr; } }\n\n.connect-hero {\n  grid-column: 1 \/ -1;\n  padding: 36px 32px;\n  text-align: center;\n  position: relative;\n  overflow: hidden;\n}\n.connect-hero::before {\n  content: '';\n  position: absolute; inset: 0;\n  background: radial-gradient(ellipse 80% 60% at 50% 50%, rgba(224,27,60,0.12) 0%, transparent 70%);\n  pointer-events: none;\n}\n\n\/* Status Ring *\/\n.status-ring-wrap {\n  display: flex; justify-content: center; margin-bottom: 28px;\n  position: relative;\n}\n.status-ring {\n  width: 180px; height: 180px;\n  position: relative;\n  display: flex; align-items: center; justify-content: center;\n}\n.ring-svg {\n  position: absolute; inset: 0;\n  animation: rotateSvg 4s linear infinite;\n}\n@keyframes rotateSvg { to { transform: rotate(360deg); } }\n.ring-inner {\n  width: 130px; height: 130px;\n  background: var(--bg-card);\n  border-radius: 50%;\n  display: flex; flex-direction: column;\n  align-items: center; justify-content: center;\n  gap: 4px;\n  border: 1px solid var(--glass-border);\n  box-shadow: inset 0 0 30px rgba(0,0,0,0.5);\n  z-index: 1;\n}\n.ring-status-icon { font-size: 2rem; }\n.ring-status-text {\n  font-family: var(--font-title);\n  font-size: 0.65rem;\n  letter-spacing: 0.15em;\n  text-transform: uppercase;\n}\n\n\/* THE CONNECT BUTTON *\/\n.btn-connect-wrap { position: relative; display: inline-block; }\n.btn-connect-glow {\n  position: absolute; inset: -12px;\n  border-radius: 999px;\n  background: radial-gradient(ellipse, var(--crimson-glow) 0%, transparent 70%);\n  animation: glowPulse 2s ease-in-out infinite;\n  pointer-events: none;\n}\n@keyframes glowPulse {\n  0%,100%{ opacity: 0.6; transform: scale(1); }\n  50%    { opacity: 1;   transform: scale(1.1); }\n}\n.btn-connect {\n  position: relative;\n  padding: 18px 56px;\n  border-radius: 999px;\n  border: none;\n  font-family: var(--font-title);\n  font-size: 1rem;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  cursor: pointer;\n  overflow: hidden;\n  transition: all 0.35s cubic-bezier(0.4,0,0.2,1);\n  background: linear-gradient(135deg, var(--crimson) 0%, #ff0040 50%, var(--crimson-deep) 100%);\n  color: white;\n  box-shadow:\n    0 0 30px var(--crimson-glow),\n    0 4px 20px rgba(0,0,0,0.4),\n    inset 0 1px 0 rgba(255,255,255,0.25);\n}\n.btn-connect::before {\n  content: '';\n  position: absolute; top: 0; left: -100%;\n  width: 60%; height: 100%;\n  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);\n  transition: left 0.5s ease;\n}\n.btn-connect:hover::before { left: 150%; }\n.btn-connect:hover {\n  transform: translateY(-3px) scale(1.04);\n  box-shadow: 0 0 50px var(--crimson-glow), 0 8px 30px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.3);\n}\n.btn-connect:active { transform: translateY(0) scale(0.98); }\n.btn-connect.connected {\n  background: linear-gradient(135deg, #0a6e3a, #10b981);\n  box-shadow: 0 0 30px rgba(16,185,129,0.4), 0 4px 20px rgba(0,0,0,0.4);\n}\n.btn-connect.connecting {\n  background: linear-gradient(135deg, #92400e, var(--gold));\n  animation: connectingAnim 0.8s ease-in-out infinite alternate;\n}\n@keyframes connectingAnim {\n  from { box-shadow: 0 0 20px rgba(255,209,102,0.3); }\n  to   { box-shadow: 0 0 50px rgba(255,209,102,0.7); }\n}\n.btn-connect-icon { margin-right: 10px; }\n.btn-connect-label { display: inline; }\n\n\/* Status badges row *\/\n.status-badges {\n  display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;\n  margin-top: 20px;\n}\n.status-chip {\n  display: flex; align-items: center; gap: 6px;\n  padding: 6px 14px;\n  border-radius: 99px;\n  font-size: 0.78rem;\n  font-weight: 600;\n  background: var(--glass);\n  backdrop-filter: blur(8px);\n  border: 1px solid var(--glass-border);\n  transition: var(--transition);\n}\n.status-chip .dot {\n  width: 8px; height: 8px;\n  border-radius: 50%;\n}\n.dot-green  { background: #4ade80; box-shadow: 0 0 6px #4ade80; animation: pulse 2s infinite; }\n.dot-red    { background: var(--crimson); box-shadow: 0 0 6px var(--crimson); animation: pulse 2s infinite; }\n.dot-yellow { background: var(--gold); box-shadow: 0 0 6px var(--gold); animation: pulse 2s infinite; }\n.dot-grey   { background: #666; }\n@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }\n\n\/* ═══════════════════════════════════════════════════\n   STAT CARDS\n═══════════════════════════════════════════════════ *\/\n.stat-card {\n  padding: 20px;\n  position: relative;\n  overflow: hidden;\n  transition: var(--transition);\n}\n.stat-card:hover {\n  transform: translateY(-3px);\n  border-color: var(--crimson);\n  box-shadow: var(--shadow-red), var(--shadow-glass);\n}\n.stat-card::after {\n  content: '';\n  position: absolute; inset: 0;\n  background: linear-gradient(135deg, rgba(255,255,255,0.04) 0%, transparent 50%);\n  pointer-events: none;\n}\n.stat-icon {\n  width: 44px; height: 44px;\n  border-radius: 12px;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 1.2rem;\n  margin-bottom: 12px;\n}\n.stat-icon-red    { background: rgba(224,27,60,0.15); color: var(--crimson); }\n.stat-icon-gold   { background: rgba(255,209,102,0.15); color: var(--gold); }\n.stat-icon-cyan   { background: rgba(0,245,255,0.1); color: var(--cyan-edge); }\n.stat-icon-purple { background: rgba(184,41,255,0.1); color: var(--purple-neon); }\n.stat-icon-green  { background: rgba(74,222,128,0.1); color: #4ade80; }\n.stat-label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 4px; }\n.stat-value {\n  font-family: var(--font-title);\n  font-size: 1.5rem;\n  font-weight: 700;\n  color: var(--text-primary);\n  line-height: 1;\n}\n.stat-sub { font-size: 0.72rem; color: var(--text-dim); margin-top: 4px; }\n\n\/* ═══════════════════════════════════════════════════\n   SERVERS LIST\n═══════════════════════════════════════════════════ *\/\n.server-list { display: flex; flex-direction: column; gap: 10px; }\n.server-item {\n  display: flex; align-items: center; gap: 14px;\n  padding: 14px 18px;\n  border-radius: var(--radius-md);\n  background: var(--glass);\n  backdrop-filter: blur(12px);\n  border: 1px solid var(--glass-border);\n  cursor: pointer;\n  transition: var(--transition);\n  position: relative;\n  overflow: hidden;\n}\n.server-item::before {\n  content: '';\n  position: absolute; left: 0; top: 0; bottom: 0; width: 3px;\n  background: var(--crimson);\n  transform: scaleY(0);\n  transition: transform 0.3s ease;\n  border-radius: 0 2px 2px 0;\n}\n.server-item:hover { border-color: var(--crimson); background: var(--glass-hover); }\n.server-item:hover::before { transform: scaleY(1); }\n.server-item.selected { border-color: var(--crimson); background: rgba(224,27,60,0.08); }\n.server-item.selected::before { transform: scaleY(1); }\n.server-flag { font-size: 1.6rem; width: 36px; text-align: center; flex-shrink: 0; }\n.server-info { flex: 1; min-width: 0; }\n.server-name { font-weight: 700; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.server-host { font-size: 0.72rem; color: var(--text-muted); font-family: monospace; }\n.server-meta { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }\n.signal-bars { display: flex; align-items: flex-end; gap: 2px; }\n.bar {\n  width: 4px; border-radius: 1px;\n  background: var(--glass-border);\n}\n.bar:nth-child(1){ height: 8px; }\n.bar:nth-child(2){ height: 12px; }\n.bar:nth-child(3){ height: 16px; }\n.bar:nth-child(4){ height: 20px; }\n.bar.active { background: #4ade80; box-shadow: 0 0 4px #4ade80; }\n.ping-badge {\n  font-family: var(--font-title);\n  font-size: 0.68rem;\n  padding: 2px 8px;\n  border-radius: 99px;\n  font-weight: 700;\n}\n.ping-low  { color: #4ade80; background: rgba(74,222,128,0.1); border: 1px solid rgba(74,222,128,0.3); }\n.ping-mid  { color: var(--gold); background: rgba(255,209,102,0.1); border: 1px solid rgba(255,209,102,0.3); }\n.ping-high { color: var(--crimson); background: rgba(224,27,60,0.1); border: 1px solid rgba(224,27,60,0.3); }\n\n\/* ═══════════════════════════════════════════════════\n   SPEED TEST\n═══════════════════════════════════════════════════ *\/\n.speedtest-card { padding: 28px; text-align: center; }\n.gauge-wrap { display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; margin: 24px 0; }\n.gauge-item { display: flex; flex-direction: column; align-items: center; gap: 8px; }\n.gauge {\n  width: 130px; height: 130px;\n  position: relative;\n}\n.gauge-svg { transform: rotate(-90deg); }\n.gauge-track { fill: none; stroke: var(--glass-border); stroke-width: 8; }\n.gauge-fill {\n  fill: none;\n  stroke-width: 8;\n  stroke-linecap: round;\n  transition: stroke-dashoffset 1.5s cubic-bezier(0.4,0,0.2,1);\n}\n.gauge-dl .gauge-fill { stroke: url(#dlGrad); }\n.gauge-ul .gauge-fill { stroke: url(#ulGrad); }\n.gauge-center {\n  position: absolute; inset: 0;\n  display: flex; flex-direction: column;\n  align-items: center; justify-content: center;\n  gap: 2px;\n}\n.gauge-value { font-family: var(--font-title); font-size: 1.4rem; font-weight: 900; }\n.gauge-unit  { font-size: 0.65rem; color: var(--te