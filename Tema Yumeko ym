r;\n  font-size: 0.9rem;\n  transition: var(--transition);\n  box-shadow: 0 0 12px var(--crimson-glow);\n}\n.btn-send:hover { transform: scale(1.1); box-shadow: 0 0 20px var(--crimson-glow); }\n\n\/* ═══════════════════════════════════════════════════\n   SETTINGS\n═══════════════════════════════════════════════════ *\/\n.settings-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 16px;\n}\n.settings-section { padding: 22px; }\n.settings-section h4 {\n  font-family: var(--font-title);\n  font-size: 0.8rem;\n  letter-spacing: 0.1em;\n  color: var(--crimson);\n  margin-bottom: 16px;\n  padding-bottom: 8px;\n  border-bottom: 1px solid var(--glass-border);\n}\n.setting-row {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 10px 0;\n  border-bottom: 1px solid rgba(255,255,255,0.04);\n}\n.setting-row:last-child { border-bottom: none; }\n.setting-label { font-size: 0.88rem; color: var(--text-primary); }\n.setting-desc  { font-size: 0.7rem; color: var(--text-muted); margin-top: 2px; }\n\n\/* Toggle Switch *\/\n.toggle { position: relative; width: 46px; height: 24px; }\n.toggle input { opacity: 0; width: 0; height: 0; }\n.toggle-slider {\n  position: absolute; inset: 0;\n  background: rgba(255,255,255,0.1);\n  border-radius: 99px;\n  cursor: pointer;\n  transition: var(--transition);\n  border: 1px solid var(--glass-border);\n}\n.toggle-slider::before {\n  content: '';\n  position: absolute; left: 3px; top: 3px;\n  width: 16px; height: 16px;\n  background: var(--text-muted);\n  border-radius: 50%;\n  transition: var(--transition);\n}\n.toggle input:checked + .toggle-slider { background: var(--crimson); border-color: var(--crimson); box-shadow: 0 0 10px var(--crimson-glow); }\n.toggle input:checked + .toggle-slider::before { transform: translateX(22px); background: white; }\n\n\/* Theme Selector *\/\n.theme-grid { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }\n.theme-swatch {\n  width: 44px; height: 44px;\n  border-radius: 12px;\n  cursor: pointer;\n  border: 2px solid transparent;\n  transition: var(--transition);\n  position: relative;\n}\n.theme-swatch:hover, .theme-swatch.active {\n  border-color: white;\n  transform: scale(1.1);\n  box-shadow: 0 0 14px rgba(255,255,255,0.3);\n}\n.swatch-dark    { background: linear-gradient(135deg, #0a0608, #e01b3c); }\n.swatch-light   { background: linear-gradient(135deg, #fdf0f2, #e01b3c); }\n.swatch-sakura  { background: linear-gradient(135deg, #1a0a12, #ff6b8a); }\n.swatch-cyber   { background: linear-gradient(135deg, #000d1a, #00f5ff); }\n.swatch-obsidian{ background: linear-gradient(135deg, #050505, #c0c0c0); }\n\n\/* Selects & Inputs *\/\n.setting-select, .setting-input {\n  background: var(--glass);\n  border: 1px solid var(--glass-border);\n  border-radius: 8px;\n  padding: 7px 12px;\n  color: var(--text-primary);\n  font-family: var(--font-body);\n  font-size: 0.85rem;\n  outline: none;\n  cursor: pointer;\n  transition: var(--transition);\n  min-width: 120px;\n}\n.setting-select:focus, .setting-input:focus { border-color: var(--crimson); }\n.setting-select option { background: #1a0508; }\n\n\/* ═══════════════════════════════════════════════════\n   MODALS\n═══════════════════════════════════════════════════ *\/\n.modal-overlay {\n  position: fixed; inset: 0; z-index: 1000;\n  background: rgba(0,0,0,0.7);\n  backdrop-filter: blur(8px);\n  display: flex; align-items: center; justify-content: center;\n  opacity: 0; pointer-events: none;\n  transition: opacity 0.3s ease;\n  padding: 16px;\n}\n.modal-overlay.open { opacity: 1; pointer-events: all; }\n.modal {\n  width: 100%; max-width: 520px; max-height: 85vh; overflow-y: auto;\n  padding: 28px;\n  position: relative;\n  animation: modalPop 0.35s cubic-bezier(0.34,1.56,0.64,1) both;\n}\n.modal-overlay.open .modal { animation: modalPop 0.35s cubic-bezier(0.34,1.56,0.64,1) both; }\n@keyframes modalPop {\n  from{ opacity:0; transform: scale(0.85) translateY(20px); }\n  to  { opacity:1; transform: scale(1)    translateY(0); }\n}\n.modal-header {\n  display: flex; align-items: center; justify-content: space-between;\n  margin-bottom: 22px;\n}\n.modal-title { font-family: var(--font-title); font-size: 1rem; letter-spacing: 0.06em; }\n.modal-close {\n  width: 32px; height: 32px; border-radius: 8px;\n  background: var(--glass); border: 1px solid var(--glass-border);\n  color: var(--text-muted); cursor: pointer; font-size: 0.85rem;\n  display: flex; align-items: center; justify-content: center;\n  transition: var(--transition);\n}\n.modal-close:hover { background: var(--crimson); color: white; border-color: var(--crimson); }\n\n\/* ═══════════════════════════════════════════════════\n   SECTION HEADERS\n═══════════════════════════════════════════════════ *\/\n.section-header {\n  display: flex; align-items: center; justify-content: space-between;\n  margin-bottom: 14px; flex-wrap: wrap; gap: 8px;\n}\n.section-title {\n  font-family: var(--font-title);\n  font-size: 0.85rem;\n  letter-spacing: 0.08em;\n  color: var(--text-primary);\n  display: flex; align-items: center; gap: 8px;\n}\n.section-title::before {\n  content: '';\n  width: 3px; height: 16px;\n  background: var(--crimson);\n  border-radius: 2px;\n  box-shadow: 0 0 8px var(--crimson-glow);\n}\n.section-action {\n  font-size: 0.75rem; color: var(--crimson); cursor: pointer;\n  font-weight: 600; transition: var(--transition);\n}\n.section-action:hover { color: var(--sakura); }\n\n\/* ═══════════════════════════════════════════════════\n   TOAST NOTIFICATIONS\n═══════════════════════════════════════════════════ *\/\n.toast-container {\n  position: fixed; top: 20px; right: 20px; z-index: 2000;\n  display: flex; flex-direction: column; gap: 10px;\n  pointer-events: none;\n}\n.toast {\n  padding: 12px 18px;\n  border-radius: 12px;\n  background: var(--bg-card);\n  backdrop-filter: blur(20px);\n  border: 1px solid var(--glass-border);\n  font-size: 0.85rem;\n  font-weight: 600;\n  display: flex; align-items: center; gap: 10px;\n  pointer-events: all;\n  animation: toastIn 0.4s cubic-bezier(0.34,1.56,0.64,1) both;\n  box-shadow: 0 8px 32px rgba(0,0,0,0.4);\n  max-width: 300px;\n}\n.toast.exit { animation: toastOut 0.3s ease both; }\n@keyframes toastIn  { from{opacity:0; transform:translateX(40px)} to{opacity:1; transform:translateX(0)} }\n@keyframes toastOut { from{opacity:1; transform:translateX(0)} to{opacity:0; transform:translateX(40px)} }\n.toast-success { border-left: 3px solid #4ade80; }\n.toast-error   { border-left: 3px solid var(--crimson); }\n.toast-info    { border-left: 3px solid var(--cyan-edge); }\n.toast-warn    { border-left: 3px solid var(--gold); }\n\n\/* ═══════════════════════════════════════════════════\n   FOOTER\n═══════════════════════════════════════════════════ *\/\n.app-footer {\n  padding: 16px 0;\n  display: flex; align-items: center; justify-content: space-between;\n  border-top: 1px solid var(--glass-border);\n  flex-wrap: wrap; gap: 8px;\n  margin-top: 24px;\n}\n.footer-copy { font-size: 0.72rem; color: var(--text-dim); font-family: var(--font-jp); }\n.footer-links { display: flex; gap: 16px; }\n.footer-links a { font-size: 0.72rem; color: var(--text-muted); text-decoration: none; transition: var(--transition); }\n.footer-links a:hover { color: var(--crimson); }\n\n\/* ═══════════════════════════════════════════════════\n   MISC UTILITIES\n═══════════════════════════════════════════════════ *\/\n.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n.grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }\n.grid-4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; }\n@media(max-width:900px){ .grid-4{grid-template-columns:repeat(2,1fr)} }\n@media(max-width:600px){ .grid-4,.grid-3,.grid-2{grid-template-columns:1fr} }\n.mb-16 { margin-bottom: 16px; }\n.mb-8  { margin-bottom: 8px; }\n.fw-7  { font-weight: 700; }\n.text-center { text-align: center; }\n.text-muted  { color: var(--text-muted); }\n.flex-center { display: flex; align-items: center; justify-content: center; }\n.flex-between{ display: flex; align-items: center; justify-content: space-between; }\n\n\/* Divider *\/\n.divider { height: 1px; background: var(--glass-border); margin: 16px 0; }\n\n\/* Progress Bar *\/\n.progress-bar-wrap { height: 4px; background: var(--glass-border); border-radius: 99px; overflow: hidden; }\n.progress-bar { height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--crimson), var(--sakura)); transition: width 1s ease; }\n\n\/* Update card *\/\n.update-card { padding: 18px; display: flex; align-items: center; gap: 14px; }\n.update-icon { width: 46px; height: 46px; border-radius: 12px; background: rgba(255,209,102,0.15); color: var(--gold); display: flex; align-items: center; justify-content: center; font-size: 1.3rem; flex-shrink: 0; }\n.update-info { flex: 1; }\n.update-title { font-weight: 700; font-size: 0.92rem; }\n.update-desc  { font-size: 0.72rem; color: var(--text-muted); margin-top: 3px; }\n.btn-update {\n  padding: 9px 20px; border-radius: 10px; border: none;\n  background: linear-gradient(135deg, var(--gold), #ff9500);\n  color: #1a0a00; font-weight: 700; font-size: 0.82rem; cursor: pointer;\n  transition: var(--transition); white-space: nowrap;\n}\n.btn-update:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(255,209,102,0.3); }\n\n\/* ═══════════════════════════════════════════════════\n   ANIMATED SCAN LINE (decoration)\n═══════════════════════════════════════════════════ *\/\n.scanline {\n  position: fixed; top: 0; left: 0; right: 0;\n  height: 2px;\n  background: linear-gradient(90deg, transparent, var(--crimson), transparent);\n  animation: scanMove 6s linear infinite;\n  pointer-events: none; z-index: 0; opacity: 0.3;\n}\n@keyframes scanMove { from{top:0} to{top:100vh} }\n<\/style>\n<\/head>\n<body>\n\n<!-- BG Particles -->\n<div class=\"particles\" id=\"particles\"><\/div>\n<div class=\"scanline\"><\/div>\n\n<!-- Toast Container -->\n<div class=\"toast-container\" id=\"toastContainer\"><\/div>\n\n<!-- ═══════════════════════════════════════════════ -->\n<!-- MODALS -->\n<!-- ═══════════════════════════════════════════════ -->\n\n<!-- Check User Modal -->\n<div class=\"modal-overlay\" id=\"checkUserModal\">\n  <div class=\"modal glass\">\n    <div class=\"modal-header\">\n      <span class=\"modal-title\"><i class=\"fa-solid fa-users\" style=\"color:var(--crimson);margin-right:8px\"><\/i>CHECK USER<\/span>\n      <button class=\"modal-close\" onclick=\"closeModal('checkUserModal')\"><i class=\"fa-solid fa-xmark\"><\/i><\/button>\n    <\/div>\n    <div style=\"margin-bottom:12px\">\n      <div style=\"display:flex;gap:8px\">\n        <input type=\"text\" id=\"checkUserInput\" class=\"setting-input\" style=\"flex:1;min-width:0\" placeholder=\"Digite usuário ou UUID...\" \/>\n        <button class=\"btn-speed\" onclick=\"searchUser()\" style=\"padding:7px 16px;font-size:0.8rem;border-radius:10px\"><i class=\"fa-solid fa-magnifying-glass\"><\/i><\/button>\n      <\/div>\n    <\/div>\n    <div class=\"check-user-grid\" id=\"userResults\">\n      <!-- filled by JS -->\n    <\/div>\n  <\/div>\n<\/div>\n\n<!-- Update Modal -->\n<div class=\"modal-overlay\" id=\"updateModal\">\n  <div class=\"modal glass\">\n    <div class=\"modal-header\">\n      <span class=\"modal-title\"><i class=\"fa-solid fa-rotate\" style=\"color:var(--gold);margin-right:8px\"><\/i>ATUALIZAÇÃO<\/span>\n      <button class=\"modal-close\" onclick=\"closeModal('updateModal')\"><i class=\"fa-solid fa-xmark\"><\/i><\/button>\n    <\/div>\n    <div class=\"update-card\" style=\"background:rgba(255,209,102,0.05);border:1px solid rgba(255,209,102,0.2);border-radius:var(--radius-md);margin-bottom:14px\">\n      <div class=\"update-icon\"><i class=\"fa-solid fa-circle-up\"><\/i><\/div>\n      <div class=\"update-info\">\n        <div class=\"update-title\">Atualização Disponível<\/div>\n        <div class=\"update-desc\">Versão 2.9.1 → 3.0.0 — Novas features e correções<\/div>\n        <div style=\"margin-top:8px\"><div class=\"progress-bar-wrap\"><div class=\"progress-bar\" id=\"updateProgress\" style=\"width:0%\"><\/div><\/div><\/div>\n      <\/div>\n    <\/div>\n    <div style=\"display:flex;flex-direction:column;gap:8px;font-size:0.82rem;color:var(--text-muted);margin-bottom:18px\">\n      <div><i class=\"fa-solid fa-check\" style=\"color:#4ade80;margin-right:8px\"><\/i>Novo protocolo de tunelamento<\/div>\n      <div><i class=\"fa-solid fa-check\" style=\"color:#4ade80;margin-right:8px\"><\/i>Performance 40% mais rápida<\/div>\n      <div><i class=\"fa-solid fa-check\" style=\"color:#4ade80;margin-right:8px\"><\/i>Interface aprimorada<\/div>\n      <div><i class=\"fa-solid fa-check\" style=\"color:#4ade80;margin-right:8px\"><\/i>Correção de bugs críticos<\/div>\n    <\/div>\n    <button class=\"btn-update\" style=\"width:100%;padding:13px\" onclick=\"doUpdate()\"><i class=\"fa-solid fa-bolt\" style=\"margin-right:8px\"><\/i>INSTALAR ATUALIZAÇÃO<\/button>\n  <\/div>\n<\/div>\n\n<!-- Notification Modal -->\n<div class=\"modal-overlay\" id=\"notifModal\">\n  <div class=\"modal glass\">\n    <div class=\"modal-header\">\n      <span class=\"modal-title\"><i class=\"fa-solid fa-bell\" style=\"color:var(--crimson);margin-right:8px\"><\/i>NOTIFICAÇÕES<\/span>\n      <button class=\"modal-close\" onclick=\"closeModal('notifModal')\"><i class=\"fa-solid fa-xmark\"><\/i><\/button>\n    <\/div>\n    <div style=\"display:flex;flex-direction:column;gap:8px\" id=\"notifList\"><\/div>\n  <\/div>\n<\/div>\n\n<!-- ═══════════════════════════════════════════════ -->\n<!-- APP WRAPPER -->\n<!-- ═══════════════════════════════════════════════ -->\n<div class=\"app-wrapper\">\n\n  <!-- HEADER -->\n  <header class=\"app-header\">\n    <div class=\"logo-block\">\n      <div class=\"logo-icon\">⚔️<\/div>\n      <div class=\"logo-text\">\n        <span class=\"logo-name\">YUMEKO BK<\/span>\n        <span class=\"logo-sub\">由夢子 · 次世代接続<\/span>\n      <\/div>\n    <\/div>\n\n    <div style=\"display:flex;align-items:center;gap:12px;flex-wrap:wrap\">\n      <div class=\"version-badges\">\n        <span class=\"badge badge-app\">App v2.9.1<\/span>\n        <span class=\"badge badge-json\">JSON v1.4<\/span>\n        <span class=\"badge badge-live\" id=\"liveStatus\">● LIVE<\/span>\n      <\/div>\n      <div class=\"clock-block\">\n        <span id=\"clock-time\">--:--:--<\/span>\n        <span id=\"clock-date\">---<\/span>\n      <\/div>\n    <\/div>\n\n    <div class=\"header-btns\">\n      <button class=\"icon-btn\" onclick=\"openModal('notifModal')\" title=\"Notificações\">\n        <i class=\"fa-solid fa-bell\"><\/i>\n        <span class=\"notification-dot\"><\/span>\n      <\/button>\n      <button class=\"icon-btn\" onclick=\"openModal('updateModal')\" title=\"Atualização\">\n        <i class=\"fa-solid fa-rotate\"><\/i>\n      <\/button>\n      <button class=\"icon-btn\" onclick=\"openModal('checkUserModal')\" title=\"Check User\">\n        <i class=\"fa-solid fa-user-check\"><\/i>\n      <\/button>\n      <button class=\"icon-btn\" title=\"Suporte\">\n        <i class=\"fa-solid fa-headset\"><\/i>\n      <\/button>\n    <\/div>\n  <\/header>\n\n  <!-- NAV TABS -->\n  <nav class=\"nav-tabs\" style=\"margin-top:4px\">\n    <button class=\"nav-tab active\" onclick=\"switchTab('connect')\"><i class=\"fa-solid fa-bolt\"><\/i> Conectar<\/button>\n    <button class=\"nav-tab\" onclick=\"switchTab('servers')\"><i class=\"fa-solid fa-server\"><\/i> Servidores<\/button>\n    <button class=\"nav-tab\" onclick=\"switchTab('speedtest')\"><i class=\"fa-solid fa-gauge-high\"><\/i> Velocidade<\/button>\n    <button class=\"nav-tab\" onclick=\"switchTab('logs')\"><i class=\"fa-solid fa-terminal\"><\/i> Logs<\/button>\n    <button class=\"nav-tab\" onclick=\"switchTab('chat')\"><i class=\"fa-solid fa-comments\"><\/i> Chat<\/button>\n    <button class=\"nav-tab\" onclick=\"switchTab('settings')\"><i class=\"fa-solid fa-sliders\"><\/i> Ajustes<\/button>\n  <\/nav>\n\n  <!-- MAIN CONTENT -->\n  <main>\n\n    <!-- ▸ CONNECT TAB -->\n    <div class=\"tab-panel active\" id=\"tab-connect\">\n\n      <!-- Hero Connect -->\n      <div class=\"connect-hero glass mb-16\">\n        <div class=\"status-ring-wrap\">\n          <div class=\"status-ring\">\n            <svg class=\"ring-svg\" width=\"180\" height=\"180\" viewBox=\"0 0 180 180\">\n              <defs>\n                <linearGradient id=\"ringGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                  <stop offset=\"0%\" style=\"stop-color:var(--crimson);stop-opacity:1\" \/>\n                  <stop offset=\"100%\" style=\"stop-color:var(--sakura);stop-opacity:1\" \/>\n                <\/linearGradient>\n              <\/defs>\n              <circle cx=\"90\" cy=\"90\" r=\"80\" fill=\"none\" stroke=\"var(--glass-border)\" stroke-width=\"2\" \/>\n              <circle cx=\"90\" cy=\"90\" r=\"80\" fill=\"none\" stroke=\"url(#ringGrad)\" stroke-width=\"2\"\n                stroke-dasharray=\"8 16\" \/>\n            <\/svg>\n            <div class=\"ring-inner\">\n              <span class=\"ring-status-icon\" id=\"statusIcon\">🔴<\/span>\n              <span class=\"ring-status-text\" id=\"statusText\" style=\"color:var(--text-muted)\">OFFLINE<\/span>\n            <\/div>\n          <\/div>\n        <\/div>\n\n        <div class=\"btn-connect-wrap\">\n          <div class=\"btn-connect-glow\"><\/div>\n          <button class=\"btn-connect\" id=\"connectBtn\" onclick=\"toggleConnect()\">\n            <i class=\"fa-solid fa-bolt btn-connect-icon\"><\/i>\n            <span class=\"btn-connect-label\">CONECTAR<\/span>\n          <\/button>\n        <\/div>\n\n        <div class=\"status-badges\" id=\"statusBadges\">\n          <div class=\"status-chip\"><div class=\"dot dot-red\"><\/div><span id=\"connStatusLabel\">Desconectado<\/span><\/div>\n          <div class=\"status-chip\"><div class=\"dot dot-grey\" id=\"pingDot\"><\/div><span id=\"pingLabel\">Ping: —<\/span><\/div>\n          <div class=\"status-chip\"><div class=\"dot dot-grey\" id=\"ipDot\"><\/div><span id=\"ipLabel\">IP: —.—.—.—<\/span><\/div>\n          <div class=\"status-chip\"><i class=\"fa-solid fa-clock\" style=\"font-size:0.65rem;color:var(--text-dim)\"><\/i><span id=\"timerLabel\">00:00:00<\/span><\/div>\n        <\/div>\n      <\/div>\n\n      <!-- Stats Grid -->\n      <div class=\"grid-4 mb-16\">\n        <div class=\"stat-card glass\">\n          <div class=\"stat-icon stat-icon-red\"><i class=\"fa-solid fa-arrow-down\"><\/i><\/div>\n          <div class=\"stat-label\">Download<\/div>\n          <div class=\"stat-value\" id=\"dlStat\">0<\/div>\n          <div class=\"stat-sub\">MB\/s<\/div>\n        <\/div>\n        <div class=\"stat-card glass\">\n          <div class=\"stat-icon stat-icon-cyan\"><i class=\"fa-solid fa-arrow-up\"><\/i><\/div>\n          <div class=\"stat-label\">Upload<\/div>\n          <div class=\"stat-value\" id=\"ulStat\">0<\/div>\n          <div class=\"stat-sub\">MB\/s<\/div>\n        <\/div>\n        <div class=\"stat-card glass\">\n          <div class=\"stat-icon stat-icon-gold\"><i class=\"fa-solid fa-signal\"><\/i><\/div>\n          <div class=\"stat-label\">Ping<\/div>\n          <div class=\"stat-value\" id=\"pingStat\">—<\/div>\n          <div class=\"stat-sub\">ms<\/div>\n        <\/div>\n        <div class=\"stat-card glass\">\n          <div class=\"stat-icon stat-icon-green\"><i class=\"fa-solid fa-shield-halved\"><\/i><\/div>\n          <div class=\"stat-label\">Protocolo<\/div>\n          <div class=\"stat-value\" style=\"font-size:1rem\" id=\"protoStat\">—<\/div>\n          <div class=\"stat-sub\">Modo atual<\/div>\n        <\/div>\n      <\/div>\n\n      <!-- Quick server -->\n      <div class=\"glass\" style=\"padding:18px\">\n        <div class=\"section-header\">\n          <span class=\"section-title\">Servidor Ativo<\/span>\n          <span class=\"section-action\" onclick=\"switchTab('servers')\">Trocar →<\/span>\n        <\/div>\n        <div class=\"server-item selected\" style=\"background:rgba(224,27,60,0.06);border-color:var(--crimson)\">\n          <div class=\"server-flag\">🇧🇷<\/div>\n          <div class=\"server-info\">\n            <div class=\"server-name\">Brasil — São Paulo #1<\/div>\n            <div class=\"server-host\">br01.yumeko.net:443<\/div>\n          <\/div>\n          <div class=\"server-meta\">\n            <div class=\"signal-bars\">\n              <div class=\"bar active\"><\/div>\n              <div class=\"bar active\"><\/div>\n              <div class=\"bar active\"><\/div>\n              <div class=\"bar active\"><\/div>\n            <\/div>\n            <div class=\"ping-badge ping-low\">18ms<\/div>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <!-- ▸ SERVERS TAB -->\n    <div class=\"tab-panel\" id=\"tab-servers\">\n      <div class=\"glass\" style=\"padding:22px\">\n        <div class=\"section-header mb-16\">\n          <span class=\"section-title\">Lista de Servidores<\/span>\n          <div style=\"display:flex;gap:8px\">\n            <input type=\"text\" class=\"setting-input\" placeholder=\"Buscar...\" style=\"min-width:0;width:160px\" oninput=\"filterServers(this.value)\" \/>\n            <button class=\"icon-btn\" onclick=\"refreshServers()\" title=\"Atualizar\"><i class=\"fa-solid fa-arrows-rotate\"><\/i><\/button>\n          <\/div>\n        <\/div>\n        <div class=\"server-list\" id=\"serverList\">\n          <!-- filled by JS -->\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <!-- ▸ SPEED TEST TAB -->\n    <div class=\"tab-panel\" id=\"tab-speedtest\">\n      <div class=\"speedtest-card glass\">\n        <div class=\"section-title\" style=\"justify-content:center;margin-bottom:8px\">TESTE DE VELOCIDADE<\/div>\n        <div style=\"color:var(--text-muted);font-size:0.82rem;text-align:center\">Meça sua velocidade de conexão em tempo real<\/div>\n\n        <div class=\"gauge-wrap\">\n          <!-- Download Gauge -->\n          <div class=\"gauge-item\">\n            <div class=\"gauge gauge-dl\">\n              <svg class=\"gauge-svg\" width=\"130\" height=\"130\" viewBox=\"0 0 130 130\">\n                <defs>\n                  <linearGradient id=\"dlGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                    <stop offset=\"0%\" style=\"stop-color:var(--crimson)\" \/>\n                    <stop offset=\"100%\" style=\"stop-color:var(--sakura)\" \/>\n                  <\/linearGradient>\n                <\/defs>\n                <circle class=\"gauge-track\" cx=\"65\" cy=\"65\" r=\"55\" \/>\n                <circle class=\"gauge-fill\" id=\"dlGaugeFill\" cx=\"65\" cy=\"65\" r=\"55\"\n                  stroke-dasharray=\"345.4\" stroke-dashoffset=\"345.4\" \/>\n              <\/svg>\n              <div class=\"gauge-center\">\n                <div class=\"gauge-value\" id=\"dlGaugeVal\" style=\"color:var(--crimson)\">0<\/div>\n                <div class=\"gauge-unit\">Mbps<\/div>\n              <\/div>\n            <\/div>\n            <div class=\"gauge-label\"><i class=\"fa-solid fa-arrow-down\" style=\"color:var(--crimson);margin-right:5px\"><\/i>Download<\/div>\n          <\/div>\n          <!-- Upload Gauge -->\n          <div class=\"gauge-item\">\n            <div class=\"gauge gauge-ul\">\n              <svg class=\"gauge-svg\" width=\"130\" height=\"130\" viewBox=\"0 0 130 130\">\n                <defs>\n                  <linearGradient id=\"ulGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                    <stop offset=\"0%\" style=\"stop-color:var(--cyan-edge)\" \/>\n                    <stop offset=\"100%\" style=\"stop-color:var(--purple-neon)\" \/>\n                  <\/linearGradient>\n                <\/defs>\n                <circle class=\"gauge-track\" cx=\"65\" cy=\"65\" r=\"55\" \/>\n                <circle class=\"gauge-fill\" id=\"ulGaugeFill\" cx=\"65\" cy=\"65\" r=\"55\"\n                  stroke-dasharray=\"345.4\" stroke-dashoffset=\"345.4\" \/>\n              <\/svg>\n              <div class=\"gauge-center\">\n                <div class=\"gauge-value\" id=\"ulGaugeVal\" style=\"color:var(--cyan-edge)\">0<\/div>\n                <div class=\"gauge-unit\">Mbps<\/div>\n              <\/div>\n            <\/div>\n            <div class=\"gauge-label\"><i class=\"fa-solid fa-arrow-up\" style=\"color:var(--cyan-edge);margin-right:5px\"><\/i>Upload<\/div>\n          <\/div>\n        <\/div>\n\n        <div id=\"speedProgressWrap\" style=\"display:none;margin-bottom:16px\">\n          <div style=\"font-size:0.78rem;color:var(--text-muted);margin-bottom:6px;text-align:center\" id=\"speedPhase\">Iniciando...<\/div>\n          <div class=\"progress-bar-wrap\"><div class=\"progress-bar\" id=\"speedProgressBar\" style=\"width:0%\"><\/div><\/div>\n        <\/div>\n\n        <button class=\"btn-speed\" id=\"speedBtn\" onclick=\"runSpeedTest()\">\n          <i class=\"fa-solid fa-gauge-high\" style=\"margin-right:8px\"><\/i>INICIAR TESTE\n        <\/button>\n\n        <div class=\"speed-stats\" style=\"margin-top:24px\">\n          <div class=\"speed-stat\">\n            <div class=\"speed-stat-val\" id=\"pingResult\">—<\/div>\n            <div class=\"speed-stat-lbl\"><i class=\"fa-solid fa-signal\" style=\"color:var(--gold)\"><\/i> Ping<\/div>\n          <\/div>\n          <div class=\"speed-stat\">\n            <div class=\"speed-stat-val\" id=\"jitterResult\">—<\/div>\n            <div class=\"speed-stat-lbl\"><i class=\"fa-solid fa-wave-square\" style=\"color:var(--purple-neon)\"><\/i> Jitter<\/div>\n          <\/div>\n          <div class=\"speed-stat\">\n            <div class=\"speed-stat-val\" id=\"lossResult\">—<\/div>\n            <div class=\"speed-stat-lbl\"><i class=\"fa-solid fa-triangle-exclamation\" style=\"color:var(--crimson)\"><\/i> Perda<\/div>\n          <\/div>\n          <div class=\"speed-stat\">\n            <div class=\"speed-stat-val\" id=\"serverResult\">—<\/div>\n            <div class=\"speed-stat-lbl\"><i class=\"fa-solid fa-location-dot\" style=\"color:var(--cyan-edge)\"><\/i> Servidor<\/div>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <!-- ▸ LOGS TAB -->\n    <div class=\"tab-panel\" id=\"tab-logs\">\n      <div class=\"glass\" style=\"padding:22px\">\n        <div class=\"logs-header\">\n          <h3>REGISTRO DO SISTEMA<\/h3>\n          <div class=\"log-filters\">\n            <button class=\"log-filter active\" onclick=\"filterLogs('all',this)\">Todos<\/button>\n            <button class=\"log-filter\" onclick=\"filterLogs('info',this)\">Info<\/button>\n            <button class=\"log-filter\" onclick=\"filterLogs('success',this)\">OK<\/button>\n            <button class=\"log-filter\" onclick=\"filterLogs('warn',this)\">Aviso<\/button>\n            <button class=\"log-filter\" onclick=\"filterLogs('error',this)\">Erro<\/button>\n          <\/div>\n        <\/div>\n        <div class=\"logs-box\" id=\"logsBox\">\n          <!-- filled by JS -->\n        <\/div>\n        <div class=\"log-actions\">\n          <button class=\"btn-sm\" onclick=\"addRandomLog()\"><i class=\"fa-solid fa-plus\"><\/i> Simular Log<\/button>\n          <button class=\"btn-sm\" onclick=\"clearLogs()\"><i class=\"fa-solid fa-trash\"><\/i> Limpar<\/button>\n          <button class=\"btn-sm\" onclick=\"exportLogs()\"><i class=\"fa-solid fa-download\"><\/i> Exportar<\/button>\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <!-- ▸ CHAT TAB -->\n    <div class=\"tab-panel\" id=\"tab-chat\">\n      <div class=\"chat-wrap\">\n        <div class=\"chat-header\">\n          <div class=\"chat-avatar\">🌸<\/div>\n          <div>\n            <div class=\"chat-title\">Yumeko Support<\/div>\n            <div class=\"chat-subtitle\">由夢子 · Suporte Oficial<\/div>\n          <\/div>\n          <div class=\"chat-online\"><\/div>\n        <\/div>\n        <div class=\"chat-messages\" id=\"chatMessages\">\n          <div class=\"msg received\">\n            <div class=\"msg-avatar\">🤖<\/div>\n            <div>\n              <div class=\"msg-bubble\">Olá! Bem-vindo ao suporte Yumeko BK. Como posso ajudar você? ⚔️<\/div>\n              <div class=\"msg-time\">Agora<\/div>\n            <\/div>\n          <\/div>\n        <\/div>\n        <div class=\"chat-input-row\">\n          <input type=\"text\" class=\"chat-input\" id=\"chatInput\" placeholder=\"Digite sua mensagem...\" onkeydown=\"if(event.key==='Enter') sendMsg()\" \/>\n          <button class=\"btn-send\" onclick=\"sendMsg()\"><i class=\"fa-solid fa-paper-plane\"><\/i><\/button>\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <!-- ▸ SETTINGS TAB -->\n    <div class=\"tab-panel\" id=\"tab-settings\">\n      <!-- Theme -->\n      <div class=\"glass mb-16\" style=\"padding:22px\">\n        <div class=\"section-title mb-16\">TEMA & APARÊNCIA<\/div>\n        <div style=\"margin-bottom:16px\">\n          <div style=\"font-size:0.82rem;color:var(--text-muted);margin-bottom:10px\">Selecionar Tema<\/div>\n          <div class=\"theme-grid\">\n            <div class=\"theme-swatch swatch-dark active\" title=\"Dark\" onclick=\"setTheme('dark',this)\"><\/div>\n            <div class=\"theme-swatch swatch-light\" title=\"Light\" onclick=\"setTheme('light',this)\"><\/div>\n            <div class=\"theme-swatch swatch-sakura\" title=\"Sakura\" onclick=\"setTheme('sakura',this)\"><\/div>\n            <div class=\"theme-swatch swatch-cyber\" title=\"Cyber\" onclick=\"setTheme('cyber',this)\"><\/div>\n            <div class=\"theme-swatch swatch-obsidian\" title=\"Obsidian\" onclick=\"setTheme('obsidian',this)\"><\/div>\n          <\/div>\n        <\/div>\n        <div class=\"setting-row\">\n          <div><div class=\"setting-label\">Cor de Destaque<\/div><div class=\"setting-desc\">Personalizar cor principal<\/div><\/div>\n          <input type=\"color\" value=\"#e01b3c\" style=\"background:none;border:none;cursor:pointer;width:40px;height:32px;padding:0;border-radius:8px\" onchange=\"setAccentColor(this.value)\" \/>\n        <\/div>\n        <div class=\"setting-row\">\n          <div><div class=\"setting-label\">Intensidade do Blur<\/div><div class=\"setting-desc\">Efeito vidro iOS<\/div><\/div>\n          <input type=\"range\" min=\"0\" max=\"40\" value=\"20\" class=\"setting-input\" style=\"min-width:80px\" \/>\n        <\/div>\n      <\/div>\n\n      <div class=\"settings-grid\">\n        <!-- VPN Settings -->\n        <div class=\"settings-section glass\">\n          <h4><i class=\"fa-solid fa-shield-halved\" style=\"margin-right:8px\"><\/i>VPN & REDE<\/h4>\n          <div class=\"setting-row\">\n            <div><div class=\"setting-label\">Protocolo<\/div><div class=\"setting-desc\">Modo de tunelamento<\/div><\/div>\n            <select class=\"setting-select\">\n              <option>WebSocket<\/option>\n              <option>SSH<\/option>\n              <option>V2Ray<\/option>\n              <option>Xray<\/option>\n            <\/select>\n          <\/div>\n          <div class=\"setting-row\">\n            <div><div class=\"setting-label\">Reconexão Auto<\/div><div class=\"setting-desc\">Reconectar se cair<\/div><\/div>\n            <label class=\"toggle\"><input type=\"checkbox\" checked \/><span class=\"toggle-slider\"><\/span><\/label>\n          <\/div>\n          <div class=\"setting-row\">\n            <div><div class=\"setting-label\">Kill Switch<\/div><div class=\"setting-desc\">Bloqueio ao desconectar<\/div><\/div>\n            <label class=\"toggle\"><input type=\"checkbox\" \/><span class=\"toggle-slider\"><\/span><\/label>\n          <\/div>\n          <div class=\"setting-row\">\n            <div><div class=\"setting-label\">Split Tunnel<\/div><div class=\"setting-desc\">Roteamento seletivo<\/div><\/div>\n            <label class=\"toggle\"><input type=\"checkbox\" \/><span class=\"toggle-slider\"><\/span><\/label>\n          <\/div>\n          <div class=\"setting-row\">\n            <div><div class=\"setting-label\">Porta<\/div><div class=\"setting-desc\">Porta de conexão<\/div><\/div>\n            <input type=\"text\" value=\"443\" class=\"setting-input\" style=\"max-width:90px;min-width:0\" \/>\n          <\/div>\n        <\/div>\n\n        <!-- App Settings -->\n        <div class=\"settings-section glass\">\n          <h4><i class=\"fa-solid fa-mobile-screen-button\" style=\"margin-right:8px\"><\/i>APLICATIVO<\/h4>\n          <div class=\"setting-row\">\n            <div><div class=\"setting-label\">Notificações<\/div><div class=\"setting-desc\">Avisos em tempo real<\/div><\/div>\n            <label class=\"toggle\"><input type=\"checkbox\" checked \/><span class=\"toggle-slider\"><\/span><\/label>\n          <\/div>\n          <div class=\"setting-row\">\n            <div><div class=\"setting-label\">Vibração<\/div><div class=\"setting-desc\">Feedback tátil<\/div><\/div>\n            <label class=\"toggle\"><input type=\"checkbox\" checked \/><span class=\"toggle-slider\"><\/span><\/label>\n          <\/div>\n          <div class=\"setting-row\">\n            <div><div class=\"setting-label\">Iniciar com sistema<\/div><\/div>\n            <label class=\"toggle\"><input type=\"checkbox\" \/><span class=\"toggle-slider\"><\/span><\/label>\n          <\/div>\n          <div class=\"setting-row\">\n            <div><div class=\"setting-label\">DNS<\/div><\/div>\n            <select class=\"setting-select\">\n              <option>Auto<\/option>\n              <option>8.8.8.8<\/option>\n              <option>1.1.1.1<\/option>\n              <option>Custom<\/option>\n            <\/select>\n          <\/div>\n          <div class=\"setting-row\">\n            <div><div class=\"setting-label\">Idioma<\/div><\/div>\n            <select class=\"setting-select\">\n              <option>Português<\/option>\n              <option>English<\/option>\n              <option>日本語<\/option>\n            <\/select>\n          <\/div>\n        <\/div>\n\n        <!-- Security -->\n        <div class=\"settings-section glass\">\n          <h4><i class=\"fa-solid fa-lock\" style=\"margin-right:8px\"><\/i>SEGURANÇA<\/h4>\n          <div class=\"setting-row\">\n            <div><div class=\"setting-label\">Criptografia<\/div><\/div>\n            <select class=\"setting-select\">\n              <option>AES-256-GCM<\/option>\n              <option>ChaCha20<\/option>\n              <option>AES-128<\/option>\n            <\/select>\n          <\/div>\n          <div class=\"setting-row\">\n            <div><div class=\"setting-label\">Obfuscação<\/div><div class=\"setting-desc\">Mascarar tráfego<\/div><\/div>\n            <label class=\"toggle\"><input type=\"checkbox\" checked \/><span class=\"toggle-slider\"><\/span><\/label>\n          <\/div>\n          <div class=\"setting-row\">\n            <div><div class=\"setting-label\">IP Leak Protect<\/div><\/div>\n            <label class=\"toggle\"><input type=\"checkbox\" checked \/><span class=\"toggle-slider\"><\/span><\/label>\n          <\/div>\n          <div style=\"margin-top:14px\">\n            <button class=\"btn-sm\" style=\"width:100%;justify-content:center\" onclick=\"showToast('Logs de segurança exportados!','success')\">\n              <i class=\"fa-solid fa-shield-check\"><\/i> Verificar Segurança\n            <\/button>\n          <\/div>\n        <\/div>\n\n        <!-- About -->\n        <div class=\"settings-section glass\">\n          <h4><i class=\"fa-solid fa-circle-info\" style=\"margin-right:8px\"><\/i>SOBRE<\/h4>\n          <div class=\"setting-row\">\n            <div class=\"setting-label\">Aplicativo<\/div>\n            <span style=\"color:var(--crimson);font-family:var(--font-title);font-size:0.82rem\">Yumeko BK<\/span>\n          <\/div>\n          <div class=\"setting-row\">\n            <div class=\"setting-label\">Versão<\/div>\n            <span class=\"badge badge-app\">2.9.1<\/span>\n          <\/div>\n          <div class=\"setting-row\">\n            <div class=\"setting-label\">JSON<\/div>\n            <span class=\"badge badge-json\">v1.4<\/span>\n          <\/div>\n          <div class=\"setting-row\">\n            <div class=\"setting-label\">Build<\/div>\n            <span style=\"font-size:0.8rem;color:var(--text-muted);font-family:monospace\">20260531-stable<\/span>\n          <\/div>\n          <div class=\"setting-row\">\n            <div class=\"setting-label\">Protocolo<\/div>\n            <span style=\"font-size:0.8rem;color:var(--text-muted)\">WebSocket + TLS<\/span>\n          <\/div>\n          <div style=\"margin-top:14px;display:flex;gap:8px\">\n            <button class=\"btn-sm\" style=\"flex:1;justify-content:center\" onclick=\"showToast('Cache limpo!','success')\"><i class=\"fa-solid fa-broom\"><\/i> Limpar Cache<\/button>\n            <button class=\"btn-sm\" style=\"flex:1;justify-content:center\" onclick=\"openModal('updateModal')\"><i class=\"fa-solid fa-rotate\"><\/i> Atualizar<\/button>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n\n  <\/main>\n\n  <!-- FOOTER -->\n  <footer class=\"app-footer\">\n    <span class=\"footer-copy\">© 2026 Yumeko BK · 由夢子 次世代<\/span>\n    <div class=\"footer-links\">\n      <a href=\"#\">Termos<\/a>\n      <a href=\"#\">Privacidade<\/a>\n      <a href=\"#\">Suporte<\/a>\n    <\/div>\n  <\/footer>\n\n<\/div>\n\n<script>\n\/\/ ═══════════════════════════════════════════════════\n\/\/ PARTICLES\n\/\/ ═══════════════════════════════════════════════════\n(function createParticles(){\n  const c = document.getElementById('particles');\n  for(let i=0;i<40;i++){\n    const p = document.createElement('div');\n    p.className = 'particle';\n    p.style.left = Math.random()*100+'%';\n    p.style.animationDuration = (6+Math.random()*12)+'s';\n    p.style.animationDelay = (Math.random()*12)+'s';\n    p.style.opacity = Math.random()*0.6;\n    p.style.width = p.style.height = (1+Math.random()*3)+'px';\n    \/\/ random colors\n    const cols = ['var(--crimson)','var(--sakura)','var(--gold)','var(--cyan-edge)'];\n    p.style.background = cols[Math.floor(Math.random()*cols.length)];\n    c.appendChild(p);\n  }\n})();\n\n\/\/ ═══════════════════════════════════════════════════\n\/\/ CLOCK\n\/\/ ═══════════════════════════════════════════════════\nfunction updateClock(){\n  const n = new Date();\n  const p = v => String(v).padStart(2,'0');\n  document.getElementById('clock-time').textContent =\n    `${p(n.getHours())}:${p(n.getMinutes())}:${p(n.getSeconds())}`;\n  document.getElementById('clock-date').textContent =\n    n.toLocaleDateString('pt-BR',{weekday:'short',day:'2-digit',month:'short'});\n}\nsetInterval(updateClock, 1000); updateClock();\n\n\/\/ ═══════════════════════════════════════════════════\n\/\/ TABS\n\/\/ ═══════════════════════════════════════════════════\nfunction switchTab(id){\n  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));\n  document.querySelectorAll('.nav-tab').forEach(b=>b.classList.remove('active'));\n  document.getElementById('tab-'+id).classList.add('active');\n  const tabs = ['connect','servers','speedtest','logs','chat','settings'];\n  const idx = tabs.indexOf(id);\n  document.querySelectorAll('.nav-tab')[idx].classList.add('active');\n}\n\n\/\/ ═══════════════════════════════════════════════════\n\/\/ TOAST\n\/\/ ═══════════════════════════════════════════════════\nfunction showToast(msg, type='info', duration=3000){\n  const icons = {success:'circle-check', error:'circle-xmark', info:'circle-info', warn:'triangle-exclamation'};\n  const t = document.createElement('div');\n  t.className = `toast toast-${type}`;\n  t.innerHTML = `<i class=\"fa-solid fa-${icons[type]||'circle-info'}\" style=\"color:${type==='success'?'#4ade80':type==='error'?'var(--crimson)':type==='warn'?'var(--gold)':'var(--cyan-edge)'}\"><\/i>${msg}`;\n  document.getElementById('toastContainer').appendChild(t);\n  setTimeout(()=>{ t.classList.add('exit'); setTimeout(()=>t.remove(), 300); }, duration);\n}\n\n\/\/ ═══════════════════════════════════════════════════\n\/\/ MODALS\n\/\/ ═══════════════════════════════════════════════════\nfunction openModal(id){ document.getElementById(id).classList.add('open'); }\nfunction closeModal(id){ document.getElementById(id).classList.remove('open'); }\ndocument.querySelectorAll('.modal-overlay').forEach(m=>{\n  m.addEventListener('click', e=>{ if(e.target===m) m.classList.remove('open'); });\n});\n\n\/\/ ═══════════════════════════════════════════════════\n\/\/ CONNECT LOGIC\n\/\/ ═══════════════════════════════════════════════════\nlet connected = false, connecting = false;\nlet connTimer = null, connSeconds = 0;\n\nfunction toggleConnect(){\n  if(connecting) return;\n  if(!connected){\n    startConnecting();\n  } else {\n    disconnect();\n  }\n}\nfunction startConnecting(){\n  connecting = true;\n  const btn = document.getElementById('connectBtn');\n  btn.className = 'btn-connect connecting';\n  btn.innerHTML = '<i class=\"fa-solid fa-spinner fa-spin btn-connect-icon\"><\/i><span>CONECTANDO...<\/span>';\n  updateStatus('connecting','🟡','AGUARDE...',false);\n  addLog('info','Iniciando conexão com br01.yumeko.net:443');\n  addLog('info','Autenticando credenciais...');\n  setTimeout(()=>{\n    addLog('success','Handshake TLS estabelecido');\n    addLog('info','Configurando tunel WebSocket...');\n  },800);\n  setTimeout(()=>{\n    connecting = false;\n    connected = true;\n    btn.className = 'btn-connect connected';\n    btn.innerHTML = '<i class=\"fa-solid fa-circle-stop btn-connect-icon\"><\/i><span>DESCONECTAR<\/span>';\n    updateStatus('connected','🟢','CONECTADO',true);\n    document.getElementById('pingDot').className = 'dot dot-green';\n    document.getElementById('pingLabel').textContent = 'Ping: 18ms';\n    document.getElementById('ipDot').className = 'dot dot-green';\n    document.getElementById('ipLabel').textContent = 'IP: 177.92.14.'+Math.floor(Math.random()*200+10);\n    document.getElementById('pingStat').textContent = '18';\n    document.getElementById('protoStat').textContent = 'WSS';\n    document.getElementById('liveStatus').textContent = '● LIVE';\n    addLog('success','Conexão estabelecida com sucesso!');\n    addLog('info','Protocolo: WebSocket + TLS 1.3');\n    showToast('Conectado a São Paulo #1 🇧🇷','success');\n    startTrafficSimulation();\n    startTimer();\n  }, 2400);\n}\nfunction disconnect(){\n  connected = false;\n  const btn = document.getElementById('connectBtn');\n  btn.className = 'btn-connect';\n  btn.innerHTML = '<i class=\"fa-solid fa-bolt btn-connect-icon\"><\/i><span>CONECTAR<\/span>';\n  updateStatus('disconnected','🔴','OFFLINE',false);\n  document.getElementById('pingDot').className = 'dot dot-grey';\n  document.getElementById('pingLabel').textContent = 'Ping: —';\n  document.getElementById('ipDot').className = 'dot dot-grey';\n  document.getElementById('ipLabel').textContent = 'IP: —.—.—.—';\n  document.getElementById('dlStat').textContent = '0';\n  document.getElementById('ulStat').textContent = '0';\n  document.getElementById('pingStat').textContent = '—';\n  document.getElementById('protoStat').textContent = '—';\n  addLog('warn','Desconectado pelo usuário');\n  showToast('Desconectado','warn');\n  stopTimer();\n}\nfunction updateStatus(state, icon, text, alive){\n  document.getElementById('statusIcon').textContent = icon;\n  document.getElementById('statusText').textContent = text;\n  const colors = {connected:'#4ade80',connecting:'var(--gold)',disconnected:'var(--text-muted)'};\n  document.getElementById('statusText').style.color = colors[state]||'var(--text-muted)';\n  const label = document.getElementById('connStatusLabel');\n  label.textContent = text === 'OFFLINE' ? 'Desconectado' : text === 'AGUARDE...' ? 'Conectando...' : 'Conectado';\n  const dot = label.previousElementSibling;\n  if(state==='connected') { dot.className='dot dot-green'; }\n  else if(state==='connecting') { dot.className='dot dot-yellow'; }\n  else { dot.className='dot dot-red'; }\n}\nfunction startTimer(){\n  connSeconds = 0;\n  connTimer = setInterval(()=>{\n    connSeconds++;\n    const h=Math.floor(connSeconds\/3600), m=Math.floor((connSeconds%3600)\/60), s=connSeconds%60;\n    const p=v=>String(v).padStart(2,'0');\n    document.getElementById('timerLabel').textContent = `${p(h)}:${p(m)}:${p(s)}`;\n  }, 1000);\n}\nfunction stopTimer(){\n  clearInterval(connTimer);\n  document.getElementById('timerLabel').textContent = '00:00:00';\n}\nlet trafficInterval = null;\nfunction startTrafficSimulation(){\n  clearInterval(trafficInterval);\n  trafficInterval = setInterval(()=>{\n    if(!connected){ clearInterval(trafficInterval); return; }\n    document.getElementById('dlStat').textContent = (0.5+Math.random()*8).toFixed(1);\n    document.getElementById('ulStat').textContent = (0.1+Math.random()*2).toFixed(1);\n  }, 1200);\n}\n\n\/\/ ═══════════════════════════════════════════════════\n\/\/ SERVERS\n\/\/ ═══════════════════════════════════════════════════\nconst SERVERS = [\n  {flag:'🇧🇷',name:'Brasil — São Paulo #1',host:'br01.yumeko.net:443',ping:18,bars:4,quality:'low'},\n  {flag:'🇧🇷',name:'Brasil — Rio de Janeiro',host:'br02.yumeko.net:443',ping:24,bars:4,quality:'low'},\n  {flag:'🇺🇸',name:'USA — New York #1',host:'us01.yumeko.net:443',ping:92,bars:3,quality:'mid'},\n  {flag:'🇺🇸',name:'USA — Los Angeles',host:'us02.yumeko.net:443',ping:145,bars:2,quality:'mid'},\n  {flag:'🇩🇪',name:'Alemanha — Frankfurt',host:'de01.yumeko.net:443',ping:180,bars:2,quality:'high'},\n  {flag:'🇯🇵',name:'Japão — Tokyo',host:'jp01.yumeko.net:443',ping:220,bars:1,quality:'high'},\n  {flag:'🇸🇬',name:'Singapura #1',host:'sg01.yumeko.net:443',ping:110,bars:3,quality:'mid'},\n  {flag:'🇳🇱',name:'Holanda — Amsterdam',host:'nl01.yumeko.net:443',ping:190,bars:2,quality:'high'},\n  {flag:'🇦🇷',name:'Argentina — Buenos Aires',host:'ar01.yumeko.net:443',ping:42,bars:4,quality:'low'},\n  {flag:'🇨🇦',name:'Canadá — Toronto',host:'ca01.yumeko.net:443',ping:130,bars:3,quality:'mid'},\n];\nlet filteredServers = [...SERVERS];\nlet selectedServer = 0;\n\nfunction renderServers(){\n  const list = document.getElementById('serverList');\n  list.innerHTML = filteredServers.map((s,i)=>{\n    const bars = Array.from({length:4},(_,b)=>`<div class=\"bar${b<s.bars?' active':''}\"><\/div>`).join('');\n    const pClass = s.quality==='low'?'ping-low':s.quality==='mid'?'ping-mid':'ping-high';\n    return `<div class=\"server-item${i===selectedServer?' selected':''}\" onclick=\"selectServer(${i})\">\n      <div class=\"server-flag\">${s.flag}<\/div>\n      <div class=\"server-info\">\n        <div class=\"server-name\">${s.name}<\/div>\n        <div class=\"server-host\">${s.host}<\/div>\n      <\/div>\n      <div class=\"server-meta\">\n        <div class=\"signal-bars\">${bars}<\/div>\n        <div class=\"ping-badge ${pClass}\">${s.ping}ms<\/div>\n      <\/div>\n    <\/div>`;\n  }).join('');\n}\nfunction selectServer(i){\n  selectedServer = i;\n  renderServers();\n  showToast(`Servidor selecionado: ${filteredServers[i].name}`,'info');\n}\nfunction filterServers(q){\n  filteredServers = SERVERS.filter(s=>s.name.toLowerCase().includes(q.toLowerCase())||s.host.includes(q));\n  renderServers();\n}\nfunction refreshServers(){\n  showToast('Atualizando lista de servidores...','info');\n  setTimeout(()=>{ renderServers(); showToast('Lista atualizada!','success'); }, 1200);\n}\nrenderServers();\n\n\/\/ ═══════════════════════════════════════════════════\n\/\/ SPEED TEST\n\/\/ ═══════════════════════════════════════════════════\nlet speedRunning = false;\nfunction runSpeedTest(){\n  if(speedRunning) return;\n  speedRunning = true;\n  const btn = document.getElementById('speedBtn');\n  btn.innerHTML = '<i class=\"fa-solid fa-spinner fa-spin\" style=\"margin-right:8px\"><\/i>TESTANDO...';\n  btn.disabled = true;\n  document.getElementById('speedProgressWrap').style.display='block';\n  document.getElementById('dlGaugeVal').textContent = '0';\n  document.getElementById('ulGaugeVal').textContent = '0';\n  document.getElementById('pingResult').textContent = '—';\n  document.getElementById('jitterResult').textContent = '—';\n  document.getElementById('lossResult').textContent = '—';\n  document.getElementById('serverResult').textContent = '—';\n\n  \/\/ Phase 1: Ping\n  setSpeedPhase('Medindo ping...', 0);\n  animateGauge('dl', 0, 0);\n  setTimeout(()=>{\n    const ping = 15 + Math.floor(Math.random()*40);\n    document.getElementById('pingResult').textContent = ping+'ms';\n    document.getElementById('jitterResult').textContent = (1+Math.random()*5).toFixed(1)+'ms';\n    setSpeedPhase('Testando download...', 15);\n    \/\/ Phase 2: Download\n    let dl = 0;\n    const dlTarget = 30 + Math.random()*80;\n    const dlTimer = setInterval(()=>{\n      dl += dlTarget\/20;\n      if(dl>=dlTarget){ dl=dlTarget; clearInterval(dlTimer); }\n      document.getElementById('dlGaugeVal').textContent = dl.toFixed(0);\n      animateGauge('dl', dl, 200);\n      setSpeedPhase('Testando download...', 15 + (dl\/dlTarget)*40);\n    }, 120);\n    \/\/ Phase 3: Upload\n    setTimeout(()=>{\n      setSpeedPhase('Testando upload...', 60);\n      let ul = 0;\n      const ulTarget = 10 + Math.random()*40;\n      const ulTimer = setInterval(()=>{\n        ul += ulTarget\/20;\n        if(ul>=ulTarget){ ul=ulTarget; clearInterval(ulTimer); }\n        document.getElementById('ulGaugeVal').textContent = ul.toFixed(0);\n        animateGauge('ul', ul, 200);\n        setSpeedPhase('Testando upload...', 60 + (ul\/ulTarget)*35);\n      }, 120);\n      setTimeout(()=>{\n        setSpeedPhase('Concluído!', 100);\n        document.getElementById('lossResult').textContent = (Math.random()*0.5).toFixed(1)+'%';\n        document.getElementById('serverResult').textContent = 'SP #1';\n        btn.innerHTML = '<i class=\"fa-solid fa-rotate\" style=\"margin-right:8px\"><\/i>NOVO TESTE';\n        btn.disabled = false;\n        speedRunning = false;\n        showToast(`Download: ${dlTarget.toFixed(0)} Mbps ✓`,'success');\n        setTimeout(()=>document.getElementById('speedProgressWrap').style.display='none',1500);\n      }, 2800);\n    }, 2600);\n  }, 600);\n}\nfunction setSpeedPhase(txt, pct){\n  document.getElementById('speedPhase').textContent = txt;\n  document.getElementById('speedProgressBar').style.width = pct+'%';\n}\nfunction animateGauge(type, val, max){\n  const fill = document.getElementById(type+'GaugeFill');\n  const maxVal = max || 200;\n  const pct = Math.min(val\/maxVal, 1);\n  const circ = 345.4;\n  fill.style.strokeDashoffset = circ - (pct * circ);\n}\n\n\/\/ ═══════════════════════════════════════════════════\n\/\/ LOGS\n\/\/ ═══════════════════════════════════════════════════\nlet logs = [], currentFilter = 'all';\nconst logTemplates = [\n  {level:'info',   msg:'Verificando rota de rede...'},\n  {level:'success',msg:'Pacote entregue com sucesso'},\n  {level:'warn',   msg:'Latência elevada detectada (>150ms)'},\n  {level:'error',  msg:'Falha na reconexão. Tentando novamente...'},\n  {level:'info',   msg:'Renovando certificado TLS'},\n  {level:'success',msg:'Tunel WebSocket estabelecido'},\n  {level:'info',   msg:'DNS flush executado'},\n  {level:'warn',   msg:'Limite de banda atingido'},\n  {level:'success',msg:'Backup de configuração salvo'},\n  {level:'info',   msg:'Heartbeat enviado ao servidor'},\n];\nfunction addLog(level, msg){\n  const now = new Date();\n  const time = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;\n  logs.push({level, msg, time});\n  renderLogs();\n}\nfunction renderLogs(){\n  const box = document.getElementById('logsBox');\n  const filtered = currentFilter==='all' ? logs : logs.filter(l=>l.level===currentFilter);\n  box.innerHTML = filtered.map(l=>`\n    <div class=\"log-entry ${l.level}\">\n      <span class=\"log-time\">${l.time}<\/span>\n      <span class=\"log-level level-${l.level}\">${l.level.toUpperCase()}<\/span>\n      <span class=\"log-msg\">${l.msg}<\/span>\n    <\/div>\n  `).join('');\n  box.scrollTop = box.scrollHeight;\n}\nfunction filterLogs(f, btn){\n  currentFilter = f;\n  document.querySelectorAll('.log-filter').forEach(b=>b.classList.remove('active'));\n  btn.classList.add('active');\n  renderLogs();\n}\nfunction addRandomLog(){\n  const t = logTemplates[Math.floor(Math.random()*logTemplates.length)];\n  addLog(t.level, t.msg);\n}\nfunction clearLogs(){ logs=[]; renderLogs(); showToast('Logs limpos','info'); }\nfunction exportLogs(){\n  const txt = logs.map(l=>`[${l.time}] [${l.level.toUpperCase()}] ${l.msg}`).join('\\n');\n  const a = document.createElement('a');\n  a.href = 'data:text\/plain;charset=utf-8,'+encodeURIComponent(txt);\n  a.download = 'yumeko_logs.txt'; a.click();\n  showToast('Logs exportados!','success');\n}\n\/\/ Initial logs\naddLog('info','Yumeko BK iniciado');\naddLog('info','Carregando configurações...');\naddLog('success','Interface carregada com sucesso');\naddLog('info','Verificando servidores disponíveis...');\naddLog('success','12 servidores online');\n\/\/ Live log ticker\nsetInterval(()=>{ if(Math.random()>0.6) addRandomLog(); }, 4000);\n\n\/\/ ═══════════════════════════════════════════════════\n\/\/ CHAT\n\/\/ ═══════════════════════════════════════════════════\nconst autoReplies = [\n  'Entendido! Vou verificar isso para você. ⚔️',\n  'Obrigado por entrar em contato com o suporte Yumeko BK!',\n  'Seu problema foi registrado. Aguarde um momento...',\n  'Para problemas de conexão, tente trocar o servidor! 🔄',\n  'Nossa equipe está disponível 24\/7 para te ajudar! 🌸',\n  'Verifique se o protocolo WebSocket está ativado nas configurações.',\n  'Ping elevado? Tente um servidor mais próximo de você! 🗾',\n];\nfunction sendMsg(){\n  const inp = document.getElementById('chatInput');\n  const val = inp.value.trim();\n  if(!val) return;\n  appendMsg(val, true);\n  inp.value = '';\n  setTimeout(()=>{\n    const r = autoReplies[Math.floor(Math.random()*autoReplies.length)];\n    appendMsg(r, false);\n  }, 800 + Math.random()*1000);\n}\nfunction appendMsg(text, sent){\n  const now = new Date();\n  const time = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;\n  const div = document.createElement('div');\n  div.className = `msg ${sent?'sent':'received'}`;\n  div.innerHTML = `\n    ${!sent?'<div class=\"msg-avatar\">🤖<\/div>':''}\n    <div>\n      <div class=\"msg-bubble\">${text}<\/div>\n      <div class=\"msg-time\">${time}<\/div>\n    <\/div>\n    ${sent?'<div class=\"msg-avatar\">👤<\/div>':''}\n  `;\n  const msgs = document.getElementById('chatMessages');\n  msgs.appendChild(div);\n  msgs.scrollTop = msgs.scrollHeight;\n}\n\n\/\/ ═══════════════════════════════════════════════════\n\/\/ CHECK USER\n\/\/ ═══════════════════════════════════════════════════\nconst USERS = [\n  {name:'Hiroshi Tanaka',detail:'UUID: a8f2e1b4',status:'active',  avatar:'👤',bg:'rgba(74,222,128,0.1)'},\n  {name:'Yuki Sakamoto',detail:'UUID: c3d9f2a1',status:'trial',   avatar:'🌸',bg:'rgba(255,209,102,0.1)'},\n  {name:'Carlos Silva',  detail:'UUID: 7b2e9c5d',status:'expired', avatar:'👤',bg:'rgba(224,27,60,0.1)'},\n  {name:'Admin Root',    detail:'UUID: 0000-root',status:'active', avatar:'⚔️',bg:'rgba(184,41,255,0.1)'},\n];\nfunction populateUsers(list){\n  document.getElementById('userResults').innerHTML = list.map(u=>`\n    <div class=\"user-card\">\n      <div class=\"user-avatar\" style=\"background:${u.bg};\">${u.avatar}<\/div>\n      <div class=\"user-info\">\n        <div class=\"user-name\">${u.name}<\/div>\n        <div class=\"user-detail\">${u.detail}<\/div>\n      <\/div>\n      <div class=\"user-status-badge ustatus-${u.status}\">${u.status==='active'?'ATIVO':u.status==='trial'?'TRIAL':'EXPIRADO'}<\/div>\n    <\/div>\n  `).join('');\n}\nfunction searchUser(){\n  const q = document.getElementById('checkUserInput').value.trim().toLowerCase();\n  const res = q ? USERS.filter(u=>u.name.toLowerCase().includes(q)||u.detail.includes(q)) : USERS;\n  populateUsers(res);\n  if(!res.length) document.getElementById('userResults').innerHTML = '<div style=\"text-align:center;color:var(--text-muted);padding:20px\">Nenhum usuário encontrado<\/div>';\n}\npopulateUsers(USERS);\n\n\/\/ ═══════════════════════════════════════════════════\n\/\/ THEME\n\/\/ ═══════════════════════════════════════════════════\nfunction setTheme(theme, el){\n  document.documentElement.setAttribute('data-theme', theme);\n  document.querySelectorAll('.theme-swatch').forEach(s=>s.classList.remove('active'));\n  el.classList.add('active');\n  showToast(`Tema aplicado: ${theme}`,'success');\n}\nfunction setAccentColor(color){\n  document.documentElement.style.setProperty('--crimson', color);\n  const r = parseInt(color.slice(1,3),16), g=parseInt(color.slice(3,5),16), b=parseInt(color.slice(5,7),16);\n  document.documentElement.style.setProperty('--crimson-glow', `rgba(${r},${g},${b},0.4)`);\n  document.documentElement.style.setProperty('--crimson-deep', `rgb(${Math.round(r*0.7)},${Math.round(g*0.7)},${Math.round(b*0.7)})`);\n}\n\n\/\/ ═══════════════════════════════════════════════════\n\/\/ UPDATE\n\/\/ ═══════════════════════════════════════════════════\nfunction doUpdate(){\n  let p = 0;\n  const prog = document.getElementById('updateProgress');\n  const phases = ['Baixando pacote...','Verificando integridade...','Instalando...','Finalizando...'];\n  let phase = 0;\n  const t = setInterval(()=>{\n    p += 2 + Math.random()*3;\n    if(p>100) p=100;\n    prog.style.width = p+'%';\n    const newPhase = Math.floor((p\/100)*phases.length);\n    if(newPhase!==phase&&newPhase<phases.length){\n      phase=newPhase;\n      showToast(phases[phase],'info',2000);\n    }\n    if(p>=100){\n      clearInterval(t);\n      closeModal('updateModal');\n      showToast('Atualização instalada com sucesso! 🎉','success',4000);\n    }\n  }, 80);\n}\n\n\/\/ ═══════════════════════════════════════════════════\n\/\/ NOTIFICATIONS\n\/\/ ═══════════════════════════════════════════════════\nconst NOTIFS = [\n  {icon:'fa-bolt',       color:'var(--crimson)', title:'Novo servidor disponível',   time:'2 min atrás', text:'br03.yumeko.net está agora online'},\n  {icon:'fa-shield-check',color:'#4ade80',       title:'Verificação de segurança OK', time:'15 min atrás',text:'Todos os protocolos funcionando'},\n  {icon:'fa-circle-up', color:'var(--gold)',     title:'Atualização disponível',      time:'1h atrás',    text:'Versão 3.0.0 disponível para download'},\n  {icon:'fa-wifi',      color:'var(--cyan-edge)',title:'Servidor otimizado',          time:'3h atrás',    text:'Latência reduzida em 30%'},\n];\ndocument.getElementById('notifList').innerHTML = NOTIFS.map(n=>`\n  <div style=\"display:flex;align-items:flex-start;gap:12px;padding:12px;border-radius:var(--radius-md);background:var(--glass);border:1px solid var(--glass-border)\">\n    <div style=\"width:36px;height:36px;border-radius:10px;background:${n.color}22;display:flex;align-items:center;justify-content:center;flex-shrink:0\">\n      <i class=\"fa-solid ${n.icon}\" style=\"color:${n.color}\"><\/i>\n    <\/div>\n    <div style=\"flex:1\">\n      <div style=\"font-weight:700;font-size:0.88rem\">${n.title}<\/div>\n      <div style=\"font-size:0.75rem;color:var(--text-muted);margin-top:2px\">${n.text}<\/div>\n      <div style=\"font-size:0.68rem;color:var(--text-dim);margin-top:4px\">${n.time}<\/div>\n    <\/div>\n  <\/div>\n`).join('');\n\n\/\/ ═══════════════════════════════════════════════════\n\/\/ WELCOME TOAST\n\/\/ ═══════════════════════════════════════════════════\nsetTimeout(()=>showToast('Yumeko BK carregado! ⚔️ 由夢子','success',3500),500);\n<\/script>\n<\/body>\n<\/html>@"
}
