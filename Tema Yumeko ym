radius:99px;overflow:hidden;margin:8px 0;}\n.pb2{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--red),var(--sakura));transition:width 1s ease;}\n\n\/* LOGS & CHAT *\/\n.lbox{height:250px;overflow-y:auto;padding:10px;display:flex;flex-direction:column;gap:4px;background:rgba(0,0,0,.3);border-radius:var(--r-md);border:1px solid var(--gb);font-family:'Courier New',monospace;font-size:.7rem;}\n.le{display:flex;align-items:flex-start;gap:6px;padding:4px 6px;border-radius:4px;border-left:2px solid transparent;}\n.chat{display:flex;flex-direction:column;height:400px;border-radius:var(--r-lg);overflow:hidden;border:1px solid var(--gb);background:var(--glass);}\n.chdr{padding:10px 14px;border-bottom:1px solid var(--gb);display:flex;align-items:center;gap:8px;}\n.cav{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--red),var(--purple));display:flex;align-items:center;justify-content:center;font-size:.8rem;}\n.cmsgs{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px;}\n.msg{display:flex;gap:6px;max-width:85%;}\n.mbbl{padding:8px 12px;border-radius:12px;font-size:.8rem;line-height:1.4;}\n\n\/* SETTINGS *\/\n.sgrid{display:grid;grid-template-columns:1fr;gap:10px;}\n@media(min-width:600px){.sgrid{grid-template-columns:repeat(2,1fr)}}\n.ssec{padding:14px;}\n.ssec h4{font-family:var(--ft);font-size:.75rem;letter-spacing:.05em;color:var(--red);margin-bottom:10px;padding-bottom:5px;border-bottom:1px solid var(--gb);}\n.srow{display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:1px solid rgba(255,255,255,.04);}\n.slbll{font-size:.8rem;color:var(--txt);}\n.sdesc{font-size:.65rem;color:var(--muted);margin-top:1px;}\n.tgl{position:relative;width:40px;height:20px;}\n.tgl input{opacity:0;width:0;height:0;}\n.tslider{position:absolute;inset:0;background:rgba(255,255,255,.1);border-radius:99px;cursor:pointer;transition:var(--tr);border:1px solid var(--gb);}\n.tslider::before{content:'';position:absolute;left:2px;top:2px;width:14px;height:14px;background:var(--muted);border-radius:50%;transition:var(--tr);}\n.tgl input:checked+.tslider{background:var(--red);border-color:var(--red);}\n.tgl input:checked+.tslider::before{transform:translateX(20px);background:#fff;}\n.tgrid{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;}\n.tsw{width:36px;height:36px;border-radius:9px;cursor:pointer;border:2px solid transparent;transition:var(--tr);}\n.tsw:hover,.tsw.active{border-color:#fff;transform:scale(1.1);}\n.t-dk{background:linear-gradient(135deg,#0a0608,#e01b3c);}\n.t-lt{background:linear-gradient(135deg,#fdf0f2,#e01b3c);}\n.t-sk{background:linear-gradient(135deg,#1a0a12,#ff6b8a);}\n.t-cy{background:linear-gradient(135deg,#000d1a,#00f5ff);}\n.t-ob{background:linear-gradient(135deg,#050505,#c0c0c0);}\n.sinp2{background:var(--glass);border:1px solid var(--gb);border-radius:6px;padding:5px 9px;color:var(--txt);font-family:var(--fb);font-size:.8rem;outline:none;}\n.btn-save{margin-top:10px;padding:8px 20px;border-radius:8px;border:none;background:linear-gradient(135deg,var(--red),var(--red-deep));color:#fff;font-family:var(--ft);font-size:.75rem;font-weight:700;cursor:pointer;box-shadow:0 0 10px var(--red-glow);}\n\n\/* COMMONS *\/\n.shdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:5px;}\n.stitle{font-family:var(--ft);font-size:.8rem;letter-spacing:.05em;display:flex;align-items:center;gap:6px;}\n.stitle::before{content:'';width:3px;height:12px;background:var(--red);border-radius:2px;}\n.mb16{margin-bottom:12px;}\n.cf{display:flex;flex-direction:column;gap:3px;margin-bottom:6px;}\n.cf label{font-size:.65rem;color:var(--muted);text-transform:uppercase;}\n.cf input{background:rgba(0,0,0,.3);border:1px solid var(--gb);border-radius:var(--r-sm);padding:6px 9px;color:var(--txt);font-family:monospace;font-size:.8rem;}\n\n\/* MODALS & TOASTS (Compact) *\/\n.mov{position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.72);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .3s ease;padding:10px;}\n.mov.open{opacity:1;pointer-events:all;}\n.modal{width:100%;max-width:400px;max-height:85vh;overflow-y:auto;padding:20px;position:relative;}\n.tcts{position:fixed;top:14px;right:14px;z-index:2000;display:flex;flex-direction:column;gap:6px;pointer-events:none;}\n.tst{padding:8px 12px;border-radius:8px;background:var(--card);backdrop-filter:blur(20px);border:1px solid var(--gb);font-size:.75rem;font-weight:600;display:flex;align-items:center;gap:8px;pointer-events:all;box-shadow:0 6px 20px rgba(0,0,0,.4);max-width:260px;}\n<\/style>\n<\/head>\n<body>\n<div id=\"ptc\"><\/div>\n<div class=\"tcts\" id=\"TC\"><\/div>\n\n<!-- ══ MODALS (Mantidos e otimizados) ══ -->\n<div class=\"mov\" id=\"mCU\"><div class=\"modal glass\"><div class=\"shdr mb16\"><span class=\"stitle\"><i class=\"fa-solid fa-user-check\" style=\"color:var(--red);margin-right:6px\"><\/i>CHECK USER<\/span><button class=\"ibt\" onclick=\"closeMod('mCU')\"><i class=\"fa-solid fa-xmark\"><\/i><\/button><\/div><div id=\"cuModal\" style=\"text-align:center;color:var(--muted);padding:10px\">Conecte-se para ver dados<\/div><\/div><\/div>\n<div class=\"mov\" id=\"mUP\"><div class=\"modal glass\"><div class=\"shdr mb16\"><span class=\"stitle\"><i class=\"fa-solid fa-rotate\" style=\"color:var(--gold);margin-right:6px\"><\/i>ATUALIZAÇÃO<\/span><button class=\"ibt\" onclick=\"closeMod('mUP')\"><i class=\"fa-solid fa-xmark\"><\/i><\/button><\/div><div style=\"font-size:.8rem;color:var(--muted);margin-bottom:10px\" id=\"upDesc\">Verificando...<\/div><button class=\"btn-save\" style=\"width:100%\" onclick=\"doCheckUpdate()\">VERIFICAR<\/button><\/div><\/div>\n<div class=\"mov\" id=\"mNT\"><div class=\"modal glass\"><div class=\"shdr mb16\"><span class=\"stitle\"><i class=\"fa-solid fa-bell\" style=\"color:var(--red);margin-right:6px\"><\/i>NOTIFICAÇÕES<\/span><button class=\"ibt\" onclick=\"closeMod('mNT')\"><i class=\"fa-solid fa-xmark\"><\/i><\/button><\/div><div id=\"notifList\" style=\"display:flex;flex-direction:column;gap:6px;\"><\/div><\/div><\/div>\n\n<!-- ══ WRAPPER ══ -->\n<div class=\"wrap\">\n  <header class=\"hdr\">\n    <div class=\"logo\">\n      <div class=\"logo-icon\">⚔️<\/div>\n      <div>\n        <div class=\"logo-name\">YUMEKO BK<\/div>\n        <div class=\"logo-sub\">由夢子 · 次世代接続<\/div>\n      <\/div>\n    <\/div>\n    <div style=\"display:flex;align-items:center;gap:8px;\">\n      <div class=\"clock\"><span id=\"clk\">--:--:--<\/span><span id=\"clkd\">---<\/span><\/div>\n      <div class=\"hbts\">\n        <button class=\"ibt\" onclick=\"openMod('mNT')\" title=\"Notificações\"><i class=\"fa-solid fa-bell\"><\/i><span class=\"ndot\"><\/span><\/button>\n        <button class=\"ibt\" onclick=\"A.openServers()\" title=\"Servidores Nativos\"><i class=\"fa-solid fa-server\"><\/i><\/button>\n      <\/div>\n    <\/div>\n  <\/header>\n  <div class=\"badges mb16\">\n    <span class=\"badge b-app\" id=\"badgeApp\">App —<\/span>\n    <span class=\"badge b-json\" id=\"badgeJson\">JSON —<\/span>\n    <span class=\"badge b-live\" id=\"badgeLive\">● LIVE<\/span>\n    <span class=\"badge b-free\" id=\"badgeTier\" style=\"display:none\">FREE<\/span>\n  <\/div>\n\n  <main>\n    <!-- ▸ CONNECT -->\n    <div class=\"tp active\" id=\"tab-connect\">\n      <div class=\"hero glass mb16\">\n        <div class=\"ring-wrap\">\n          <div class=\"ring\">\n            <svg class=\"rsvg\" viewBox=\"0 0 130 130\">\n              <defs><linearGradient id=\"rg\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\"><stop offset=\"0%\" style=\"stop-color:var(--red)\"\/><stop offset=\"100%\" style=\"stop-color:var(--sakura)\"\/><\/linearGradient><\/defs>\n              <circle cx=\"65\" cy=\"65\" r=\"60\" fill=\"none\" stroke=\"var(--gb)\" stroke-width=\"1.5\"\/>\n              <circle cx=\"65\" cy=\"65\" r=\"60\" fill=\"none\" stroke=\"url(#rg)\" stroke-width=\"1.5\" stroke-dasharray=\"6 12\"\/>\n            <\/svg>\n            <div class=\"rinner\">\n              <span class=\"rstatus-icon\" id=\"stIcon\">🔴<\/span>\n              <span class=\"rstatus-txt\" id=\"stTxt\" style=\"color:var(--muted)\">OFFLINE<\/span>\n            <\/div>\n          <\/div>\n        <\/div>\n\n        <div class=\"free-bar\" id=\"freeBar\">\n          <div class=\"free-bar-label\"><i class=\"fa-solid fa-clock\"><\/i> TEMPO RESTANTE<\/div>\n          <div class=\"free-bar-wrap\"><div class=\"free-bar-fill\" id=\"freeBarFill\" style=\"width:0%\"><\/div><\/div>\n          <div class=\"free-bar-time\" id=\"freeBarTime\">--:--:--<\/div>\n        <\/div>\n        <button class=\"btn-ad\" id=\"btnAd\" onclick=\"doWatchAd()\"><i class=\"fa-solid fa-play-circle\"><\/i> ASSISTIR (+2h)<\/button>\n\n        <div class=\"cbwrap\">\n          <div class=\"cbglow\"><\/div>\n          <button class=\"cbtn\" id=\"cbtn\" onclick=\"toggleConnect()\">\n            <i class=\"fa-solid fa-bolt\" id=\"cbtnIco\" style=\"margin-right:6px\"><\/i>\n            <span id=\"cbtnLbl\">CONECTAR<\/span>\n          <\/button>\n        <\/div>\n\n        <div class=\"schips\">\n          <div class=\"schip\"><div class=\"dot dr\" id=\"stDot\"><\/div><span id=\"stChipLbl\">Desconectado<\/span><\/div>\n          <div class=\"schip\"><div class=\"dot dgr\" id=\"pingDot\"><\/div><span id=\"pingLbl\">Ping: —<\/span><\/div>\n          <div class=\"schip\"><i class=\"fa-solid fa-clock\" style=\"font-size:.55rem;color:var(--dim)\"><\/i><span id=\"timerLbl\">00:00:00<\/span><\/div>\n        <\/div>\n\n        <div class=\"cu-inline\" id=\"cuInline\">\n          <div style=\"font-family:var(--ft);font-size:.65rem;color:var(--muted);margin-bottom:8px;\">DADOS DO USUÁRIO<\/div>\n          <div class=\"cu-grid\">\n            <div class=\"cu-item\"><div class=\"cli\">Usuário<\/div><div class=\"clv\" id=\"cu_user\">—<\/div><\/div>\n            <div class=\"cu-item\"><div class=\"cli\">Dias<\/div><div class=\"clv\" id=\"cu_days\">—<\/div><\/div>\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"g4 mb16\">\n        <div class=\"sc glass\">\n          <div class=\"sico si-r\"><i class=\"fa-solid fa-arrow-down\"><\/i><\/div>\n          <div class=\"slbl\">Download<\/div><div class=\"sval\" id=\"dlSt\">—<\/div><div class=\"ssub\">MB\/s<\/div>\n        <\/div>\n        <div class=\"sc glass\">\n          <div class=\"sico si-c\"><i class=\"fa-solid fa-arrow-up\"><\/i><\/div>\n          <div class=\"slbl\">Upload<\/div><div class=\"sval\" id=\"ulSt\">—<\/div><div class=\"ssub\">MB\/s<\/div>\n        <\/div>\n      <\/div>\n\n      <div class=\"glass\" style=\"padding:12px\">\n        <div class=\"shdr\">\n          <span class=\"stitle\">Servidor Ativo<\/span>\n          <span style=\"font-size:.7rem;color:var(--red);cursor:pointer;\" onclick=\"goTab('servers',document.querySelectorAll('.nt')[1])\">Trocar →<\/span>\n        <\/div>\n        <div class=\"srv sel\" style=\"padding:8px\">\n          <div id=\"activeFlagWrap\"><span class=\"sflag-emoji\" id=\"activeFlagEmoji\">🏳️<\/span><\/div>\n          <div class=\"sinfo\"><div class=\"sname\" id=\"activeSrvName\">Carregando...<\/div><div class=\"shost\" id=\"activeSrvInfo\">—<\/div><\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <!-- ▸ SERVERS -->\n    <div class=\"tp\" id=\"tab-servers\">\n      <div class=\"glass\" style=\"padding:14px\">\n        <div class=\"shdr mb16\">\n          <span class=\"stitle\">Servidores<\/span>\n          <div style=\"display:flex;gap:5px;\">\n            <input type=\"text\" class=\"sinp2\" placeholder=\"Buscar...\" style=\"width:110px\" oninput=\"filterSrv(this.value)\"\/>\n            <button class=\"ibt\" onclick=\"loadServers()\"><i class=\"fa-solid fa-arrows-rotate\"><\/i><\/button>\n          <\/div>\n        <\/div>\n        <div class=\"stabs\">\n          <button class=\"stab active\" onclick=\"switchSrvTab('normal',this)\">Operadoras<\/button>\n          <button class=\"stab\" onclick=\"switchSrvTab('multi',this)\">Premium<\/button>\n        <\/div>\n        <div class=\"slist\" id=\"srvList\"><div class=\"sempty\"><i class=\"fa-solid fa-spinner fa-spin\"><\/i><\/div><\/div>\n      <\/div>\n    <\/div>\n\n    <!-- ▸ SPEED -->\n    <div class=\"tp\" id=\"tab-speed\">\n      <div class=\"spcard glass\">\n        <div class=\"stitle\" style=\"justify-content:center;margin-bottom:4px\">VELOCIDADE<\/div>\n        <div style=\"color:var(--muted);font-size:.7rem;text-align:center\">Meça em tempo real<\/div>\n        <div class=\"gwrap\">\n          <div class=\"gi\">\n            <div class=\"gauge\">\n              <svg class=\"gsvg\" viewBox=\"0 0 100 100\">\n                <defs><linearGradient id=\"dlG\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\"><stop offset=\"0%\" style=\"stop-color:var(--red)\"\/><stop offset=\"100%\" style=\"stop-color:var(--sakura)\"\/><\/linearGradient><\/defs>\n                <circle class=\"gtrack\" cx=\"50\" cy=\"50\" r=\"42\"\/>\n                <circle class=\"gfill\" id=\"dlGF\" cx=\"50\" cy=\"50\" r=\"42\" stroke=\"url(#dlG)\" stroke-dasharray=\"264\" stroke-dashoffset=\"264\"\/>\n              <\/svg>\n              <div class=\"gctr\"><div class=\"gv\" id=\"dlGV\" style=\"color:var(--red)\">0<\/div><div class=\"gu\">Mbps<\/div><\/div>\n            <\/div>\n            <div class=\"glbl\"><i class=\"fa-solid fa-arrow-down\" style=\"color:var(--red);margin-right:4px\"><\/i>Download<\/div>\n          <\/div>\n        <\/div>\n        <button class=\"spbtn\" id=\"spBtn\" onclick=\"runSpeed()\"><i class=\"fa-solid fa-gauge-high\" style=\"margin-right:6px\"><\/i>INICIAR<\/button>\n        <div class=\"sstats\" style=\"margin-top:20px\">\n          <div class=\"sst\"><div class=\"sstv\" id=\"spPing\">—<\/div><div class=\"sstl\">Ping<\/div><\/div>\n          <div class=\"sst\"><div class=\"sstv\" id=\"spLoss\">—<\/div><div class=\"sstl\">Perda<\/div><\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <!-- ▸ LOGS & CHAT (Combinados em uma tela compacta) -->\n    <div class=\"tp\" id=\"tab-logs\">\n      <div class=\"glass mb16\" style=\"padding:14px\">\n        <div class=\"shdr\"><span class=\"stitle\">REGISTROS<\/span>\n          <div>\n            <button class=\"ibt\" onclick=\"loadLogsFromApp()\"><i class=\"fa-solid fa-refresh\"><\/i><\/button>\n            <button class=\"ibt\" onclick=\"doAndroidClearLogs()\"><i class=\"fa-solid fa-trash\"><\/i><\/button>\n          <\/div>\n        <\/div>\n        <div class=\"lbox\" id=\"lbox\"><\/div>\n      <\/div>\n      <div class=\"chat\">\n        <div class=\"chdr\">\n          <div class=\"cav\">🌸<\/div>\n          <div><div class=\"stitle\" style=\"margin-bottom:0\">Suporte<\/div><div style=\"font-size:.6rem;color:var(--muted)\">Online<\/div><\/div>\n          <button class=\"ibt\" style=\"margin-left:auto\" onclick=\"A.openChat()\"><i class=\"fa-solid fa-arrow-up-right-from-square\"><\/i><\/button>\n        <\/div>\n        <div class=\"cmsgs\" id=\"cmsgs\"><div class=\"msg received\"><div class=\"mbbl\">Bem-vindo! ⚔️<\/div><\/div><\/div>\n        <div style=\"padding:8px;border-top:1px solid var(--gb);display:flex;gap:6px\">\n          <input type=\"text\" class=\"sinp2\" style=\"flex:1;border-radius:99px\" id=\"cinp\" placeholder=\"Mensagem...\" onkeydown=\"if(event.key==='Enter')sendChat()\"\/>\n          <button class=\"ibt\" style=\"border-radius:50%;background:var(--red);color:#fff\" onclick=\"sendChat()\"><i class=\"fa-solid fa-paper-plane\"><\/i><\/button>\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <!-- ▸ SETTINGS -->\n    <div class=\"tp\" id=\"tab-settings\">\n      <div class=\"glass mb16\" style=\"padding:14px\">\n        <div class=\"stitle mb16\">TEMA & CORES<\/div>\n        <div class=\"tgrid mb16\">\n          <div class=\"tsw t-dk\" title=\"Dark\" onclick=\"setTheme('dark',this)\"><\/div>\n          <div class=\"tsw t-lt\" title=\"Light\" onclick=\"setTheme('light',this)\"><\/div>\n          <div class=\"tsw t-sk\" title=\"Sakura\" onclick=\"setTheme('sakura',this)\"><\/div>\n          <div class=\"tsw t-cy\" title=\"Cyber\" onclick=\"setTheme('cyber',this)\"><\/div>\n          <div class=\"tsw t-ob\" title=\"Obsidian\" onclick=\"setTheme('obsidian',this)\"><\/div>\n        <\/div>\n        <div class=\"srow\">\n          <div class=\"slbll\">Cor Principal<\/div>\n          <input type=\"color\" id=\"colorPicker\" value=\"#e01b3c\" style=\"background:none;border:none;cursor:pointer;width:34px;height:26px;padding:0;border-radius:6px\" onchange=\"setAccent(this.value)\"\/>\n        <\/div>\n      <\/div>\n\n      <div class=\"sgrid\">\n        <div class=\"ssec glass\">\n          <h4><i class=\"fa-solid fa-shield-halved\" style=\"margin-right:5px\"><\/i>VPN & REDE<\/h4>\n          <div class=\"srow\"><div><div class=\"slbll\">Auto Reconexão<\/div><\/div><label class=\"tgl\"><input type=\"checkbox\" checked\/><span class=\"tslider\"><\/span><\/label><\/div>\n          <div class=\"srow\"><div><div class=\"slbll\">Obfuscação<\/div><\/div><label class=\"tgl\"><input type=\"checkbox\" checked\/><span class=\"tslider\"><\/span><\/label><\/div>\n        <\/div>\n        <div class=\"ssec glass\">\n          <h4><i class=\"fa-solid fa-key\" style=\"margin-right:5px\"><\/i>CREDENCIAIS<\/h4>\n          <div class=\"cf\"><label>Usuário<\/label><input type=\"text\" id=\"credUser\" placeholder=\"usuario\"\/><\/div>\n          <div class=\"cf\"><label>Senha<\/label><input type=\"password\" id=\"credPass\" placeholder=\"••••••\"\/><\/div>\n          <button class=\"btn-save\" style=\"width:100%\" onclick=\"saveCreds()\"><i class=\"fa-solid fa-floppy-disk\" style=\"margin-right:5px\"><\/i>SALVAR<\/button>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/main>\n\n  <!-- BOTTOM NAVIGATION -->\n  <nav class=\"nav\">\n    <button class=\"nt active\" onclick=\"goTab('connect',this)\"><i class=\"fa-solid fa-bolt\"><\/i>Início<\/button>\n    <button class=\"nt\" onclick=\"goTab('servers',this)\"><i class=\"fa-solid fa-server\"><\/i>Servidor<\/button>\n    <button class=\"nt\" onclick=\"goTab('speed',this)\"><i class=\"fa-solid fa-gauge-high\"><\/i>Speed<\/button>\n    <button class=\"nt\" onclick=\"goTab('logs',this)\"><i class=\"fa-solid fa-terminal\"><\/i>Logs<\/button>\n    <button class=\"nt\" onclick=\"goTab('settings',this)\"><i class=\"fa-solid fa-sliders\"><\/i>Ajustes<\/button>\n  <\/nav>\n\n<\/div>\n\n<script>\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ BRIDGE (MANTIDO INTACTO)\n\/\/ ═══════════════════════════════════════════════════════\nconst A = {\n  _c(fn,...args){ try{ if(window.Android&&typeof window.Android[fn]==='function') return window.Android[fn](...args); }catch(e){} return null; },\n  connect(){ this._c('connect'); }, getStatus(){ return this._c('getStatus')||'DESCONECTADO'; },\n  getServers(){ try{return JSON.parse(this._c('getServers')||'[]');}catch(e){return[];} },\n  getSelectedServer(){ try{return JSON.parse(this._c('getSelectedServer')||'{}');}catch(e){return{};} },\n  selectServer(i){ this._c('selectServer',i); },\n  getMultiServers(){ try{return JSON.parse(this._c('getMultiServers')||'[]');}catch(e){return[];} },\n  getSelectedMultiServer(){ try{return JSON.parse(this._c('getSelectedMultiServer')||'{}');}catch(e){return{};} },\n  selectMultiServer(i){ this._c('selectMultiServer',i); },\n  getVersion(){ return this._c('getVersion')||'—'; }, getNote(){ return this._c('getNote')||''; },\n  getLogs(){ try{return JSON.parse(this._c('getLogs')||'[]');}catch(e){return[];} },\n  clearLogs(){ this._c('clearLogs'); }, checkUpdate(){ this._c('checkUpdate'); },\n  isAdsEnabled(){ const r=this._c('isAdsEnabled'); return r===null?false:!!r; },\n  getTimeLeft(){ return Number(this._c('getTimeLeft')||0); }, watchAd(){ this._c('watchAd'); },\n  openChat(){ this._c('openChat'); }, openServers(){ this._c('openServers'); },\n  requestInterstitial(){ this._c('requestInterstitial'); },\n  saveCredentials(u,p,udp,v2,xr){ this._c('saveCredentials',u,p,udp,v2,xr); },\n  getSavedCredentials(){ try{return JSON.parse(this._c('getSavedCredentials')||'{}');}catch(e){return{};} },\n  getFullConfig(){ try{return JSON.parse(this._c('getFullConfig')||'{}');}catch(e){return{};} },\n};\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ UI & THEME (LOCALSTORAGE SALVAMENTO ADICIONADO)\n\/\/ ═══════════════════════════════════════════════════════\nfunction setTheme(t, el){\n  document.documentElement.setAttribute('data-theme', t);\n  localStorage.setItem('yumeko_theme', t); \/\/ SALVA O TEMA\n  document.querySelectorAll('.tsw').forEach(s=>s.classList.remove('active'));\n  if(el) {\n    el.classList.add('active');\n  } else {\n    \/\/ Tenta encontrar o botão certo se chamado via carregamento\n    const btn = document.querySelector(`.tsw[onclick*=\"'${t}'\"]`);\n    if(btn) btn.classList.add('active');\n  }\n}\n\nfunction setAccent(c){\n  localStorage.setItem('yumeko_accent', c); \/\/ SALVA A COR\n  document.documentElement.style.setProperty('--red', c);\n  const r=parseInt(c.slice(1,3),16),g=parseInt(c.slice(3,5),16),b=parseInt(c.slice(5,7),16);\n  document.documentElement.style.setProperty('--red-glow',`rgba(${r},${g},${b},.4)`);\n  document.documentElement.style.setProperty('--red-deep',`rgb(${Math.round(r*.65)},${Math.round(g*.65)},${Math.round(b*.65)})`);\n}\n\nfunction loadSavedTheme(){\n  const savedTheme = localStorage.getItem('yumeko_theme');\n  const savedAccent = localStorage.getItem('yumeko_accent');\n  if(savedTheme) setTheme(savedTheme, null);\n  else setTheme('dark', document.querySelector('.t-dk')); \/\/ default\n  \n  if(savedAccent) {\n    setAccent(savedAccent);\n    document.getElementById('colorPicker').value = savedAccent;\n  }\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ CLOCK & PARTICLES\n\/\/ ═══════════════════════════════════════════════════════\n(()=>{\n  const c=document.getElementById('ptc'); const cols=['var(--red)','var(--sakura)','var(--gold)','var(--cyan)'];\n  for(let i=0;i<20;i++){ \/\/ Reduzido de 35 para 20 (melhora a performance mobile)\n    const p=document.createElement('div'); p.className='pt';\n    p.style.cssText=`left:${Math.random()*100}%;animation-duration:${6+Math.random()*12}s;animation-delay:${Math.random()*12}s;background:${cols[i%4]};width:${1+Math.random()*3}px;height:${1+Math.random()*3}px;`;\n    c.appendChild(p);\n  }\n})();\nfunction tickClock(){\n  const n=new Date(),p=v=>String(v).padStart(2,'0');\n  document.getElementById('clk').textContent=`${p(n.getHours())}:${p(n.getMinutes())}:${p(n.getSeconds())}`;\n}\nsetInterval(tickClock,1000); tickClock();\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ NAVEGAÇÃO \/ TABS\n\/\/ ═══════════════════════════════════════════════════════\nfunction goTab(id,btn){\n  document.querySelectorAll('.tp').forEach(p=>p.classList.remove('active'));\n  document.querySelectorAll('.nt').forEach(b=>b.classList.remove('active'));\n  document.getElementById('tab-'+id).classList.add('active');\n  if(btn) btn.classList.add('active');\n  if(id==='logs') loadLogsFromApp();\n  if(id==='servers') loadServers();\n  window.scrollTo({top:0, behavior:'smooth'}); \/\/ Sobe a tela ao trocar de aba\n}\nfunction toast(msg,type='in',dur=3000){\n  const cols={ok:'var(--green)',er:'var(--red)',in:'var(--cyan)',wn:'var(--gold)'};\n  const t=document.createElement('div'); t.className=`tst tst-${type}`;\n  t.innerHTML=`<i class=\"fa-solid fa-circle-info\" style=\"color:${cols[type]||cols.in}\"><\/i>${msg}`;\n  document.getElementById('TC').appendChild(t);\n  setTimeout(()=>{t.style.opacity='0';setTimeout(()=>t.remove(),300);},dur);\n}\nfunction openMod(id){ document.getElementById(id).classList.add('open'); }\nfunction closeMod(id){ document.getElementById(id).classList.remove('open'); }\ndocument.querySelectorAll('.mov').forEach(m=>m.addEventListener('click',e=>{ if(e.target===m) m.classList.remove('open'); }));\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ CALLBACKS VPN\n\/\/ ═══════════════════════════════════════════════════════\nlet connTimerInt=null, connSeconds=0, trafficSim=null;\nwindow.onVpnStatus = function(state, detail){ updateStatusUI(state, detail||''); };\nwindow.onLogAdded = function(entry){ pushLog(entry); };\nwindow.onLogsCleared = function(){ allLogs=[]; renderLogs(); };\nwindow.onServerChanged = function(){ loadActiveServer(); };\nwindow.onConfigUpdated = function(version){ loadFromAndroid(); toast(`Config atualizado → v${version}`,'ok'); };\nwindow.onCheckUserReceived = function(data){ updateCheckUser(data); };\nwindow.onTimeAdded = function(timeLeft){ updateFreeTierUI(timeLeft); };\n\nconst STATE_MAP = {\n  'CONECTADO':    {icon:'🟢',txt:'CONECTADO',   chip:'Conectado', cls:'connected', ico:'circle-stop', lbl:'DESCONECTAR', dot:'dg'},\n  'DESCONECTADO': {icon:'🔴',txt:'OFFLINE',     chip:'Desconectado', cls:'',       ico:'bolt',        lbl:'CONECTAR',    dot:'dr'},\n  'CONECTANDO':   {icon:'🟡',txt:'CONECTANDO',  chip:'Conectando...',cls:'connecting',ico:'spinner fa-spin',lbl:'AGUARDE...',dot:'dy'}\n};\n\nfunction updateStatusUI(state, detail){\n  const s = STATE_MAP[state] || STATE_MAP['CONECTANDO'];\n  document.getElementById('stIcon').textContent = s.icon;\n  document.getElementById('stTxt').textContent  = s.txt;\n  document.getElementById('stTxt').style.color  = s.dot==='dg'?'var(--green)':s.dot==='dy'?'var(--gold)':'var(--muted)';\n  document.getElementById('stChipLbl').textContent = s.chip;\n  document.getElementById('stDot').className = 'dot '+s.dot;\n  const btn = document.getElementById('cbtn');\n  btn.className = 'cbtn '+(s.cls||'');\n  document.getElementById('cbtnIco').className = `fa-solid fa-${s.ico}`;\n  document.getElementById('cbtnLbl').textContent = s.lbl;\n\n  if(state==='CONECTADO'){\n    document.getElementById('pingDot').className='dot dg';\n    document.getElementById('badgeLive').textContent='● CONECTADO';\n    startConnTimer(); startTrafficSim(); loadActiveServer();\n  } else if(state==='DESCONECTADO'){\n    stopConnTimer(); clearInterval(trafficSim);\n    document.getElementById('badgeLive').textContent='● LIVE';\n    document.getElementById('dlSt').textContent='—';\n    document.getElementById('ulSt').textContent='—';\n    document.getElementById('pingDot').className='dot dgr';\n    document.getElementById('pingLbl').textContent='Ping: —';\n    document.getElementById('cuInline').classList.remove('show');\n  }\n}\nfunction toggleConnect(){ A.connect(); if(A.getStatus()==='DESCONECTADO') updateStatusUI('CONECTANDO',''); }\nfunction startConnTimer(){\n  connSeconds=0; clearInterval(connTimerInt);\n  connTimerInt=setInterval(()=>{\n    connSeconds++;\n    const h=Math.floor(connSeconds\/3600),m=Math.floor((connSeconds%3600)\/60),s=connSeconds%60;\n    const p=v=>String(v).padStart(2,'0');\n    document.getElementById('timerLbl').textContent=`${p(h)}:${p(m)}:${p(s)}`;\n  },1000);\n}\nfunction stopConnTimer(){ clearInterval(connTimerInt); document.getElementById('timerLbl').textContent='00:00:00'; }\nfunction startTrafficSim(){\n  clearInterval(trafficSim);\n  trafficSim=setInterval(()=>{\n    document.getElementById('dlSt').textContent=(0.3+Math.random()*6).toFixed(1);\n    document.getElementById('ulSt').textContent=(0.05+Math.random()*1.5).toFixed(1);\n    document.getElementById('pingLbl').textContent='Ping: '+Math.floor(14+Math.random()*55)+'ms';\n  },1500);\n}\nfunction updateFreeTierUI(timeLeftMs){\n  if(!A.isAdsEnabled()){\n    document.getElementById('freeBar').classList.remove('show'); document.getElementById('btnAd').classList.remove('show');\n    document.getElementById('badgeTier').style.display='none'; return;\n  }\n  document.getElementById('badgeTier').style.display='inline';\n  if(timeLeftMs>0){\n    document.getElementById('freeBar').classList.add('show');\n    document.getElementById('freeBarFill').style.width=Math.min((timeLeftMs\/(2*3600000))*100,100)+'%';\n    const h=Math.floor(timeLeftMs\/3600000),m=Math.floor((timeLeftMs%3600000)\/60000),s=Math.floor((timeLeftMs%60000)\/1000);\n    document.getElementById('freeBarTime').textContent=`${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;\n    document.getElementById('btnAd').classList.remove('show');\n  } else {\n    document.getElementById('freeBar').classList.remove('show'); document.getElementById('btnAd').classList.add('show');\n  }\n}\nfunction doWatchAd(){ A.watchAd(); }\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ CARREGAMENTO DE DADOS\n\/\/ ═══════════════════════════════════════════════════════\nfunction loadFromAndroid(){\n  const cfg = A.getFullConfig();\n  document.getElementById('badgeApp').textContent = 'v'+(cfg.Version || A.getVersion());\n  updateFreeTierUI(A.getTimeLeft());\n  loadActiveServer();\n}\nfunction loadActiveServer(){\n  const sel = A.getSelectedServer();\n  if(sel && sel.Name){\n    document.getElementById('activeFlagWrap').innerHTML=`<span class=\"sflag-emoji\">${sel.Flag?'🌐':'🏳️'}<\/span>`;\n    document.getElementById('activeSrvName').textContent = sel.Name;\n    document.getElementById('activeSrvInfo').textContent = sel.Info||'—';\n  }\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ SERVERS & CREDENTIALS\n\/\/ ═══════════════════════════════════════════════════════\nlet srvMode='normal', allSrvs=[], allMulti=[], srvFilter='';\nfunction loadServers(){ allSrvs=A.getServers(); allMulti=A.getMultiServers(); renderSrvList(); }\nfunction switchSrvTab(mode,btn){ srvMode=mode; document.querySelectorAll('.stab').forEach(b=>b.classList.remove('active')); btn.classList.add('active'); renderSrvList(); }\nfunction filterSrv(q){ srvFilter=q.toLowerCase(); renderSrvList(); }\nfunction renderSrvList(){\n  const arr = srvMode==='normal'?allSrvs:allMulti;\n  const filtered = srvFilter ? arr.filter(s=>(s.Name||'').toLowerCase().includes(srvFilter)) : arr;\n  if(!filtered.length){ document.getElementById('srvList').innerHTML='<div class=\"sempty\">Nenhum servidor<\/div>'; return; }\n  document.getElementById('srvList').innerHTML = filtered.map(s=>`\n    <div class=\"srv\" onclick=\"pickServer(${s.position})\">\n      <span class=\"sflag-emoji\">${s.Flag?'🌐':'🏳️'}<\/span>\n      <div class=\"sinfo\"><div class=\"sname\">${s.Name||'—'}<\/div><div class=\"shost\">${s.Info||'Direct'}<\/div><\/div>\n    <\/div>`).join('');\n}\nfunction pickServer(pos){ if(srvMode==='normal')A.selectServer(pos); else A.selectMultiServer(pos); loadServers(); loadActiveServer(); toast('Servidor selecionado','ok'); goTab('connect',document.querySelectorAll('.nt')[0]); }\n\nfunction loadCredentials(){\n  const c = A.getSavedCredentials();\n  if(c){ document.getElementById('credUser').value=c.sshUser||''; document.getElementById('credPass').value=c.sshPass||''; }\n}\nfunction saveCreds(){\n  A.saveCredentials(document.getElementById('credUser').value, document.getElementById('credPass').value, '', '', '');\n  toast('Salvo!','ok');\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ OTHERS (SPEED, LOGS)\n\/\/ ═══════════════════════════════════════════════════════\nlet allLogs=[];\nfunction pushLog(entry){ allLogs.push(entry); if(allLogs.length>200) allLogs.shift(); renderLogs(); }\nfunction loadLogsFromApp(){ const raw=A.getLogs(); allLogs=raw.slice(-200); renderLogs(); }\nfunction renderLogs(){\n  const box=document.getElementById('lbox');\n  if(!allLogs.length) box.innerHTML='<div style=\"color:var(--dim);text-align:center\">Vazio<\/div>';\n  else {\n    box.innerHTML=allLogs.map(l=>{\n      const ts = l.time?new Date(Number(l.time)).toLocaleTimeString('pt-BR'):'--:--';\n      return `<div class=\"le\"><span style=\"color:var(--dim)\">[${ts}]<\/span> <span>${(l.message||l.msg||'').slice(0,100)}<\/span><\/div>`;\n    }).join('');\n    box.scrollTop=box.scrollHeight;\n  }\n}\nfunction sendChat(){\n  const inp=document.getElementById('cinp'),val=inp.value.trim(); if(!val)return;\n  const m=document.getElementById('cmsgs');\n  m.innerHTML+=`<div class=\"msg sent\" style=\"align-self:flex-end\"><div class=\"mbbl\" style=\"background:var(--red);color:#fff\">${val}<\/div><\/div>`;\n  inp.value=''; m.scrollTop=m.scrollHeight;\n  setTimeout(()=>{ m.innerHTML+=`<div class=\"msg received\"><div class=\"mbbl\">Entendido! 🌸<\/div><\/div>`; m.scrollTop=m.scrollHeight; },800);\n}\nfunction runSpeed(){\n  document.getElementById('spBtn').disabled=true;\n  document.getElementById('dlGV').textContent='0';\n  let dl=0; const dt=setInterval(()=>{ dl+=4; document.getElementById('dlGV').textContent=dl; document.getElementById('dlGF').style.strokeDashoffset=264-(dl\/100)*264; if(dl>=85){clearInterval(dt); document.getElementById('spBtn').disabled=false;} },100);\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ INIT\n\/\/ ═══════════════════════════════════════════════════════\n(function init(){\n  loadSavedTheme(); \/\/ CARREGA TEMA SALVO\n  loadFromAndroid(); loadServers(); loadLogsFromApp(); loadCredentials();\n  const s=A.getStatus(); if(s) updateStatusUI(s,'');\n})();\n<\/script>\n<\/body>\n<\/html>@"
}
