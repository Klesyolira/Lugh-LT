{
    "version": "11",
    "HtmlUI": "@<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n    <title>Yumeko BK<\/title>\n    <!-- Google Fonts & FontAwesome Icons -->\n    <link href=\"https:\/\/fonts.googleapis.com\/css2?family=Outfit:wght@300;400;600;800&family=Space+Grotesk:wght@500;700&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/font-awesome\/6.4.0\/css\/all.min.css\">\n    \n    <style>\n        :root {\n            --bg-main: #0d0d13;\n            --bg-card: rgba(26, 26, 36, 0.85);\n            --border-color: rgba(255, 0, 98, 0.25);\n            --primary: #ff003c;\n            --primary-glow: rgba(255, 0, 60, 0.5);\n            --secondary: #ffffff;\n            --text-main: #ffffff;\n            --text-muted: #a0a0b8;\n            --accent: #ffb700;\n            --success: #00ffaa;\n            --font-display: 'Space Grotesk', sans-serif;\n            --font-body: 'Outfit', sans-serif;\n        }\n\n        \/* Temas Alternativos *\/\n        [data-theme=\"purple\"] {\n            --bg-main: #0a0518;\n            --bg-card: rgba(30, 15, 50, 0.85);\n            --border-color: rgba(183, 0, 255, 0.3);\n            --primary: #bd00ff;\n            --primary-glow: rgba(187, 0, 255, 0.5);\n            --accent: #00ffff;\n        }\n\n        [data-theme=\"cyan\"] {\n            --bg-main: #020f14;\n            --bg-card: rgba(10, 35, 46, 0.85);\n            --border-color: rgba(0, 242, 254, 0.3);\n            --primary: #00f2fe;\n            --primary-glow: rgba(0, 242, 254, 0.5);\n            --accent: #ff007c;\n        }\n\n        [data-theme=\"light\"] {\n            --bg-main: #f4f5f9;\n            --bg-card: rgba(255, 255, 255, 0.9);\n            --border-color: rgba(255, 0, 60, 0.2);\n            --primary: #ff003c;\n            --primary-glow: rgba(255, 0, 60, 0.2);\n            --secondary: #1a1a24;\n            --text-main: #1a1a24;\n            --text-muted: #62627a;\n            --accent: #7f00ff;\n        }\n\n        * {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n            user-select: none;\n            -webkit-user-select: none;\n            outline: none;\n            -webkit-tap-highlight-color: transparent;\n        }\n\n        body {\n            background-color: var(--bg-main);\n            color: var(--text-main);\n            font-family: var(--font-body);\n            overflow: hidden;\n            height: 100vh;\n            width: 100vw;\n            display: flex;\n            flex-direction: column;\n            position: relative;\n            transition: background 0.4s ease;\n        }\n\n        \/* Overlay com Grid de Anime *\/\n        body::before {\n            content: '';\n            position: absolute;\n            top: 0; left: 0; width: 100%; height: 100%;\n            background-image: linear-gradient(rgba(255,0,60,0.03) 1px, transparent 1px),\n                              linear-gradient(90deg, rgba(255,0,60,0.03) 1px, transparent 1px);\n            background-size: 20px 20px;\n            pointer-events: none;\n            z-index: 0;\n        }\n\n        \/* Header Limpo e Elegante *\/\n        header {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            padding: 24px 20px 12px 20px;\n            z-index: 10;\n            background: linear-gradient(to bottom, rgba(0,0,0,0.4), transparent);\n        }\n\n        .logo-area {\n            display: flex;\n            align-items: center;\n            gap: 12px;\n        }\n\n        .logo-area i {\n            font-size: 26px;\n            color: var(--primary);\n            filter: drop-shadow(0 0 10px var(--primary-glow));\n            animation: pulse 2s infinite;\n        }\n\n        .logo-area h1 {\n            font-family: var(--font-display);\n            font-size: 22px;\n            font-weight: 800;\n            letter-spacing: 2px;\n            text-transform: uppercase;\n        }\n\n        .logo-area span {\n            color: var(--primary);\n            text-shadow: 0 0 15px var(--primary-glow);\n        }\n\n        \/* Área de Conteúdo Ajustada para o Menu Inferior *\/\n        main {\n            flex: 1;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: space-between;\n            padding: 10px 20px 100px 20px; \/* Padding extra na parte de baixo para não colidir com o menu *\/\n            z-index: 10;\n            overflow-y: auto;\n        }\n\n        \/* Menu de Navegação Inferior (Bottom Navigation Bar) *\/\n        .bottom-nav-bar {\n            position: absolute;\n            bottom: 20px;\n            left: 20px;\n            right: 20px;\n            height: 72px;\n            background: rgba(18, 18, 26, 0.9);\n            border: 1px solid var(--border-color);\n            border-radius: 20px;\n            display: flex;\n            align-items: center;\n            justify-content: space-around;\n            padding: 0 10px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.05);\n            backdrop-filter: blur(12px);\n            -webkit-backdrop-filter: blur(12px);\n            z-index: 90;\n        }\n\n        .nav-item {\n            background: transparent;\n            border: none;\n            color: var(--text-muted);\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            gap: 6px;\n            cursor: pointer;\n            width: 60px;\n            height: 100%;\n            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            position: relative;\n        }\n\n        .nav-item i {\n            font-size: 20px;\n            transition: transform 0.3s, color 0.3s;\n        }\n\n        .nav-item span {\n            font-size: 10px;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n        }\n\n        \/* Efeitos Ativos e de Feedback nos Ícones do Menu *\/\n        .nav-item:active {\n            color: var(--primary);\n        }\n\n        .nav-item:active i {\n            transform: scale(0.85);\n            color: var(--primary);\n        }\n\n        \/* Banner Informativo \/ Notas *\/\n        .info-card {\n            width: 100%;\n            background: var(--bg-card);\n            border-left: 4px solid var(--primary);\n            border-radius: 12px;\n            padding: 12px 16px;\n            margin-bottom: 10px;\n            box-shadow: 0 4px 20px rgba(0,0,0,0.2);\n            backdrop-filter: blur(10px);\n            -webkit-backdrop-filter: blur(10px);\n            cursor: pointer;\n        }\n\n        .info-card p {\n            font-size: 13px;\n            color: var(--text-muted);\n            line-height: 1.4;\n        }\n\n        \/* Status de Conexão *\/\n        .status-badge {\n            font-family: var(--font-display);\n            background: rgba(0, 0, 0, 0.4);\n            border: 1px solid var(--border-color);\n            padding: 6px 16px;\n            border-radius: 50px;\n            font-size: 12px;\n            text-transform: uppercase;\n            letter-spacing: 2px;\n            color: var(--text-muted);\n            display: flex;\n            align-items: center;\n            gap: 8px;\n            margin-bottom: 15px;\n        }\n\n        .status-badge::before {\n            content: '';\n            width: 8px;\n            height: 8px;\n            border-radius: 50%;\n            background: #ff0000;\n            box-shadow: 0 0 8px #ff0000;\n            display: inline-block;\n        }\n\n        .status-badge.connected::before {\n            background: var(--success);\n            box-shadow: 0 0 8px var(--success);\n        }\n\n        .status-badge.connecting::before {\n            background: var(--accent);\n            box-shadow: 0 0 8px var(--accent);\n            animation: flash 1s infinite;\n        }\n\n        \/* Contador Regressivo *\/\n        .timer-display {\n            font-family: var(--font-display);\n            font-size: 32px;\n            font-weight: 700;\n            color: var(--text-main);\n            margin-bottom: 15px;\n            text-shadow: 0 0 10px rgba(255,255,255,0.1);\n        }\n\n        \/* Super Botão de Conexão Estilo Anime *\/\n        .connect-container {\n            position: relative;\n            width: 180px;\n            height: 180px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin: 15px 0;\n        }\n\n        .power-btn {\n            width: 130px;\n            height: 130px;\n            border-radius: 50%;\n            background: radial-gradient(circle, #221216 0%, #0c0507 100%);\n            border: 4px solid var(--primary);\n            box-shadow: 0 0 20px rgba(0,0,0,0.6), inset 0 0 15px rgba(255,0,60,0.2);\n            color: var(--primary);\n            font-size: 40px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            cursor: pointer;\n            z-index: 5;\n            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n            position: relative;\n        }\n\n        .power-btn::after {\n            content: 'CONECTAR';\n            position: absolute;\n            bottom: -28px;\n            font-family: var(--font-display);\n            font-size: 11px;\n            font-weight: 700;\n            letter-spacing: 2px;\n            color: var(--text-muted);\n            transition: color 0.3s;\n        }\n\n        \/* Anéis de energia em volta do botão *\/\n        .energy-ring {\n            position: absolute;\n            border: 2px dashed var(--primary);\n            border-radius: 50%;\n            opacity: 0.3;\n            pointer-events: none;\n            transition: all 0.5s ease;\n        }\n\n        .ring-1 { width: 160px; height: 160px; animation: rotate 12s linear infinite; }\n        .ring-2 { width: 180px; height: 180px; animation: rotate-reverse 20s linear infinite; border-style: dotted; border-width: 3px; }\n\n        \/* Estados de animação do botão baseado na conexão *\/\n        .connect-container.connected .power-btn {\n            color: var(--success);\n            border-color: var(--success);\n            box-shadow: 0 0 35px rgba(0, 255, 170, 0.4), inset 0 0 20px rgba(0, 255, 170, 0.2);\n            background: radial-gradient(circle, #091f17 0%, #030d0a 100%);\n        }\n        .connect-container.connected .power-btn::after {\n            content: 'CONECTADO';\n            color: var(--success);\n        }\n        .connect-container.connected .energy-ring {\n            border-color: var(--success);\n            opacity: 0.7;\n            border-style: solid;\n        }\n\n        .connect-container.connecting .power-btn {\n            color: var(--accent);\n            border-color: var(--accent);\n            box-shadow: 0 0 35px rgba(255, 183, 0, 0.4);\n            animation: pulse-glow 1.5s infinite alternate;\n        }\n        .connect-container.connecting .power-btn::after { content: 'CONECTANDO...'; color: var(--accent); }\n        .connect-container.connecting .ring-1 { animation-duration: 3s; }\n        .connect-container.connecting .ring-2 { animation-duration: 5s; }\n\n        \/* Seleção de Servidor Customizada *\/\n        .selector-box {\n            width: 100%;\n            background: var(--bg-card);\n            border: 1px solid var(--border-color);\n            border-radius: 16px;\n            padding: 14px 20px;\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            cursor: pointer;\n            box-shadow: 0 8px 32px rgba(0,0,0,0.3);\n            backdrop-filter: blur(10px);\n            -webkit-backdrop-filter: blur(10px);\n            transition: transform 0.2s, border-color 0.3s;\n            margin-top: 15px;\n        }\n\n        .selector-box:active {\n            transform: scale(0.98);\n            border-color: var(--primary);\n        }\n\n        .selector-info {\n            display: flex;\n            align-items: center;\n            gap: 14px;\n        }\n\n        .flag-wrapper {\n            width: 42px;\n            height: 42px;\n            border-radius: 12px;\n            overflow: hidden;\n            border: 2px solid rgba(255,255,255,0.1);\n            background: #111;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .flag-wrapper img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n        }\n\n        .flag-wrapper i {\n            font-size: 20px;\n            color: var(--primary);\n        }\n\n        .selector-text h2 {\n            font-size: 15px;\n            font-weight: 600;\n            color: var(--text-main);\n        }\n\n        .selector-text p {\n            font-size: 12px;\n            color: var(--text-muted);\n            margin-top: 2px;\n        }\n\n        .selector-arrow {\n            color: var(--primary);\n            font-size: 16px;\n        }\n\n        \/* Abas Operadoras \/ Premium *\/\n        .tab-bar {\n            display: flex;\n            width: 100%;\n            background: rgba(0,0,0,0.3);\n            border-radius: 10px;\n            padding: 4px;\n            margin-bottom: 12px;\n            border: 1px solid rgba(255,255,255,0.05);\n        }\n\n        .tab-item {\n            flex: 1;\n            text-align: center;\n            padding: 10px;\n            font-size: 13px;\n            font-weight: 600;\n            border-radius: 8px;\n            cursor: pointer;\n            transition: all 0.3s;\n            color: var(--text-muted);\n        }\n\n        .tab-item.active {\n            background: var(--primary);\n            color: #fff;\n            box-shadow: 0 4px 12px var(--primary-glow);\n        }\n\n        \/* Janelas Modais Universais (Estilo Bottom Sheet Avançado) *\/\n        .modal-overlay {\n            position: fixed;\n            top: 0; left: 0; width: 100%; height: 100%;\n            background: rgba(5, 5, 8, 0.85);\n            backdrop-filter: blur(8px);\n            -webkit-backdrop-filter: blur(8px);\n            z-index: 100;\n            display: flex;\n            align-items: flex-end;\n            visibility: hidden;\n            opacity: 0;\n            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n\n        .modal-overlay.active {\n            visibility: visible;\n            opacity: 1;\n        }\n\n        .modal-container {\n            width: 100%;\n            max-height: 85vh;\n            background: var(--bg-main);\n            border-top: 3px solid var(--primary);\n            border-radius: 24px 24px 0 0;\n            padding: 24px 20px;\n            display: flex;\n            flex-direction: column;\n            transform: translateY(100%);\n            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n            box-shadow: 0 -10px 40px rgba(0,0,0,0.5);\n        }\n\n        .modal-overlay.active .modal-container {\n            transform: translateY(0);\n        }\n\n        .modal-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 20px;\n            padding-bottom: 12px;\n            border-bottom: 1px solid rgba(255,255,255,0.05);\n        }\n\n        .modal-header h3 {\n            font-family: var(--font-display);\n            font-size: 18px;\n            font-weight: 700;\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n\n        .modal-header h3 i { color: var(--primary); }\n\n        .modal-close {\n            font-size: 20px;\n            color: var(--text-muted);\n            cursor: pointer;\n        }\n\n        .modal-content {\n            overflow-y: auto;\n            flex: 1;\n            padding-bottom: 20px;\n        }\n\n        \/* Listas de Servidores dentro do Modal *\/\n        .server-list-item {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            padding: 12px 16px;\n            background: var(--bg-card);\n            border: 1px solid transparent;\n            border-radius: 14px;\n            margin-bottom: 10px;\n            cursor: pointer;\n            transition: all 0.2s;\n        }\n\n        .server-list-item:active {\n            transform: scale(0.99);\n        }\n\n        .server-list-item.selected {\n            border-color: var(--primary);\n            background: linear-gradient(90deg, rgba(255, 0, 60, 0.1) 0%, var(--bg-card) 100%);\n        }\n\n        \/* Elementos de Input\/Formulários nos Ajustes *\/\n        .form-group {\n            margin-bottom: 16px;\n        }\n\n        .form-group label {\n            display: block;\n            font-size: 12px;\n            font-weight: 600;\n            color: var(--text-muted);\n            margin-bottom: 6px;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n        }\n\n        .input-wrapper {\n            position: relative;\n            display: flex;\n            align-items: center;\n        }\n\n        .input-wrapper i {\n            position: absolute;\n            left: 16px;\n            color: var(--primary);\n        }\n\n        .input-wrapper input {\n            width: 100%;\n            background: rgba(0,0,0,0.3);\n            border: 1px solid var(--border-color);\n            border-radius: 12px;\n            padding: 14px 16px 14px 46px;\n            color: #fff;\n            font-family: var(--font-body);\n            font-size: 14px;\n            transition: border-color 0.3s;\n        }\n\n        .input-wrapper input:focus {\n            border-color: var(--primary);\n            box-shadow: 0 0 8px var(--primary-glow);\n        }\n\n        .btn-submit {\n            width: 100%;\n            background: var(--primary);\n            color: #fff;\n            border: none;\n            padding: 14px;\n            border-radius: 12px;\n            font-family: var(--font-display);\n            font-size: 14px;\n            font-weight: 700;\n            letter-spacing: 1px;\n            cursor: pointer;\n            margin-top: 10px;\n            box-shadow: 0 4px 15px var(--primary-glow);\n        }\n\n        \/* Terminal de Logs Estilizado *\/\n        .logs-box {\n            background: #050508;\n            border: 1px solid rgba(255,255,255,0.05);\n            border-radius: 12px;\n            height: 280px;\n            padding: 14px;\n            font-family: 'Courier New', Courier, monospace;\n            font-size: 11px;\n            overflow-y: auto;\n            color: #d0d0d5;\n            line-height: 1.5;\n        }\n\n        .log-entry { margin-bottom: 6px; border-bottom: 1px solid rgba(255,255,255,0.02); padding-bottom: 4px; }\n        .log-entry.INFO { color: #a0a0b8; }\n        .log-entry.WARN { color: var(--accent); }\n        .log-entry.ERROR { color: var(--primary); font-weight: bold; }\n        .log-entry.SUCCESS { color: var(--success); }\n\n        \/* Layout do Teste de Velocidade *\/\n        .speedtest-container {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            padding: 10px 0;\n        }\n\n        .gauge-ring {\n            position: relative;\n            width: 160px; height: 160px;\n            display: flex; align-items: center; justify-content: center;\n        }\n\n        .gauge-svg {\n            width: 100%; height: 100%;\n            transform: rotate(-90deg);\n        }\n\n        .gauge-track { fill: none; stroke: rgba(255,255,255,0.05); stroke-width: 10; }\n        .gauge-fill {\n            fill: none; stroke: var(--primary); stroke-width: 10;\n            stroke-dasharray: 440; stroke-dashoffset: 440;\n            transition: stroke-dashoffset 0.5s ease;\n        }\n\n        .gauge-value {\n            position: absolute;\n            text-align: center;\n        }\n\n        .gauge-value h4 { font-family: var(--font-display); font-size: 28px; font-weight: 700; }\n        .gauge-value p { font-size: 12px; color: var(--text-muted); }\n\n        .speed-metrics {\n            display: flex; width: 100%; gap: 12px; margin-top: 24px;\n        }\n\n        .metric-card {\n            flex: 1; background: rgba(0,0,0,0.2); padding: 12px; border-radius: 12px; text-align: center;\n            border: 1px solid rgba(255,255,255,0.03);\n        }\n\n        .metric-card label { font-size: 11px; color: var(--text-muted); display: block; margin-bottom: 4px; }\n        .metric-card span { font-family: var(--font-display); font-weight: 700; font-size: 16px; color: #fff; }\n\n        \/* Janela Flutuante de CheckUser *\/\n        .checkuser-window {\n            position: fixed;\n            top: 25px; left: 20px; right: 20px;\n            background: linear-gradient(135deg, rgba(30,20,25,0.95) 0%, rgba(15,10,12,0.95) 100%);\n            border: 1px solid var(--primary);\n            border-radius: 16px;\n            padding: 16px;\n            z-index: 200;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.5);\n            transform: translateY(-150%);\n            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n        }\n\n        .checkuser-window.active { transform: translateY(0); }\n\n        .cu-header {\n            display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;\n        }\n\n        .cu-header h4 { font-family: var(--font-display); font-size: 14px; color: var(--primary); display: flex; align-items: center; gap: 8px; }\n\n        .cu-grid {\n            display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 12px;\n        }\n\n        .cu-item { background: rgba(0,0,0,0.3); padding: 8px 12px; border-radius: 8px; }\n        .cu-item label { color: var(--text-muted); display: block; margin-bottom: 2px; font-size: 10px; }\n        .cu-item span { font-weight: 600; color: #fff; }\n\n        \/* Alternador de Temas Gráfico *\/\n        .theme-grid {\n            display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 10px;\n        }\n\n        .theme-dot {\n            height: 45px; border-radius: 10px; cursor: pointer; border: 2px solid transparent;\n            display: flex; align-items: center; justify-content: center; font-size: 16px;\n        }\n\n        .theme-dot.active { border-color: #fff; transform: scale(1.05); }\n\n        \/* Animações Auxiliares *\/\n        @keyframes rotate { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }\n        @keyframes rotate-reverse { 0% { transform: rotate(360deg); } 100% { transform: rotate(0deg); } }\n        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }\n        @keyframes flash { 0%, 100% { opacity: 1; } 50% { opacity: 0.2; } }\n        @keyframes pulse-glow { 0% { box-shadow: 0 0 15px rgba(255,183,0,0.2); } 100% { box-shadow: 0 0 35px rgba(255,183,0,0.6); } }\n\n        \/* Responsividade para telas menores *\/\n        @media (max-height: 650px) {\n            .connect-container { width: 140px; height: 140px; margin: 10px 0; }\n            .power-btn { width: 100px; height: 100px; font-size: 30px; }\n            .ring-1 { width: 125px; height: 125px; }\n            .ring-2 { width: 140px; height: 140px; }\n            .timer-display { font-size: 24px; margin-bottom: 10px; }\n            main { padding-bottom: 90px; }\n            .bottom-nav-bar { height: 64px; bottom: 12px; }\n        }\n    <\/style>\n<\/head>\n<body>\n\n    <!-- Janela de Notificação CheckUser Externa (Top Window) -->\n    <div id=\"checkuserWindow\" class=\"checkuser-window\">\n        <div class=\"cu-header\">\n            <h4><i class=\"fa-solid fa-shield-halved\"><\/i> CONTA VALIDADA<\/h4>\n            <i class=\"fa-solid fa-xmark\" style=\"cursor:pointer;\" onclick=\"toggleCheckUser(false)\"><\/i>\n        <\/div>\n        <div class=\"cu-grid\">\n            <div class=\"cu-item\"><label>Usuário<\/label><span id=\"cu-user\">—<\/span><\/div>\n            <div class=\"cu-item\"><label>Conexões<\/label><span id=\"cu-conns\">—<\/span><\/div>\n            <div class=\"cu-item\"><label>Expiração<\/label><span id=\"cu-exp\">—<\/span><\/div>\n            <div class=\"cu-item\"><label>Dias Restantes<\/label><span id=\"cu-days\">—<\/span><\/div>\n        <\/div>\n    <\/div>\n\n    <!-- Cabeçalho Limpo -->\n    <header>\n        <div class=\"logo-area\">\n            <i class=\"fa-solid fa-dice-d20\"><\/i>\n            <h1>Yumeko<span>BK<\/span><\/h1>\n        <\/div>\n    <\/header>\n\n    <!-- Conteúdo Central -->\n    <main>\n        <!-- Banner de Notas \/ Atualizações Dinâmicas -->\n        <div class=\"info-card\" onclick=\"triggerUpdateCheck()\">\n            <p id=\"app-release-note\">Toque aqui para verificar atualizações globais de sincronização de rede.<\/p>\n        <\/div>\n\n        <!-- Emblema de Status Técnico -->\n        <div id=\"vpnStatusBadge\" class=\"status-badge\">Desconectado<\/div>\n\n        <!-- Cronômetro de Acesso Regressivo -->\n        <div id=\"timerDisplay\" class=\"timer-display\">00h:00m:00s<\/div>\n\n        <!-- Botão Principal Inovador -->\n        <div id=\"connectContainer\" class=\"connect-container\">\n            <div class=\"energy-ring ring-1\"><\/div>\n            <div class=\"energy-ring ring-2\"><\/div>\n            <button class=\"power-btn\" onclick=\"triggerConnect()\" id=\"mainPowerBtn\">\n                <i class=\"fa-solid fa-power-off\"><\/i>\n            <\/button>\n        <\/div>\n\n        <!-- Seletor de Servidores e Payload Combinado -->\n        <div class=\"selector-box\" onclick=\"openServerSelectorModal()\">\n            <div class=\"selector-info\">\n                <div class=\"flag-wrapper\" id=\"selectedFlagContainer\">\n                    <i class=\"fa-solid fa-earth-americas\"><\/i>\n                <\/div>\n                <div class=\"selector-text\">\n                    <h2 id=\"lblServerName\">Selecionar Servidor<\/h2>\n                    <p id=\"lblServerInfo\">Carregando localizações...<\/p>\n                <\/div>\n            <\/div>\n            <div class=\"selector-arrow\">\n                <i class=\"fa-solid fa-chevron-right\"><\/i>\n            <\/div>\n        <\/div>\n    <\/main>\n\n    <!-- MENU INFERIOR (Bottom Navigation Bar) -->\n    <nav class=\"bottom-nav-bar\">\n        <button class=\"nav-item\" onclick=\"openModal('modalLogs')\" title=\"Logs\">\n            <i class=\"fa-solid fa-terminal\"><\/i>\n            <span>Logs<\/span>\n        <\/button>\n        <button class=\"nav-item\" onclick=\"openModal('modalAjustes')\" title=\"Ajustes\">\n            <i class=\"fa-solid fa-sliders\"><\/i>\n            <span>Ajustes<\/span>\n        <\/button>\n        <button class=\"nav-item\" onclick=\"openModal('modalSpeed')\" title=\"Velocidade\">\n            <i class=\"fa-solid fa-gauge-high\"><\/i>\n            <span>Medidor<\/span>\n        <\/button>\n        <button class=\"nav-item\" onclick=\"handleChatToggle()\" title=\"Chat\">\n            <i class=\"fa-solid fa-comments\"><\/i>\n            <span>Chat<\/span>\n        <\/button>\n    <\/nav>\n\n    <!-- MODAL: Seletor de Servidores Dinâmico -->\n    <div id=\"modalServers\" class=\"modal-overlay\" onclick=\"closeModalOnOuterClick(event, 'modalServers')\">\n        <div class=\"modal-container\">\n            <div class=\"modal-header\">\n                <h3><i class=\"fa-solid fa-server\"><\/i> Lista de Servidores<\/h3>\n                <i class=\"fa-solid fa-xmark modal-close\" onclick=\"closeModal('modalServers')\"><\/i>\n            <\/div>\n            <div class=\"tab-bar\">\n                <div id=\"tabOps\" class=\"tab-item active\" onclick=\"switchServerTab(0)\">Operadoras<\/div>\n                <div id=\"tabPrem\" class=\"tab-item\" onclick=\"switchServerTab(1)\">Servidores Premium<\/div>\n            <\/div>\n            <div class=\"modal-content\" id=\"serverListContainer\">\n                <!-- Injetado dinamicamente via JS -->\n            <\/div>\n        <\/div>\n    <\/div>\n\n    <!-- MODAL: Ajustes de Credenciais e Temas -->\n    <div id=\"modalAjustes\" class=\"modal-overlay\" onclick=\"closeModalOnOuterClick(event, 'modalAjustes')\">\n        <div class=\"modal-container\">\n            <div class=\"modal-header\">\n                <h3><i class=\"fa-solid fa-user-gear\"><\/i> Ajustes de Configuração<\/h3>\n                <i class=\"fa-solid fa-xmark modal-close\" onclick=\"closeModal('modalAjustes')\"><\/i>\n            <\/div>\n            <div class=\"modal-content\">\n                <form id=\"frmCredentials\" onsubmit=\"saveAppCredentials(event)\">\n                    <div class=\"form-group\">\n                        <label>Usuário SSH<\/label>\n                        <div class=\"input-wrapper\">\n                            <i class=\"fa-solid fa-user\"><\/i>\n                            <input type=\"text\" id=\"txtSshUser\" placeholder=\"Seu usuário padrão\">\n                        <\/div>\n                    <\/div>\n                    <div class=\"form-group\">\n                        <label>Senha SSH<\/label>\n                        <div class=\"input-wrapper\">\n                            <i class=\"fa-solid fa-lock\"><\/i>\n                            <input type=\"password\" id=\"txtSshPass\" placeholder=\"Sua senha de acesso\">\n                        <\/div>\n                    <\/div>\n                    <div class=\"form-group\">\n                        <label>Token \/ Auth UDP<\/label>\n                        <div class=\"input-wrapper\">\n                            <i class=\"fa-solid fa-key\"><\/i>\n                            <input type=\"text\" id=\"txtUdpToken\" placeholder=\"Opcional para conexões UDP\">\n                        <\/div>\n                    <\/div>\n                    <div class=\"form-group\">\n                        <label>UUID V2Ray Core<\/label>\n                        <div class=\"input-wrapper\">\n                            <i class=\"fa-solid fa-circle-nodes\"><\/i>\n                            <input type=\"text\" id=\"txtV2rayId\" placeholder=\"UUID Customizado Vmess\">\n                        <\/div>\n                    <\/div>\n                    <div class=\"form-group\">\n                        <label>Xray Link \/ Config (Vless\/Trojan)<\/label>\n                        <div class=\"input-wrapper\">\n                            <i class=\"fa-solid fa-code\"><\/i>\n                            <input type=\"text\" id=\"txtXrayId\" placeholder=\"vless:\/\/, trojan:\/\/ ou ID\">\n                        <\/div>\n                    <\/div>\n                    <button type=\"submit\" class=\"btn-submit\">GRAVAR CREDENCIAIS<\/button>\n                <\/form>\n\n                <div style=\"margin-top: 25px;\">\n                    <label style=\"font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: uppercase;\">Estilo & Aparência do Sistema<\/label>\n                    <div class=\"theme-grid\">\n                        <div class=\"theme-dot active\" style=\"background:#ff003c; color:#fff;\" onclick=\"setSystemTheme('default', this)\"><i class=\"fa-solid fa-check\"><\/i><\/div>\n                        <div class=\"theme-dot\" style=\"background:#bd00ff;\" onclick=\"setSystemTheme('purple', this)\"><\/div>\n                        <div class=\"theme-dot\" style=\"background:#00f2fe;\" onclick=\"setSystemTheme('cyan', this)\"><\/div>\n                        <div class=\"theme-dot\" style=\"background:#ffffff; border:1px solid #ccc;\" onclick=\"setSystemTheme('light', this)\"><\/div>\n                    <\/div>\n                <\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n\n    <!-- MODAL: Console de Logs Estilizado -->\n    <div id=\"modalLogs\" class=\"modal-overlay\" onclick=\"closeModalOnOuterClick(event, 'modalLogs')\">\n        <div class=\"modal-container\">\n            <div class=\"modal-header\">\n                <h3><i class=\"fa-solid fa-terminal\"><\/i> Log de Eventos Externo<\/h3>\n                <i class=\"fa-solid fa-xmark modal-close\" onclick=\"closeModal('modalLogs')\"><\/i>\n            <\/div>\n            <div class=\"modal-content\">\n                <div id=\"terminalLogBox\" class=\"logs-box\">\n                    <!-- Logs populados em tempo real -->\n                <\/div>\n                <button class=\"btn-submit\" onclick=\"clearConsoleLogs()\" style=\"background: rgba(255,255,255,0.05); color: var(--text-main); box-shadow: none; border: 1px solid rgba(255,255,255,0.1); margin-top: 15px;\">LIMPAR LOGS<\/button>\n            <\/div>\n        <\/div>\n    <\/div>\n\n    <!-- MODAL: Teste de Velocidade Avançado -->\n    <div id=\"modalSpeed\" class=\"modal-overlay\" onclick=\"closeModalOnOuterClick(event, 'modalSpeed')\">\n        <div class=\"modal-container\">\n            <div class=\"modal-header\">\n                <h3><i class=\"fa-solid fa-gauge-high\"><\/i> Medidor de Performance<\/h3>\n                <i class=\"fa-solid fa-xmark modal-close\" onclick=\"closeModal('modalSpeed')\"><\/i>\n            <\/div>\n            <div class=\"modal-content\">\n                <div class=\"speedtest-container\">\n                    <div class=\"gauge-ring\">\n                        <svg class=\"gauge-svg\">\n                            <circle class=\"gauge-track\" cx=\"80\" cy=\"80\" r=\"70\"><\/circle>\n                            <circle id=\"gaugeFillBar\" class=\"gauge-fill\" cx=\"80\" cy=\"80\" r=\"70\"><\/circle>\n                        <\/svg>\n                        <div class=\"gauge-value\">\n                            <h4 id=\"lblSpeedValue\">0.0<\/h4>\n                            <p id=\"lblSpeedUnit\">Mbps<\/p>\n                        <\/div>\n                    <\/div>\n                    <div class=\"speed-metrics\">\n                        <div class=\"metric-card\"><label>LATÊNCIA<\/label><span id=\"lblPingVal\">0 ms<\/span><\/div>\n                        <div class=\"metric-card\"><label>DOWNLOAD MAX<\/label><span id=\"lblMaxSpeedVal\">0.0 Mb<\/span><\/div>\n                    <\/div>\n                    <button id=\"btnStartSpeedTest\" class=\"btn-submit\" onclick=\"runSimulatedSpeedTest()\" style=\"margin-top: 25px;\">INICIAR TESTE DE REDE<\/button>\n                <\/div>\n            <\/div>\n        <\/div>\n    <\/div>\n\n    <!-- Script de Orquestração Técnica e Integração com a WebView -->\n    <script>\n        let currentTabMode = 0; \/\/ 0 = Operadoras, 1 = Premium\n\n        \/\/ Inicialização Global Automatizada\n        document.addEventListener(\"DOMContentLoaded\", function() {\n            loadSavedCredentialsLocal();\n            requestSystemStatusUpdate();\n            renderSelectedServerUI();\n            requestInitialHistoryLogs();\n            initAppReleaseNotes();\n            \n            \/\/ Loop para verificação de tempo flutuante nativo\n            setInterval(updateVpnTimerDisplay, 1000);\n        });\n\n        \/\/ Pontes de Invocação Segura com tratamento de exceção (Mock nativo para testes em navegador desktop)\n        function safeAndroidBridge(methodName, params = []) {\n            if (typeof Android !== 'undefined' && Android[methodName]) {\n                return Android[methodName](...params);\n            } else {\n                console.warn(`[Bridge Mock]: Método '${methodName}' invocado com sucesso.`, params);\n                \/\/ Retornos simulados estruturados idênticos às assinaturas Java do WebAppBridge\n                if (methodName === 'getStatus') return \"DESCONECTADO\";\n                if (methodName === 'getSavedCredentials') return '{\"sshUser\":\"Yumeko\",\"sshPass\":\"1234\",\"udpToken\":\"\",\"v2uuid\":\"\",\"xrayId\":\"\"}';\n                if (methodName === 'getServers') return '[{\"position\":0,\"Name\":\"Vivo Turbo SSL\",\"Info\":\"SSL\",\"Flag\":\"br\"},{\"position\":1,\"Name\":\"Tim Web WS\",\"Info\":\"WS\",\"Flag\":\"us\"}]';\n                if (methodName === 'getMultiServers') return '[{\"position\":0,\"Name\":\"BR-PREMIUM-01\",\"Info\":\"Premium\",\"Flag\":\"br\"},{\"position\":1,\"Name\":\"US-FAST-02\",\"Info\":\"Premium\",\"Flag\":\"us\"}]';\n                if (methodName === 'getSelectedServer') return '{\"position\":0,\"Name\":\"Vivo Turbo SSL\",\"Info\":\"SSL\",\"Flag\":\"br\"}';\n                if (methodName === 'getSelectedMultiServer') return '{\"position\":0,\"Name\":\"BR-PREMIUM-01\",\"Info\":\"Premium\",\"Flag\":\"br\"}';\n                if (methodName === 'getTimeLeft') return 7200000; \/\/ 2 horas mockadas\n                if (methodName === 'getLogs') return '[]';\n                return null;\n            }\n        }\n\n        \/\/ Ações de Interface Direta\n        function triggerConnect() {\n            safeAndroidBridge('connect');\n        }\n\n        function triggerUpdateCheck() {\n            safeAndroidBridge('checkUpdate');\n        }\n\n        function handleChatToggle() {\n            safeAndroidBridge('openChat');\n        }\n\n        function requestSystemStatusUpdate() {\n            const currentStatus = safeAndroidBridge('getStatus');\n            processVpnStatusChange(currentStatus, '');\n        }\n\n        function updateVpnTimerDisplay() {\n            const timeLeftMs = safeAndroidBridge('getTimeLeft');\n            if (!timeLeftMs || timeLeftMs <= 0) {\n                document.getElementById('timerDisplay').innerText = \"00h:00m:00s\";\n                return;\n            }\n            if (timeLeftMs >= 999999999) {\n                document.getElementById('timerDisplay').innerText = \"Acesso Ilimitado\";\n                return;\n            }\n            const hours = Math.floor(timeLeftMs \/ (1000 * 60 * 60));\n            const minutes = Math.floor((timeLeftMs % (1000 * 60 * 60)) \/ (1000 * 60));\n            const seconds = Math.floor((timeLeftMs % (1000 * 60)) \/ 1000);\n            \n            document.getElementById('timerDisplay').innerText = \n                `${hours.toString().padStart(2, '0')}h:${minutes.toString().padStart(2, '0')}m:${seconds.toString().padStart(2, '0')}s`;\n        }\n\n        function initAppReleaseNotes() {\n            const rawNote = safeAndroidBridge('getNote');\n            const version = safeAndroidBridge('getVersion');\n            if (rawNote) {\n                document.getElementById('app-release-note').innerText = `v${version} — ${rawNote}`;\n            }\n        }\n\n        \/\/ Manipulação de Modais Estilo Top\n        function openModal(id) {\n            document.getElementById(id).classList.add('active');\n            if (id === 'modalLogs') {\n                const box = document.getElementById('terminalLogBox');\n                box.scrollTop = box.scrollHeight;\n            }\n        }\n\n        \/\/ Fecha janelas ativas\n        function closeModal(id) {\n            document.getElementById(id).classList.remove('active');\n        }\n\n        function closeModalOnOuterClick(event, id) {\n            if (event.target.id === id) closeModal(id);\n        }\n\n        function openServerSelectorModal() {\n            openModal('modalServers');\n            loadAndRenderServerList();\n        }\n\n        \/\/ Lógica de Abas e Renderização de Servidores\n        function switchServerTab(mode) {\n            currentTabMode = mode;\n            document.getElementById('tabOps').classList.toggle('active', mode === 0);\n            document.getElementById('tabPrem').classList.toggle('active', mode === 1);\n            loadAndRenderServerList();\n        }\n\n        function loadAndRenderServerList() {\n            const container = document.getElementById('serverListContainer');\n            container.innerHTML = '';\n\n            let serverJsonString = currentTabMode === 0 ? safeAndroidBridge('getServers') : safeAndroidBridge('getMultiServers');\n            let selectedJsonString = currentTabMode === 0 ? safeAndroidBridge('getSelectedServer') : safeAndroidBridge('getSelectedMultiServer');\n            \n            try {\n                const servers = JSON.parse(serverJsonString || '[]');\n                const selected = JSON.parse(selectedJsonString || '{}');\n\n                if (servers.length === 0) {\n                    container.innerHTML = `<p style=\"text-align:center;color:var(--text-muted);font-size:13px;padding:20px;\">Nenhum servidor configurado nesta categoria.<\/p>`;\n                    return;\n                }\n\n                servers.forEach(srv => {\n                    const isSelected = selected && selected.position === srv.position;\n                    const item = document.createElement('div');\n                    item.className = `server-list-item ${isSelected ? 'selected' : ''}`;\n                    item.onclick = () => selectServerTarget(srv.position);\n\n                    const flagHtml = srv.FlagUrl ? \n                        `<img src=\"${srv.FlagUrl}\" alt=\"flag\">` : \n                        `<img src=\"flags\/${srv.Flag || 'br'}.png\" onerror=\"this.style.display='none';this.nextElementSibling.style.display='block';\"><i class=\"fa-solid fa-earth-americas\" style=\"display:none; font-size:18px;\"><\/i>`;\n\n                    item.innerHTML = `\n                        <div style=\"display:flex;align-items:center;gap:12px;\">\n                            <div class=\"flag-wrapper\">${flagHtml}<\/div>\n                            <div style=\"text-align:left;\">\n                                <h4 style=\"font-size:14px;font-weight:600;color:var(--text-main);\">${srv.Name}<\/h4>\n                                <p style=\"font-size:11px;color:var(--text-muted);margin-top:2px;\">${srv.Info || 'Premium Connect'}<\/p>\n                            <\/div>\n                        <\/div>\n                        ${isSelected ? '<i class=\"fa-solid fa-circle-check\" style=\"color:var(--primary);\"><\/i>' : ''}\n                    `;\n                    container.appendChild(item);\n                });\n            } catch (e) {\n                container.innerHTML = `<p style=\"color:var(--primary);font-size:12px;\">Erro ao processar lista: ${e.message}<\/p>`;\n            }\n        }\n\n        function selectServerTarget(position) {\n            if (currentTabMode === 0) {\n                safeAndroidBridge('selectServer', [position]);\n            } else {\n                safeAndroidBridge('selectMultiServer', [position]);\n            }\n            closeModal('modalServers');\n        }\n\n        function renderSelectedServerUI() {\n            try {\n                let activeServer = JSON.parse(safeAndroidBridge('getSelectedServer') || '{}');\n                let multiServer = JSON.parse(safeAndroidBridge('getSelectedMultiServer') || '{}');\n\n                if (activeServer && activeServer.Name) {\n                    let displayTitle = activeServer.Name;\n                    if (multiServer && multiServer.Name) {\n                        displayTitle += ` + ${multiServer.Name}`;\n                    }\n                    document.getElementById('lblServerName').innerText = displayTitle;\n                    document.getElementById('lblServerInfo').innerText = activeServer.Info || 'Direct Connect';\n                    \n                    const flagWrap = document.getElementById('selectedFlagContainer');\n                    if (activeServer.FlagUrl) {\n                        flagWrap.innerHTML = `<img src=\"${activeServer.FlagUrl}\" alt=\"flag\">`;\n                    } else {\n                        flagWrap.innerHTML = `<img src=\"flags\/${activeServer.Flag || 'br'}.png\" onerror=\"this.style.display='none';this.nextElementSibling.style.display='block';\"><i class=\"fa-solid fa-earth-americas\" style=\"display:none;\"><\/i>`;\n                    }\n                }\n            } catch(e) {\n                console.error(\"Erro ao renderizar dados do servidor ativo\", e);\n            }\n        }\n\n        \/\/ Formulário de Persistência de Dados\n        function saveAppCredentials(e) {\n            e.preventDefault();\n            const user = document.getElementById('txtSshUser').value.trim();\n            const pass = document.getElementById('txtSshPass').value.trim();\n            const udp = document.getElementById('txtUdpToken').value.trim();\n            const v2ray = document.getElementById('txtV2rayId').value.trim();\n            const xray = document.getElementById('txtXrayId').value.trim();\n\n            safeAndroidBridge('saveCredentials', [user, pass, udp, v2ray, xray]);\n            closeModal('modalAjustes');\n        }\n\n        function loadSavedCredentialsLocal() {\n            try {\n                const credsRaw = safeAndroidBridge('getSavedCredentials');\n                if (credsRaw) {\n                    const obj = JSON.parse(credsRaw);\n                    document.getElementById('txtSshUser').value = obj.sshUser || '';\n                    document.getElementById('txtSshPass').value = obj.sshPass || '';\n                    document.getElementById('txtUdpToken').value = obj.udpToken || '';\n                    document.getElementById('txtV2rayId').value = obj.v2uuid || '';\n                    document.getElementById('txtXrayId').value = obj.xrayId || '';\n                }\n            } catch(e) {}\n        }\n\n        \/\/ Controle do Painel de Logs Avançado\n        function requestInitialHistoryLogs() {\n            try {\n                const history = JSON.parse(safeAndroidBridge('getLogs') || '[]');\n                const box = document.getElementById('terminalLogBox');\n                box.innerHTML = '';\n                history.forEach(appendSingleLogDOM);\n            } catch(e) {}\n        }\n\n        function appendSingleLogDOM(logObj) {\n            const box = document.getElementById('terminalLogBox');\n            const entry = document.createElement('div');\n            entry.className = `log-entry ${logObj.level}`;\n            \n            const timeStr = logObj.time ? `[${new Date(logObj.time).toLocaleTimeString()}] ` : '';\n            entry.innerText = `${timeStr}${logObj.message}`;\n            \n            box.appendChild(entry);\n            if (box.scrollHeight - box.scrollTop < 350) {\n                box.scrollTop = box.scrollHeight;\n            }\n        }\n\n        function clearConsoleLogs() {\n            safeAndroidBridge('clearLogs');\n        }\n\n        \/\/ Mudar Variáveis do Tema\n        function setSystemTheme(themeName, element) {\n            if (themeName === 'default') {\n                document.body.removeAttribute('data-theme');\n            } else {\n                document.body.setAttribute('data-theme', themeName);\n            }\n            \n            document.querySelectorAll('.theme-dot').forEach(dot => {\n                dot.classList.remove('active');\n                dot.innerHTML = '';\n            });\n            element.classList.add('active');\n            element.innerHTML = '<i class=\"fa-solid fa-check\"><\/i>';\n        }\n\n        \/\/ Controle da Janela de CheckUser Externa\n        function toggleCheckUser(show, data = null) {\n            const win = document.getElementById('checkuserWindow');\n            if (show && data) {\n                document.getElementById('cu-user').innerText = data.username || '—';\n                document.getElementById('cu-conns').innerText = `${data.count_connection || '0'} \/ ${data.isUnlimited ? '∞' : (data.limiter_user || '—')}`;\n                document.getElementById('cu-exp').innerText = data.expiration_date || '—';\n                document.getElementById('cu-days').innerText = data.expiration_days ? `${data.expiration_days} dias` : '—';\n                win.classList.add('active');\n                setTimeout(() => win.classList.remove('active'), 8000);\n            } else {\n                win.classList.remove('active');\n            }\n        }\n\n        \/\/ Teste de Velocidade Simulado Avançado\n        function runSimulatedSpeedTest() {\n            const btn = document.getElementById('btnStartSpeedTest');\n            const fill = document.getElementById('gaugeFillBar');\n            const val = document.getElementById('lblSpeedValue');\n            const ping = document.getElementById('lblPingVal');\n            const maxVal = document.getElementById('lblMaxSpeedVal');\n\n            btn.disabled = true;\n            btn.innerText = \"ANALISANDO REDE VPN...\";\n            \n            let currentCycle = 0;\n            let peakSpeed = 0;\n            ping.innerText = `${Math.floor(Math.random() * 45 + 15)} ms`;\n\n            const interval = setInterval(() => {\n                currentCycle++;\n                let currentMockSpeed = (Math.sin(currentCycle * 0.4) * 25) + 35 + (Math.random() * 8);\n                if (currentMockSpeed > peakSpeed) peakSpeed = currentMockSpeed;\n\n                val.innerText = currentMockSpeed.toFixed(1);\n                \n                let percentage = currentMockSpeed \/ 80;\n                if (percentage > 1) percentage = 1;\n                fill.style.strokeDashoffset = 440 - (440 * percentage);\n                \n                maxVal.innerText = `${peakSpeed.toFixed(1)} Mb`;\n\n                if (currentCycle >= 25) {\n                    clearInterval(interval);\n                    btn.disabled = false;\n                    btn.innerText = \"REPETIR TESTE DE REDE\";\n                    fill.style.strokeDashoffset = 440;\n                    val.innerText = \"0.0\";\n                }\n            }, 180);\n        }\n\n        \/\/ ── CALLBACKS CRÍTICOS INJETADOS PELA MAINACTIVITY NATIVA ──\n        \n        window.onVpnStatus = function(status, detail) {\n            processVpnStatusChange(status, detail);\n        };\n\n        function processVpnStatusChange(status, detail) {\n            const badge = document.getElementById('vpnStatusBadge');\n            const container = document.getElementById('connectContainer');\n            \n            badge.className = \"status-badge\";\n            container.className = \"connect-container\";\n            \n            badge.innerText = status;\n\n            if (status === \"CONECTADO\") {\n                badge.classList.add('connected');\n                container.classList.add('connected');\n            } else if (status === \"INICIANDO\" || status === \"CONECTANDO\" || status === \"AUTENTICANDO\" || status === \"RECONECTANDO\") {\n                badge.classList.add('connecting');\n                container.classList.add('connecting');\n            }\n        }\n\n        window.onLogAdded = function(logObj) {\n            appendSingleLogDOM(logObj);\n        };\n\n        window.onLogsCleared = function() {\n            document.getElementById('terminalLogBox').innerHTML = '';\n        };\n\n        window.onServerChanged = function() {\n            renderSelectedServerUI();\n            if (document.getElementById('modalServers').classList.contains('active')) {\n                loadAndRenderServerList();\n            }\n        };\n\n        window.onConfigUpdated = function(version) {\n            initAppReleaseNotes();\n            renderSelectedServerUI();\n        };\n\n        window.onConfigReloaded = function() {\n            initAppReleaseNotes();\n            renderSelectedServerUI();\n        };\n\n        window.onCheckUserReceived = function(dataObj) {\n            toggleCheckUser(true, dataObj);\n        };\n\n        window.onAdLoading = function() {\n            document.getElementById('app-release-note').innerText = \"Carregando infraestrutura de anúncios monetizados...\";\n        };\n\n        window.onAdFailed = function() {\n            document.getElementById('app-release-note').innerText = \"Falha ao sincronizar provedor de anúncios externos.\";\n        };\n\n        window.onTimeAdded = function(newTimeLeft) {\n            updateVpnTimerDisplay();\n            document.getElementById('app-release-note').innerText = \"Tempo de acesso adicionado com sucesso!\";\n        };\n    <\/script>\n<\/body>\n<\/html>@"
}
