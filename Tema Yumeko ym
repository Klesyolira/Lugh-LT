:h-5 after:w-5 after:transition-all peer-checked:bg-theme\"><\/div>\n                    <\/label>\n                <\/div>\n\n                <p class=\"text-sm font-medium mb-3\">Cor do Tema<\/p>\n                <div class=\"grid grid-cols-6 gap-3\">\n                    <script>\n                        const colors = [\n                            { hex: '#ff2a5f', glow: 'rgba(255, 42, 95, 0.5)' },\n                            { hex: '#3b82f6', glow: 'rgba(59, 130, 246, 0.5)' },\n                            { hex: '#10b981', glow: 'rgba(16, 185, 129, 0.5)' },\n                            { hex: '#8b5cf6', glow: 'rgba(139, 92, 246, 0.5)' },\n                            { hex: '#ec4899', glow: 'rgba(236, 72, 153, 0.5)' },\n                            { hex: '#f59e0b', glow: 'rgba(245, 158, 11, 0.5)' },\n                            { hex: '#eab308', glow: 'rgba(234, 179, 8, 0.5)' },\n                            { hex: '#06b6d4', glow: 'rgba(6, 182, 212, 0.5)' },\n                            { hex: '#d946ef', glow: 'rgba(217, 70, 239, 0.5)' },\n                            { hex: '#84cc16', glow: 'rgba(132, 204, 22, 0.5)' },\n                            { hex: '#14b8a6', glow: 'rgba(20, 184, 166, 0.5)' },\n                            { hex: '#6366f1', glow: 'rgba(99, 102, 241, 0.5)' }\n                        ];\n                        colors.forEach(c => {\n                            document.write(`<button onclick=\"setThemeColor('${c.hex}', '${c.glow}')\" class=\"w-8 h-8 rounded-full border-2 border-white\/20 hover:scale-110 active:scale-90 transition\" style=\"background-color: ${c.hex}; box-shadow: 0 0 10px ${c.glow}\"><\/button>`);\n                        });\n                    <\/script>\n                <\/div>\n            <\/div>\n\n            <!-- SpeedTest Oculto\/Integrado -->\n            <div class=\"glass p-2 rounded-2xl flex flex-col h-64 overflow-hidden relative\">\n                <h3 class=\"text-sm font-semibold opacity-70 uppercase mb-2 px-3 pt-2\">Teste de Velocidade<\/h3>\n                <div class=\"flex-1 w-full rounded-xl overflow-hidden bg-black\/20\">\n                    <iframe src=\"https:\/\/openspeedtest.com\/Get-widget.php\" class=\"w-full h-full border-none pointer-events-auto\"><\/iframe>\n                <\/div>\n            <\/div>\n\n        <\/div>\n    <\/main>\n\n    <!-- Bottom Nav -->\n    <nav class=\"fixed bottom-0 left-0 w-full z-40 p-3\">\n        <div class=\"glass rounded-full px-6 py-3 flex justify-between items-center shadow-glow-lg max-w-md mx-auto\">\n            <button onclick=\"switchTab('home')\" class=\"nav-btn active flex flex-col items-center gap-1 text-theme transition active:scale-90\">\n                <i data-lucide=\"home\" class=\"w-6 h-6\"><\/i>\n            <\/button>\n            <button onclick=\"switchTab('settings')\" class=\"nav-btn flex flex-col items-center gap-1 opacity-50 hover:opacity-100 transition active:scale-90\">\n                <i data-lucide=\"settings\" class=\"w-6 h-6\"><\/i>\n            <\/button>\n            <button onclick=\"switchTab('logs')\" class=\"nav-btn flex flex-col items-center gap-1 opacity-50 hover:opacity-100 transition active:scale-90\">\n                <i data-lucide=\"file-text\" class=\"w-6 h-6\"><\/i>\n            <\/button>\n            <button onclick=\"switchTab('tools')\" class=\"nav-btn flex flex-col items-center gap-1 opacity-50 hover:opacity-100 transition active:scale-90\">\n                <i data-lucide=\"grid\" class=\"w-6 h-6\"><\/i>\n            <\/button>\n        <\/div>\n    <\/nav>\n\n    <!-- MODAL: Check User -->\n    <div id=\"modalCheckUser\" class=\"modal\">\n        <div class=\"glass w-full max-w-sm rounded-3xl p-6 relative flex flex-col items-center text-center transform scale-95 transition-transform duration-300 shadow-glow-lg\">\n            <button onclick=\"closeModal('modalCheckUser')\" class=\"absolute top-4 right-4 bg-white\/10 p-2 rounded-full hover:bg-white\/20 active:scale-90\">\n                <i data-lucide=\"x\" class=\"w-4 h-4\"><\/i>\n            <\/button>\n            \n            <div class=\"w-16 h-16 rounded-full bg-theme flex items-center justify-center shadow-glow mb-4\">\n                <i data-lucide=\"user-check\" class=\"text-white w-8 h-8\"><\/i>\n            <\/div>\n            \n            <h2 class=\"text-xl font-bold mb-1\">Status da Conta<\/h2>\n            <p id=\"cuUser\" class=\"text-sm opacity-70 mb-6\">@usuario<\/p>\n            \n            <div class=\"w-full space-y-3\">\n                <div class=\"flex justify-between bg-black\/20 p-3 rounded-xl border border-white\/5\">\n                    <span class=\"opacity-70 flex items-center gap-2\"><i data-lucide=\"smartphone\" class=\"w-4 h-4\"><\/i> Conexões<\/span>\n                    <span id=\"cuConns\" class=\"font-bold text-theme\">0 \/ 1<\/span>\n                <\/div>\n                <div class=\"flex justify-between bg-black\/20 p-3 rounded-xl border border-white\/5\">\n                    <span class=\"opacity-70 flex items-center gap-2\"><i data-lucide=\"calendar\" class=\"w-4 h-4\"><\/i> Validade<\/span>\n                    <span id=\"cuExpiry\" class=\"font-bold\">--\/--\/----<\/span>\n                <\/div>\n                <div class=\"flex justify-between bg-black\/20 p-3 rounded-xl border border-white\/5\">\n                    <span class=\"opacity-70 flex items-center gap-2\"><i data-lucide=\"clock\" class=\"w-4 h-4\"><\/i> Dias Restantes<\/span>\n                    <span id=\"cuDays\" class=\"font-bold text-green-400\">-- dias<\/span>\n                <\/div>\n            <\/div>\n            \n            <button onclick=\"closeModal('modalCheckUser')\" class=\"w-full mt-6 py-3 rounded-xl bg-white\/10 font-bold hover:bg-white\/20 transition active:scale-95\">\n                Fechar Janela\n            <\/button>\n        <\/div>\n    <\/div>\n\n    <!-- MODAL: Mensagens -->\n    <div id=\"modalMsg\" class=\"modal\">\n        <div class=\"glass w-full max-w-xs rounded-3xl p-6 text-center transform scale-95 transition-transform duration-300\">\n            <i data-lucide=\"info\" class=\"w-12 h-12 text-theme mx-auto mb-4\"><\/i>\n            <h2 id=\"msgTitle\" class=\"text-lg font-bold mb-2\">Mensagem<\/h2>\n            <p id=\"msgBody\" class=\"text-sm opacity-80 mb-6\">...<\/p>\n            <button onclick=\"closeModal('modalMsg')\" class=\"w-full py-3 rounded-xl bg-theme text-white font-bold shadow-glow active:scale-95\">OK<\/button>\n        <\/div>\n    <\/div>\n\n    <script>\n        lucide.createIcons();\n\n        setInterval(() => {\n            const d = new Date();\n            document.getElementById('headerClock').innerText = d.toLocaleTimeString('pt-BR');\n        }, 1000);\n\n        const AndroidBridge = {\n            connect: () => { if(window.Android) Android.connect(); },\n            getStatus: () => { return window.Android ? Android.getStatus() : \"DESCONECTADO\"; },\n            saveCredentials: (u,p,udp,v2,xr) => { if(window.Android) Android.saveCredentials(u,p,udp,v2,xr); },\n            getSavedCredentials: () => { return window.Android ? Android.getSavedCredentials() : \"{}\"; },\n            getLogs: () => { return window.Android ? Android.getLogs() : \"[]\"; },\n            clearLogs: () => { if(window.Android) Android.clearLogs(); },\n            openServers: () => { if(window.Android) Android.openServers(); },\n            openChat: () => { if(window.Android) Android.openChat(); },\n            checkUpdate: () => { if(window.Android) Android.checkUpdate(); showMsg(\"Atualização\", \"Verificando no servidor...\"); },\n            watchAd: () => { if(window.Android) Android.watchAd(); },\n            getTimeLeft: () => { return window.Android ? Android.getTimeLeft() : 0; },\n            isAdsEnabled: () => { return window.Android ? Android.isAdsEnabled() : false; },\n            getSelectedServer: () => { return window.Android ? Android.getSelectedServer() : \"{}\"; },\n            getVersion: () => { return window.Android ? Android.getVersion() : \"1.0\"; },\n            getFullConfig: () => { return window.Android ? Android.getFullConfig() : \"{}\"; }\n        };\n\n        function switchTab(tabId) {\n            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));\n            document.getElementById('tab-' + tabId).classList.add('active');\n            \n            document.querySelectorAll('.nav-btn').forEach(btn => {\n                btn.classList.remove('text-theme', 'active');\n                btn.classList.add('opacity-50');\n            });\n            const activeBtn = document.querySelector(`.nav-btn[onclick=\"switchTab('${tabId}')\"]`);\n            if(activeBtn) {\n                activeBtn.classList.remove('opacity-50');\n                activeBtn.classList.add('text-theme', 'active');\n            }\n        }\n\n        function setThemeColor(hex, glow) {\n            document.documentElement.style.setProperty('--theme-color', hex);\n            document.documentElement.style.setProperty('--theme-glow', glow);\n            localStorage.setItem('themeColor', hex);\n            localStorage.setItem('themeGlow', glow);\n            \n            \/\/ Recoloriza os anéis de pulso se estiver conectado\n            if(currentStatus === \"CONECTADO\") {\n                document.querySelectorAll('.pulse-ring').forEach(r => r.style.borderColor = \"#10b981\");\n            } else {\n                document.querySelectorAll('.pulse-ring').forEach(r => r.style.borderColor = hex);\n            }\n        }\n\n        function toggleDarkMode() {\n            const isDark = document.getElementById('darkModeToggle').checked;\n            if(isDark) document.documentElement.classList.add('dark');\n            else document.documentElement.classList.remove('dark');\n            localStorage.setItem('darkMode', isDark);\n        }\n\n        function showMsg(title, body) {\n            document.getElementById('msgTitle').innerText = title;\n            document.getElementById('msgBody').innerText = body;\n            const modal = document.getElementById('modalMsg');\n            modal.classList.add('active');\n            setTimeout(() => modal.firstElementChild.classList.remove('scale-95'), 10);\n        }\n\n        function closeModal(id) {\n            const modal = document.getElementById(id);\n            modal.firstElementChild.classList.add('scale-95');\n            setTimeout(() => modal.classList.remove('active'), 200);\n        }\n\n        \/\/ --- SISTEMA DE CONEXÃO E BOTÃO MULTICOLORIDO ---\n        let currentStatus = \"DESCONECTADO\";\n\n        function toggleConnection() {\n            \/\/ Vibração leve se suportada\n            if (navigator.vibrate) navigator.vibrate(50);\n            AndroidBridge.connect();\n        }\n\n        window.onVpnStatus = function(state, msg) {\n            currentStatus = state;\n            const btn = document.getElementById('btnConnect');\n            const icon = document.getElementById('connectIcon');\n            const text = document.getElementById('connectText');\n            const statusLabel = document.getElementById('statusLabel');\n            const rings = document.querySelectorAll('.pulse-ring');\n\n            statusLabel.innerText = state;\n            statusLabel.className = \"font-bold mt-1 \"; \/\/ reset\n\n            \/\/ Remove classes dinâmicas\n            btn.classList.remove('connected', 'connecting', 'stopping');\n            icon.className = \"w-10 h-10 mb-2 transition-transform\"; \/\/ reset\n\n            if (state === \"CONECTADO\") {\n                btn.classList.add('connected');\n                text.innerText = \"CONECTADO\";\n                icon.setAttribute(\"data-lucide\", \"shield-check\");\n                statusLabel.classList.add('text-green-400');\n                rings.forEach(r => {\n                    r.style.display = 'block';\n                    r.classList.add('connected-pulse'); \/\/ Pulso verde\n                });\n            } \n            else if (state === \"PARANDO\") {\n                btn.classList.add('stopping');\n                text.innerText = \"PARANDO...\";\n                icon.setAttribute(\"data-lucide\", \"power-off\");\n                statusLabel.classList.add('text-purple-400');\n                rings.forEach(r => r.style.display = 'none');\n            }\n            else if (state === \"DESCONECTADO\") {\n                text.innerText = \"CONECTAR\";\n                icon.setAttribute(\"data-lucide\", \"power\");\n                statusLabel.classList.add('text-red-500');\n                rings.forEach(r => {\n                    r.style.display = 'none';\n                    r.classList.remove('connected-pulse');\n                    r.style.borderColor = \"var(--theme-color)\";\n                });\n            } \n            else {\n                \/\/ INICIANDO, CONECTANDO, AUTENTICANDO, RECONECTANDO (Laranja)\n                btn.classList.add('connecting');\n                text.innerText = state;\n                icon.setAttribute(\"data-lucide\", \"loader-2\");\n                icon.classList.add('connecting-spinner');\n                statusLabel.classList.add('text-yellow-400');\n                rings.forEach(r => r.style.display = 'none');\n            }\n            lucide.createIcons();\n        };\n\n        \/\/ --- SISTEMA DE LOGS ---\n        function addLogEntry(level, message, time) {\n            const container = document.getElementById('logContainer');\n            const d = new Date(time || Date.now());\n            const timeStr = d.toLocaleTimeString('pt-BR');\n            \n            let color = \"text-gray-300\";\n            if(level === \"ERROR\") color = \"text-red-400\";\n            if(level === \"WARN\") color = \"text-yellow-400\";\n            if(level === \"SUCCESS\" || message.includes(\"conectado\")) color = \"text-green-400\";\n\n            if (container.innerHTML.includes(\"Nenhum log\")) container.innerHTML = \"\";\n\n            const div = document.createElement('div');\n            div.className = \"border-b border-white\/5 pb-1 mb-1\";\n            div.innerHTML = `<span class=\"opacity-50\">[${timeStr}]<\/span> <span class=\"${color}\">${message}<\/span>`;\n            \n            container.appendChild(div);\n            container.scrollTop = container.scrollHeight;\n        }\n\n        window.onLogAdded = function(logObj) {\n            addLogEntry(logObj.level, logObj.message, logObj.time);\n        };\n\n        window.onLogsCleared = function() {\n            document.getElementById('logContainer').innerHTML = '<div class=\"opacity-50 text-center mt-4\">Logs limpos.<\/div>';\n        };\n\n        \/\/ --- SISTEMA CHECK USER SOB DEMANDA ---\n        let lastCheckUserData = null;\n\n        window.onCheckUserReceived = function(data) {\n            \/\/ Salva globalmente mas NÃO ABRE automaticamente\n            lastCheckUserData = data;\n            \n            document.getElementById('cuUser').innerText = \"@\" + data.username;\n            const lim = data.isUnlimited ? \"∞\" : data.limiter_user;\n            document.getElementById('cuConns').innerText = `${data.count_connection} \/ ${lim}`;\n            document.getElementById('cuExpiry').innerText = data.expiration_date;\n            document.getElementById('cuDays').innerText = `${data.expiration_days} dias`;\n        };\n\n        \/\/ Função acionada pelo Botão \"Status da Conta\"\n        function openCheckUser() {\n            if (!lastCheckUserData) {\n                showMsg(\"Aguarde\", \"Os dados da sua conta não foram carregados ainda ou você não está conectado.\");\n                return;\n            }\n            const modal = document.getElementById('modalCheckUser');\n            modal.classList.add('active');\n            setTimeout(() => modal.firstElementChild.classList.remove('scale-95'), 10);\n        }\n\n        \/\/ --- AJUSTES \/ CREDENCIAIS ---\n        function loadSettings() {\n            try {\n                const creds = JSON.parse(AndroidBridge.getSavedCredentials());\n                document.getElementById('inpUser').value = creds.sshUser || \"\";\n                document.getElementById('inpPass').value = creds.sshPass || \"\";\n                document.getElementById('inpUdp').value = creds.udpToken || \"\";\n                document.getElementById('inpV2ray').value = creds.v2uuid || \"\";\n                document.getElementById('inpXray').value = creds.xrayId || \"\";\n            } catch(e){}\n        }\n\n        function saveSettings() {\n            const u = document.getElementById('inpUser').value;\n            const p = document.getElementById('inpPass').value;\n            const udp = document.getElementById('inpUdp').value;\n            const v2 = document.getElementById('inpV2ray').value;\n            const xr = document.getElementById('inpXray').value;\n            AndroidBridge.saveCredentials(u, p, udp, v2, xr);\n            showMsg(\"Sucesso\", \"Configurações salvas corretamente!\");\n        }\n\n        window.onServerChanged = function() { loadServerInfo(); };\n        window.onConfigUpdated = function(ver) { showMsg(\"Atualizado\", \"Nova versão carregada.\"); loadVersions(); };\n        window.onConfigReloaded = function() { loadVersions(); };\n\n        function loadServerInfo() {\n            try {\n                const s = JSON.parse(AndroidBridge.getSelectedServer());\n                if(s && s.Name) document.getElementById('serverName').innerText = s.Name;\n            } catch(e){}\n        }\n\n        function loadVersions() {\n            document.getElementById('appVersion').innerText = \"App: v\" + AndroidBridge.getVersion();\n            try {\n                const full = JSON.parse(AndroidBridge.getFullConfig());\n                if(full && full.Version) document.getElementById('jsonVersion').innerText = \"Config: v\" + full.Version;\n            } catch(e){}\n        }\n\n        \/\/ --- TEMPO \/ ADS ---\n        let timerInterval;\n        \n        function formatTime(ms) {\n            if(ms <= 0) return \"00:00:00\";\n            let seconds = Math.floor(ms \/ 1000);\n            let hours = Math.floor(seconds \/ 3600);\n            seconds %= 3600;\n            let minutes = Math.floor(seconds \/ 60);\n            seconds %= 60;\n            return [hours, minutes, seconds].map(v => v < 10 ? \"0\" + v : v).join(\":\");\n        }\n\n        function updateTimerUI() {\n            const adsEnabled = AndroidBridge.isAdsEnabled();\n            const timeText = document.getElementById('timeLeftText');\n\n            if (!adsEnabled) {\n                timeText.innerText = \"Ilimitado\";\n                timeText.classList.add('text-green-400');\n                if(timerInterval) clearInterval(timerInterval);\n                return;\n            }\n\n            let timeLeft = AndroidBridge.getTimeLeft();\n            timeText.innerText = formatTime(timeLeft);\n            \n            if(timerInterval) clearInterval(timerInterval);\n            \n            if (currentStatus === \"CONECTADO\" && timeLeft > 0) {\n                timerInterval = setInterval(() => {\n                    timeLeft -= 1000;\n                    if(timeLeft <= 0) {\n                        timeLeft = 0;\n                        clearInterval(timerInterval);\n                        if (currentStatus === \"CONECTADO\") toggleConnection();\n                    }\n                    timeText.innerText = formatTime(timeLeft);\n                }, 1000);\n            }\n        }\n\n        window.onTimeAdded = function(newTime) {\n            showMsg(\"Tempo Adicionado\", \"Seu tempo foi renovado com sucesso!\");\n            updateTimerUI();\n        };\n\n        window.onload = () => {\n            const savedHex = localStorage.getItem('themeColor');\n            const savedGlow = localStorage.getItem('themeGlow');\n            if(savedHex && savedGlow) setThemeColor(savedHex, savedGlow);\n            \n            const savedDark = localStorage.getItem('darkMode');\n            if(savedDark !== null) {\n                const isDark = savedDark === 'true';\n                document.getElementById('darkModeToggle').checked = isDark;\n                if(isDark) document.documentElement.classList.add('dark');\n                else document.documentElement.classList.remove('dark');\n            }\n\n            window.onVpnStatus(AndroidBridge.getStatus(), \"\");\n            loadSettings();\n            loadServerInfo();\n            loadVersions();\n            updateTimerUI();\n\n            try {\n                const logs = JSON.parse(AndroidBridge.getLogs());\n                if(logs.length > 0) {\n                    document.getElementById('logContainer').innerHTML = \"\";\n                    logs.forEach(l => addLogEntry(l.level, l.message, l.time));\n                }\n            } catch(e){}\n            \n            setInterval(() => { if (currentStatus === \"CONECTADO\") updateTimerUI(); }, 5000);\n        };\n    <\/script>\n<\/body>\n<\/html>@"
}
