DAL: UPDATE ══ -->\n<div class=\"mov\" id=\"mUP\">\n  <div class=\"modal glass\">\n    <div class=\"mhdr\">\n      <span class=\"mtitle\"><i class=\"fa-solid fa-rotate\" style=\"color:var(--gold);margin-right:8px\"><\/i>ATUALIZAÇÃO<\/span>\n      <button class=\"mclose\" onclick=\"closeMod('mUP')\"><i class=\"fa-solid fa-xmark\"><\/i><\/button>\n    <\/div>\n    <div style=\"display:flex;align-items:center;gap:12px;padding:16px;background:rgba(255,209,102,.05);border:1px solid rgba(255,209,102,.18);border-radius:var(--r-md);margin-bottom:14px;\">\n      <div style=\"width:44px;height:44px;border-radius:11px;background:rgba(255,209,102,.14);color:var(--gold);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0\"><i class=\"fa-solid fa-circle-up\"><\/i><\/div>\n      <div style=\"flex:1\">\n        <div style=\"font-weight:700;font-size:.9rem\">Versão do Config<\/div>\n        <div style=\"font-size:.74rem;color:var(--muted);margin-top:3px\" id=\"upDesc\">—<\/div>\n        <div class=\"pbw\" style=\"margin-top:8px\"><div class=\"pb2\" id=\"upProg\" style=\"width:0%\"><\/div><\/div>\n      <\/div>\n    <\/div>\n    <div id=\"releaseNotesWrap\" style=\"display:none;margin-bottom:14px;\">\n      <div style=\"font-size:.72rem;color:var(--muted);margin-bottom:6px;font-family:var(--ft);letter-spacing:.08em;\">RELEASE NOTES<\/div>\n      <div class=\"relnotes\" id=\"releaseNotes\"><\/div>\n    <\/div>\n    <button style=\"width:100%;padding:13px;border-radius:11px;border:none;background:linear-gradient(135deg,var(--gold),#ff9500);color:#1a0800;font-family:var(--ft);font-size:.82rem;font-weight:700;cursor:pointer;transition:all .3s ease;box-shadow:0 0 14px rgba(255,209,102,.3);\" onclick=\"doCheckUpdate()\">\n      <i class=\"fa-solid fa-bolt\" style=\"margin-right:7px\"><\/i>VERIFICAR & ATUALIZAR\n    <\/button>\n  <\/div>\n<\/div>\n\n<!-- ══ MODAL: NOTIFICAÇÕES ══ -->\n<div class=\"mov\" id=\"mNT\">\n  <div class=\"modal glass\">\n    <div c