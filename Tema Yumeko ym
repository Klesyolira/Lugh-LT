 9px var(--red-glow);}\n.tgl input:checked+.tslider::before{transform:translateX(21px);background:#fff;}\n.tgrid{display:flex;gap:9px;flex-wrap:wrap;margin-top:10px;}\n.tsw{width:42px;height:42px;border-radius:11px;cursor:pointer;border:2px solid transparent;transition:var(--tr);}\n.tsw:hover,.tsw.active{border-color:#fff;transform:scale(1.1);box-shadow:0 0 12px rgba(255,255,255,.25);}\n.t-dk{background:linear-gradient(135deg,#0a0608,#e01b3c);}\n.t-lt{background:linear-gradient(135deg,#fdf0f2,#e01b3c);}\n.t-sk{background:linear-gradient(135deg,#1a0a12,#ff6b8a);}\n.t-cy{background:linear-gradient(135deg,#000d1a,#00f5ff);}\n.t-ob{background:linear-gradient(135deg,#050505,#c0c0c0);}\n.ssel{background:var(--glass);border:1px solid var(--gb);border-radius:7px;padding:6px 11px;color:var(--txt);font-family:var(--fb);font-size:.83rem;outline:none;cursor:pointer;transition:var(--tr);}\n.ssel:focus{border-color:var(--red);}\n.ssel option{background:#1a0508;}\n.sinp2{background:var(--glass);border:1px solid var(--gb);border-radius:7px;padding:6px 11px;color:var(--txt);font-family:var(--fb);font-size:.83rem;outline:none;transition:var(--tr);}\n.sinp2:focus{border-color:var(--red);}\n\n\/* CREDENTIALS *\/\n.cred-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:9px;margin-top:10px;}\n.cf{display:flex;flex-direction:column;gap:4px;}\n.cf label{font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;}\n.cf input{background:rgba(0,0,0,.3);border:1px solid var(--gb);border-radius:var(--r-sm);padding:8px 11px;color:var(--txt);font-family:monospace;font-size:.83rem;outline:none;transition:var(--tr);}\n.cf input:focus{border-color:var(--red);box-shadow:0 0 8px rgba(224,27,60,.18);}\n.btn-save{margin-top:13px;padding:10px 26px;border-radius:10px;border:none;background:linear-gradient(135deg,var(--red),var(--red-deep));color:#fff;font-family:var(--ft);font-size:.78rem;font-weight:700;cursor:pointer;transition:var(--tr);box-shadow:0 0 