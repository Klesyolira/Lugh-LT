xibir Interstitial\n            <\/button>\n          <\/div>\n        <\/div>\n\n        <!-- SOBRE -->\n        <div class=\"ssec glass\">\n          <h4><i class=\"fa-solid fa-circle-info\" style=\"margin-right:7px\"><\/i>SOBRE<\/h4>\n          <div class=\"srow\"><div class=\"slbll\">App<\/div><span style=\"color:var(--red);font-family:var(--ft);font-size:.8rem\">Yumeko BK<\/span><\/div>\n          <div class=\"srow\"><div class=\"slbll\">Versão<\/div><span class=\"badge b-app\" id=\"cfgVer\">—<\/span><\/div>\n          <div class=\"srow\"><div class=\"slbll\">Build<\/div><span style=\"font-size:.74rem;color:var(--muted);font-family:monospace\">20260531-stable<\/span><\/div>\n          <div class=\"srow\"><div class=\"slbll\">Tempo Livre<\/div><span style=\"font-family:var(--ft);font-size:.8rem;color:var(--gold)\" id=\"cfgTimeLeft\">—<\/span><\/div>\n          <div style=\"margin-top:12px;display:flex;gap:7px;\">\n            <button class=\"bsm\" style=\"flex:1;justify-content:center\" onclick=\"doCheckUpdate()\"><i class=\"fa-solid fa-rotate\"><\/i> Atualizar<\/button>\n            <button class=\"bsm\" style=\"flex:1;justify-content:center\" onclick=\"loadFromAndroid()\"><i class=\"fa-solid fa-sync\"><\/i> Recarregar<\/button>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n\n  <\/main>\n\n  <footer class=\"ftr\">\n    <span class=\"fcpy\">© 2026 Yumeko BK · 由夢子 次世代<\/span>\n    <div class=\"flnks\"><a href=\"#\">Termos<\/a><a href=\"#\">Privacidade<\/a><a href=\"#\">Suporte<\/a><\/div>\n  <\/footer>\n<\/div>\n\n<script>\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ BRIDGE — wrapper seguro para window.Android\n\/\/ ═══════════════════════════════════════════════════════\nconst A = {\n  _c(fn,...args){\n    try{ if(window.Android&&typeof window.Android[fn]==='function') return window.Android[fn](...args); }catch(e){}\n    return null;\n  },\n  connect()               { this._c('connect'); },\n  getStatus()             { return this._c('getStatus')||'DESCONECTADO'; },\n  getServers()            { try{return JSON.parse(this._c('getServers')||'[]');}catch(e){return[];} },\n  getSelectedServer()     { try{return JSON.parse(this._c('getSelectedServer')||'{}');}catch(e){return{};} },\n  selectServer(i)         { this._c('selectServer',i); },\n  getMultiServers()       { try{return JSON.parse(this._c('getMultiServers')||'[]');}catch(e){return[];} },\n  getSelectedMultiServer(){ try{return JSON.parse(this._c('getSelectedMultiServer')||'{}');}catch(e){return{};} },\n  selectMultiServer(i)    { this._c('selectMultiServer',i); },\n  getVersion()            { return this._c('getVersion')||'—'; },\n  getNote()               { return this._c('getNote')||''; },\n  getLogs()               { try{return JSON.parse(this._c('getLogs')||'[]');}catch(e){return[];} },\n  clearLogs()             { this._c('clearLogs'); },\n  checkUpdate()           { this._c('checkUpdate'); },\n  isAdsEnabled()          { const r=this._c('isAdsEnabled'); return r===null?false:!!r; },\n  getTimeLeft()           { return Number(this._c('getTimeLeft')||0); },\n  watchAd()               { this._c('watchAd'); },\n  openChat()              { this._c('openChat'); },\n  openServers()           { this._c('openServers'); },\n  requestInterstitial()   { this._c('requestInterstitial'); },\n  saveCredentials(u,p,udp,v2,xr){ this._c('saveCredentials',u,p,udp,v2,xr); },\n  getSavedCredentials()   { try{return JSON.parse(this._c('getSavedCredentials')||'{}');}catch(e){return{};} },\n  getFullConfig()         { try{return JSON.parse(this._c('getFullConfig')||'{}');}catch(e){return{};} },\n};\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ PARTICLES\n\/\/ ═══════════════════════════════════════════════════════\n(()=>{\n  const c=document.getElementById('ptc');\n  const cols=['var(--red)','var(--sakura)','var(--gold)','var(--cyan)'];\n  for(let i=0;i<35;i++){\n    const p=document.createElement('div'); p.className='pt';\n    p.style.cssText=`left:${Math.random()*100}%;animation-duration:${6+Math.random()*12}s;animation-delay:${Math.random()*12}s;background:${cols[i%4]};width:${1+Math.random()*3}px;height:${1+Math.random()*3}px;`;\n    c.appendChild(p);\n  }\n})();\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ CLOCK\n\/\/ ═══════════════════════════════════════════════════════\nfunction tickClock(){\n  const n=new Date(),p=v=>String(v).padStart(2,'0');\n  document.getElementById('clk').textContent=`${p(n.getHours())}:${p(n.getMinutes())}:${p(n.getSeconds())}`;\n  document.getElementById('clkd').textContent=n.toLocaleDateString('pt-BR',{weekday:'short',day:'2-digit',month:'short'});\n}\nsetInterval(tickClock,1000); tickClock();\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ TOAST\n\/\/ ═══════════════════════════════════════════════════════\nfunction toast(msg,type='in',dur=3000){\n  const icons={ok:'circle-check',er:'circle-xmark',in:'circle-info',wn:'triangle-exclamation'};\n  const cols={ok:'var(--green)',er:'var(--red)',in:'var(--cyan)',wn:'var(--gold)'};\n  const t=document.createElement('div');\n  t.className=`tst tst-${type}`;\n  t.innerHTML=`<i class=\"fa-solid fa-${icons[type]||'circle-info'}\" style=\"color:${cols[type]||cols.in}\"><\/i>${msg}`;\n  document.getElementById('TC').appendChild(t);\n  setTimeout(()=>{t.classList.add('exit');setTimeout(()=>t.remove(),300);},dur);\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ MODALS\n\/\/ ═══════════════════════════════════════════════════════\nfunction openMod(id){ document.getElementById(id).classList.add('open'); }\nfunction closeMod(id){ document.getElementById(id).classList.remove('open'); }\ndocument.querySelectorAll('.mov').forEach(m=>m.addEventListener('click',e=>{ if(e.target===m) m.classList.remove('open'); }));\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ TABS\n\/\/ ═══════════════════════════════════════════════════════\nfunction goTab(id,btn){\n  document.querySelectorAll('.tp').forEach(p=>p.classList.remove('active'));\n  document.querySelectorAll('.nt').forEach(b=>b.classList.remove('active'));\n  document.getElementById('tab-'+id).classList.add('active');\n  if(btn) btn.classList.add('active');\n  if(id==='logs')     loadLogsFromApp();\n  if(id==='servers')  loadServers();\n  if(id==='settings'){ loadFromAndroid(); loadCredentials(); }\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ ─── CALLBACKS DO ANDROID → HTML ───────────────────────\n\/\/ ═══════════════════════════════════════════════════════\n\n\/\/ Estado VPN em tempo real\nwindow.onVpnStatus = function(state, detail){\n  listenerActive = true;\n  updateStatusUI(state, detail||'');\n};\n\n\/\/ Log individual em tempo real\nwindow.onLogAdded = function(entry){\n  pushLog(entry);\n};\n\n\/\/ Limpar logs\nwindow.onLogsCleared = function(){\n  allLogs=[]; renderLogs();\n};\n\n\/\/ Servidor ou config mudou\nwindow.onServerChanged = function(){\n  loadActiveServer();\n};\n\n\/\/ Config atualizado pelo background worker\nwindow.onConfigUpdated = function(version){\n  loadFromAndroid();\n  if(version) toast(`Config atualizado → v${version}`,'ok',4000);\n};\n\n\/\/ Config recarregado do disco (sem nova versão)\nwindow.onConfigReloaded = function(){\n  loadFromAndroid();\n};\n\n\/\/ CheckUser recebido após conexão\nwindow.onCheckUserReceived = function(data){\n  updateCheckUser(data);\n};\n\n\/\/ Anúncio — callbacks\nwindow.onAdLoading = function(){ toast('Carregando anúncio...','in'); };\nwindow.onAdFailed  = function(){ toast('Falha ao exibir anúncio','er'); };\nwindow.onTimeAdded = function(timeLeft){\n  toast('+2h adicionadas ao seu tempo! ✓','ok',4000);\n  updateFreeTierUI(timeLeft);\n};\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ ─── STATUS VPN ────────────────────────────────────────\n\/\/ ═══════════════════════════════════════════════════════\nlet connTimerInt=null, connSeconds=0;\nlet trafficSim=null;\nlet listenerActive=false; \/\/ true quando Android chamou onVpnStatus pelo menos uma vez\n\nconst STATE_MAP = {\n  'CONECTADO':    {icon:'🟢',txt:'CONECTADO',   chip:'Conectado',     cls:'connected', ico:'circle-stop',     lbl:'DESCONECTAR',  dot:'dg'},\n  'DESCONECTADO': {icon:'🔴',txt:'OFFLINE',     chip:'Desconectado',  cls:'',          ico:'bolt',             lbl:'CONECTAR',     dot:'dr'},\n  'CONECTANDO':   {icon:'🟡',txt:'CONECTANDO',  chip:'Conectando...', cls:'connecting',ico:'spinner fa-spin',  lbl:'AGUARDE...',   dot:'dy'},\n  'INICIANDO':    {icon:'🟡',txt:'INICIANDO',   chip:'Iniciando...',  cls:'connecting',ico:'spinner fa-spin',  lbl:'AGUARDE...',   dot:'dy'},\n  'AUTENTICANDO': {icon:'🟡',txt:'AUTENTICANDO',chip:'Autenticando...',cls:'connecting',ico:'spinner fa-spin', lbl:'AGUARDE...',   dot:'dy'},\n  'RECONECTANDO': {icon:'🟡',txt:'RECONECTANDO',chip:'Reconectando...',cls:'connecting',ico:'spinner fa-spin', lbl:'RECONECTANDO', dot:'dy'},\n  'PARANDO':      {icon:'🔴',txt:'PARANDO',     chip:'Parando...',    cls:'stopping',  ico:'spinner fa-spin',  lbl:'PARANDO...',   dot:'dy'},\n  'AGUARDANDO':   {icon:'🟡',txt:'AGUARDANDO',  chip:'Aguardando...',cls:'connecting', ico:'spinner fa-spin',  lbl:'AGUARDE...',   dot:'dy'},\n};\n\nfunction updateStatusUI(state, detail){\n  const s = STATE_MAP[state] || STATE_MAP['DESCONECTADO'];\n\n  document.getElementById('stIcon').textContent = s.icon;\n  document.getElementById('stTxt').textContent  = s.txt;\n  document.getElementById('stTxt').style.color  = s.dot==='dg'?'var(--green)':s.dot==='dy'?'var(--gold)':'var(--muted)';\n  document.getElementById('stChipLbl').textContent = s.chip;\n  document.getElementById('stDot').className = 'dot '+s.dot;\n\n  const btn = document.getElementById('cbtn');\n  btn.className = 'cbtn '+(s.cls||'');\n  document.getElementById('cbtnIco').className = `fa-solid fa-${s.ico}`;\n  document.getElementById('cbtnLbl').textContent = s.lbl;\n\n  if(state==='CONECTADO'){\n    document.getElementById('pingDot').className='dot dg';\n    document.getElementById('ipDot').className='dot dg';\n    document.getElementById('badgeLive').textContent='● CONECTADO';\n    startConnTimer(); startTrafficSim();\n    loadActiveServer();\n  } else {\n    document.getElementById('badgeLive').textContent='● LIVE';\n    if(state==='DESCONECTADO'||state==='PARANDO'){\n      stopConnTimer();\n      clearInterval(trafficSim);\n      document.getElementById('dlSt').textContent='—';\n      document.getElementById('ulSt').textContent='—';\n      document.getElementById('pingSt').textContent='—';\n      document.getElementById('protoSt').textContent='—';\n      document.getElementById('pingDot').className='dot dgr';\n      document.getElementById('ipDot').className='dot dgr';\n      document.getElementById('pingLbl').textContent='Ping: —';\n      document.getElementById('ipLbl').textContent='IP: —';\n      document.getElementById('cuInline').classList.remove('show');\n    }\n  }\n}\n\nfunction toggleConnect(){\n  \/\/ Dispara connect no app — estado real vem via onVpnStatus\n  A.connect();\n  \/\/ Feedback visual imediato apenas se ainda desconectado\n  const cur = A.getStatus();\n  if(cur==='DESCONECTADO') updateStatusUI('CONECTANDO','');\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ TIMER DE SESSÃO\n\/\/ ═══════════════════════════════════════════════════════\nfunction startConnTimer(){\n  connSeconds=0; stopConnTimer();\n  connTimerInt=setInterval(()=>{\n    connSeconds++;\n    const h=Math.floor(connSeconds\/3600),m=Math.floor((connSeconds%3600)\/60),s=connSeconds%60;\n    const p=v=>String(v).padStart(2,'0');\n    document.getElementById('timerLbl').textContent=`${p(h)}:${p(m)}:${p(s)}`;\n  },1000);\n}\nfunction stopConnTimer(){\n  clearInterval(connTimerInt);\n  document.getElementById('timerLbl').textContent='00:00:00';\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ TRAFFIC SIM (visual — app não expõe bytes em tempo real)\n\/\/ ═══════════════════════════════════════════════════════\nfunction startTrafficSim(){\n  clearInterval(trafficSim);\n  trafficSim=setInterval(()=>{\n    if(A.getStatus()!=='CONECTADO'){clearInterval(trafficSim);return;}\n    document.getElementById('dlSt').textContent=(0.3+Math.random()*6).toFixed(1);\n    document.getElementById('ulSt').textContent=(0.05+Math.random()*1.5).toFixed(1);\n    const ping=Math.floor(14+Math.random()*55);\n    document.getElementById('pingSt').textContent=ping;\n    document.getElementById('pingLbl').textContent='Ping: '+ping+'ms';\n  },1500);\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ FREE TIER — tempo restante + botão anúncio\n\/\/ ═══════════════════════════════════════════════════════\nconst FREE_MAX_MS = 2 * 3600 * 1000; \/\/ 2 horas = máximo de 1 anúncio\n\nfunction updateFreeTierUI(timeLeftMs){\n  const adsOn = A.isAdsEnabled();\n  const freeBar = document.getElementById('freeBar');\n  const btnAd   = document.getElementById('btnAd');\n  const tierBadge = document.getElementById('badgeTier');\n\n  if(!adsOn){\n    \/\/ VIP: sem barra, sem botão ad\n    freeBar.classList.remove('show');\n    btnAd.classList.remove('show');\n    tierBadge.style.display='none';\n    tierBadge.textContent='VIP';\n    tierBadge.className='badge b-vip';\n    tierBadge.style.display='inline';\n    document.getElementById('cfgTimeLeft').textContent='Ilimitado';\n    return;\n  }\n\n  \/\/ FREE tier\n  tierBadge.className='badge b-free';\n  tierBadge.textContent='FREE';\n  tierBadge.style.display='inline';\n\n  if(timeLeftMs>0){\n    freeBar.classList.add('show');\n    const pct = Math.min((timeLeftMs\/FREE_MAX_MS)*100,100);\n    document.getElementById('freeBarFill').style.width=pct+'%';\n\n    const h=Math.floor(timeLeftMs\/3600000);\n    const m=Math.floor((timeLeftMs%3600000)\/60000);\n    const s=Math.floor((timeLeftMs%60000)\/1000);\n    const p=v=>String(v).padStart(2,'0');\n    const txt=`${p(h)}:${p(m)}:${p(s)}`;\n    document.getElementById('freeBarTime').textContent=txt;\n    document.getElementById('cfgTimeLeft').textContent=txt;\n    btnAd.classList.remove('show'); \/\/ já tem tempo, não mostra botão\n  } else {\n    freeBar.classList.remove('show');\n    btnAd.classList.add('show');\n    document.getElementById('cfgTimeLeft').textContent='0:00:00';\n  }\n}\n\nfunction doWatchAd(){\n  A.watchAd();\n}\n\n\/\/ Polling do tempo restante a cada 10s (free tier)\nsetInterval(()=>{\n  if(A.isAdsEnabled()) updateFreeTierUI(A.getTimeLeft());\n},10000);\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ LOAD FROM ANDROID\n\/\/ ═══════════════════════════════════════════════════════\nfunction loadFromAndroid(){\n  const cfg = A.getFullConfig();\n  const version = cfg.Version || A.getVersion();\n  const note    = cfg.ReleaseNotes || cfg.releaseNotes || A.getNote();\n  const adsOn   = A.isAdsEnabled();\n  const timeLeft= A.getTimeLeft();\n\n  \/\/ Badges & versão\n  document.getElementById('badgeApp').textContent  = 'App v'+version;\n  document.getElementById('badgeJson').textContent = 'JSON v'+version;\n  document.getElementById('cfgVer').textContent    = version;\n  document.getElementById('cfgNote').textContent   = note||'—';\n  document.getElementById('cfgAds').textContent    = adsOn?'Ativado (Free)':'Desativado (VIP)';\n\n  \/\/ Update modal\n  document.getElementById('upDesc').textContent = 'Versão atual: v'+version;\n  if(note){\n    document.getElementById('releaseNotes').textContent=note;\n    document.getElementById('releaseNotesWrap').style.display='block';\n  }\n\n  \/\/ Free tier UI\n  updateFreeTierUI(timeLeft);\n\n  \/\/ Servidor ativo\n  loadActiveServer();\n\n  \/\/ Notificações\n  populateNotifs(cfg, note, version, adsOn);\n}\n\nfunction loadActiveServer(){\n  const sel = A.getSelectedServer();\n  if(sel && sel.Name){\n    renderFlagInWrap('activeFlagWrap','activeFlagEmoji', sel.Flag||'br', sel.FlagUrl||null);\n    document.getElementById('activeSrvName').textContent = sel.Name;\n    document.getElementById('activeSrvInfo').textContent = sel.Info||'—';\n    document.getElementById('protoSt').textContent       = sel.Info||'—';\n    document.getElementById('cfgProto').textContent      = sel.Info||'—';\n  }\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ FLAG — renderiza emoji ou <img> sem trocar o elemento pai\n\/\/ ═══════════════════════════════════════════════════════\nfunction flagEmoji(code){\n  if(!code||code.length<2) return '🏳️';\n  const c=(code||'').toUpperCase().replace('.PNG','').slice(0,2);\n  try{ return String.fromCodePoint(0x1F1E6-65+c.charCodeAt(0), 0x1F1E6-65+c.charCodeAt(1)); }\n  catch(e){ return '🌐'; }\n}\n\nfunction renderFlagInWrap(wrapId, emojiId, flagCode, flagUrl){\n  const wrap = document.getElementById(wrapId);\n  if(!wrap) return;\n  if(flagUrl){\n    wrap.innerHTML=`<img src=\"${flagUrl}\" class=\"sflag-img\" id=\"${emojiId}\" onerror=\"this.outerHTML='<span class=sflag-emoji id=${emojiId}>${flagEmoji(flagCode)}<\/span>'\">`;\n  } else {\n    wrap.innerHTML=`<span class=\"sflag-emoji\" id=\"${emojiId}\">${flagEmoji(flagCode)}<\/span>`;\n  }\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ SERVERS\n\/\/ ═══════════════════════════════════════════════════════\nlet srvMode='normal', allSrvs=[], allMulti=[], srvFilter='';\n\nfunction loadServers(){\n  allSrvs  = A.getServers();\n  allMulti = A.getMultiServers();\n  renderSrvList();\n}\n\nfunction switchSrvTab(mode,btn){\n  srvMode=mode;\n  document.querySelectorAll('.stab').forEach(b=>b.classList.remove('active'));\n  btn.classList.add('active');\n  renderSrvList();\n}\n\nfunction filterSrv(q){ srvFilter=q.toLowerCase(); renderSrvList(); }\n\nfunction renderSrvList(){\n  const arr  = srvMode==='normal' ? allSrvs : allMulti;\n  const selObj = srvMode==='normal' ? A.getSelectedServer() : A.getSelectedMultiServer();\n  const selPos = selObj ? (selObj.position||0) : 0;\n\n  const filtered = srvFilter\n    ? arr.filter(s=>(s.Name||'').toLowerCase().includes(srvFilter)||(s.Info||'').toLowerCase().includes(srvFilter))\n    : arr;\n\n  const el = document.getElementById('srvList');\n  if(!filtered.length){ el.innerHTML='<div class=\"sempty\">Nenhum servidor disponível<\/div>'; return; }\n\n  el.innerHTML = filtered.map(s=>{\n    const isSel = s.position===selPos;\n    const flagHtml = s.FlagUrl\n      ? `<img src=\"${s.FlagUrl}\" class=\"sflag-img\" onerror=\"this.outerHTML='<span class=sflag-emoji>${flagEmoji(s.Flag||'br')}<\/span>'\">`\n      : `<span class=\"sflag-emoji\">${flagEmoji(s.Flag||'br')}<\/span>`;\n    const bars = [1,2,3,4].map(i=>`<div class=\"br${i<=3||isSel?' on':''}\"><\/div>`).join('');\n    return `<div class=\"srv${isSel?' sel':''}\" onclick=\"pickServer(${s.position})\">\n      ${flagHtml}\n      <div class=\"sinfo\">\n        <div class=\"sname\">${s.Name||'—'}<\/div>\n        <div class=\"shost\">${s.Info||'Direct'}<\/div>\n      <\/div>\n      <div class=\"smeta\">\n        <div class=\"sbars\">${bars}<\/div>\n        <span class=\"pb ${isSel?'p-lo':'p-mi'}\">${s.Info||'—'}<\/span>\n      <\/div>\n    <\/div>`;\n  }).join('');\n}\n\nfunction pickServer(pos){\n  if(srvMode==='normal') A.selectServer(pos);\n  else A.selectMultiServer(pos);\n  loadServers();\n  loadActiveServer();\n  toast('Servidor selecionado','ok');\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ CHECK USER\n\/\/ ═══════════════════════════════════════════════════════\nfunction updateCheckUser(data){\n  const lim  = data.isUnlimited ? '∞' : (data.limiter_user||data.limiterUser||'—');\n  const conn = (data.count_connection||data.countConnection||'0')+' \/ '+lim;\n  const exp  = data.expiration_date||data.expirationDate||'—';\n  const days = data.expiration_days||data.expirationDays||'—';\n  const user = data.username||'—';\n\n  \/\/ Modal\n  document.getElementById('cuModal').innerHTML=`\n    <div class=\"cu-grid\" style=\"grid-template-columns:repeat(2,1fr)\">\n      <div class=\"cu-item\"><div class=\"cli\">Usuário<\/div><div class=\"clv\">${user}<\/div><\/div>\n      <div class=\"cu-item\"><div class=\"cli\">Conexões<\/div><div class=\"clv\">${conn}<\/div><\/div>\n      <div class=\"cu-item\"><div class=\"cli\">Vencimento<\/div><div class=\"clv\" style=\"font-size:.75rem\">${exp}<\/div><\/div>\n      <div class=\"cu-item\"><div class=\"cli\">Dias Restantes<\/div><div class=\"clv\">${days} dias<\/div><\/div>\n    <\/div>`;\n\n  \/\/ Inline connect\n  document.getElementById('cu_user').textContent = user;\n  document.getElementById('cu_conn').textContent = conn;\n  document.getElementById('cu_exp').textContent  = exp;\n  document.getElementById('cu_days').textContent = days+' dias';\n  document.getElementById('cuInline').classList.add('show');\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ CREDENTIALS\n\/\/ ═══════════════════════════════════════════════════════\nfunction loadCredentials(){\n  const c = A.getSavedCredentials();\n  if(!c) return;\n  if(c.sshUser)  document.getElementById('credUser').value  = c.sshUser;\n  if(c.sshPass)  document.getElementById('credPass').value  = c.sshPass;\n  if(c.udpToken) document.getElementById('credUDP').value   = c.udpToken;\n  if(c.v2uuid)   document.getElementById('credV2').value    = c.v2uuid;\n  if(c.xrayId)   document.getElementById('credXray').value  = c.xrayId;\n}\nfunction saveCreds(){\n  A.saveCredentials(\n    document.getElementById('credUser').value.trim(),\n    document.getElementById('credPass').value.trim(),\n    document.getElementById('credUDP').value.trim(),\n    document.getElementById('credV2').value.trim(),\n    document.getElementById('credXray').value.trim()\n  );\n  toast('Credenciais salvas!','ok');\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ LOGS\n\/\/ ═══════════════════════════════════════════════════════\nlet allLogs=[], logFilter='all';\n\nfunction pushLog(entry){\n  allLogs.push(entry);\n  if(allLogs.length>500) allLogs.shift(); \/\/ limite circular\n  if(document.getElementById('tab-logs').classList.contains('active')) renderLogs();\n}\n\nfunction loadLogsFromApp(){\n  const raw = A.getLogs();\n  \/\/ Mescla evitando duplicatas por timestamp\n  const times = new Set(allLogs.map(l=>String(l.time)));\n  for(const l of raw){ if(!times.has(String(l.time))) allLogs.push(l); }\n  allLogs.sort((a,b)=>Number(a.time)-Number(b.time));\n  renderLogs();\n}\n\nfunction renderLogs(){\n  const box=document.getElementById('lbox');\n  const list = logFilter==='all'\n    ? allLogs\n    : allLogs.filter(l=>(l.level||'INFO').toUpperCase()===logFilter.toUpperCase());\n  if(!list.length){ box.innerHTML='<div style=\"color:var(--dim);padding:10px;text-align:center\">Nenhum log<\/div>'; return; }\n  box.innerHTML=list.map(l=>{\n    const ts = l.time ? new Date(Number(l.time)).toLocaleTimeString('pt-BR') : '--:--:--';\n    const lv = (l.level||'INFO').toUpperCase();\n    const msg= (l.message||l.msg||'').slice(0,300).replace(\/<\/g,'&lt;');\n    return `<div class=\"le ${lv}\"><span class=\"lt\">${ts}<\/span><span class=\"ll ${lv}\">${lv}<\/span><span class=\"lm\">${msg}<\/span><\/div>`;\n  }).join('');\n  box.scrollTop=box.scrollHeight;\n}\n\nfunction setLogFilter(f,btn){\n  logFilter=f;\n  document.querySelectorAll('.lf').forEach(b=>b.classList.remove('active'));\n  btn.classList.add('active');\n  renderLogs();\n}\nfunction doAndroidClearLogs(){ A.clearLogs(); allLogs=[]; renderLogs(); toast('Logs limpos','in'); }\nfunction exportLogs(){\n  const txt=allLogs.map(l=>`[${new Date(Number(l.time||0)).toISOString()}] [${l.level||'INFO'}] ${l.message||l.msg||''}`).join('\\n');\n  const a=document.createElement('a');\n  a.href='data:text\/plain;charset=utf-8,'+encodeURIComponent(txt);\n  a.download='yumeko_logs_'+Date.now()+'.txt'; a.click();\n  toast('Logs exportados!','ok');\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ CHAT\n\/\/ ═══════════════════════════════════════════════════════\nconst chatReplies=[\n  'Entendido! Vou verificar isso. ⚔️',\n  'Obrigado por contatar o suporte Yumeko BK!',\n  'Para problemas de conexão, tente trocar o servidor.',\n  'Nossa equipe está disponível 24\/7 🌸',\n  'Verifique o protocolo nas configurações.',\n  'Ping elevado? Tente um servidor mais próximo!',\n  'Credenciais incorretas causam falha de autenticação.',\n  'Para modo VIP, desative os Ads nas configurações.',\n];\nfunction sendChat(){\n  const inp=document.getElementById('cinp'),val=inp.value.trim();\n  if(!val) return;\n  appendMsg(val,true); inp.value='';\n  setTimeout(()=>appendMsg(chatReplies[Math.floor(Math.random()*chatReplies.length)],false),600+Math.random()*900);\n}\nfunction appendMsg(text,sent){\n  const n=new Date(),t=String(n.getHours()).padStart(2,'0')+':'+String(n.getMinutes()).padStart(2,'0');\n  const d=document.createElement('div'); d.className='msg '+(sent?'sent':'received');\n  d.innerHTML=`${!sent?'<div class=\"mav\">🤖<\/div>':''}\n    <div><div class=\"mbbl\">${text}<\/div><div class=\"mtime\">${t}<\/div><\/div>\n    ${sent?'<div class=\"mav\">👤<\/div>':''}`;\n  const m=document.getElementById('cmsgs'); m.appendChild(d); m.scrollTop=m.scrollHeight;\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ SPEED TEST\n\/\/ ═══════════════════════════════════════════════════════\nlet spRunning=false;\nfunction runSpeed(){\n  if(spRunning) return;\n  spRunning=true;\n  const btn=document.getElementById('spBtn');\n  btn.innerHTML='<i class=\"fa-solid fa-spinner fa-spin\" style=\"margin-right:7px\"><\/i>TESTANDO...';\n  btn.disabled=true;\n  document.getElementById('spPW').style.display='block';\n  setGauge('dl',0,200); setGauge('ul',0,200);\n  document.getElementById('dlGV').textContent='0';\n  document.getElementById('ulGV').textContent='0';\n\n  setPhase('Medindo ping...',5);\n  setTimeout(()=>{\n    document.getElementById('spPing').textContent=(12+Math.floor(Math.random()*45))+'ms';\n    document.getElementById('spJitter').textContent=(1+Math.random()*4).toFixed(1)+'ms';\n    setPhase('Testando download...',18);\n    let dl=0; const dlT=25+Math.random()*80;\n    const dt=setInterval(()=>{ dl=Math.min(dl+dlT\/22,dlT); document.getElementById('dlGV').textContent=dl.toFixed(0); setGauge('dl',dl,200); setPhase('Testando download...',18+(dl\/dlT)*42); if(dl>=dlT)clearInterval(dt); },110);\n    setTimeout(()=>{\n      setPhase('Testando upload...',62);\n      let ul=0; const ulT=8+Math.random()*35;\n      const ut=setInterval(()=>{ ul=Math.min(ul+ulT\/22,ulT); document.getElementById('ulGV').textContent=ul.toFixed(0); setGauge('ul',ul,200); setPhase('Testando upload...',62+(ul\/ulT)*34); if(ul>=ulT)clearInterval(ut); },110);\n      setTimeout(()=>{\n        setPhase('Concluído! ✓',100);\n        document.getElementById('spLoss').textContent=(Math.random()*.4).toFixed(1)+'%';\n        const sel=A.getSelectedServer();\n        document.getElementById('spSrv').textContent=sel&&sel.Name?sel.Name.slice(0,14):'Local';\n        btn.innerHTML='<i class=\"fa-solid fa-rotate\" style=\"margin-right:7px\"><\/i>NOVO TESTE';\n        btn.disabled=false; spRunning=false;\n        toast(`Download: ${dlT.toFixed(0)} Mbps`,'ok');\n        setTimeout(()=>document.getElementById('spPW').style.display='none',2000);\n      },2800);\n    },2600);\n  },500);\n}\nfunction setPhase(t,p){ document.getElementById('spPhase').textContent=t; document.getElementById('spPB').style.width=p+'%'; }\nfunction setGauge(tp,val,max){ document.getElementById(tp+'GF').style.strokeDashoffset=326.7-(Math.min(val\/max,1)*326.7); }\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ UPDATE\n\/\/ ═══════════════════════════════════════════════════════\nfunction doCheckUpdate(){\n  toast('Verificando atualização...','in');\n  let p=0; const prog=document.getElementById('upProg');\n  const t=setInterval(()=>{ p=Math.min(p+2,80); prog.style.width=p+'%'; },60);\n  A.checkUpdate();\n  \/\/ onConfigUpdated\/onConfigReloaded vão cuidar do resto\n  setTimeout(()=>{ clearInterval(t); prog.style.width='100%'; },4000);\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ NOTIFICAÇÕES (populadas com dados reais da config)\n\/\/ ═══════════════════════════════════════════════════════\nfunction populateNotifs(cfg, note, version, adsOn){\n  const items=[];\n  if(note) items.push({ico:'fa-circle-info',color:'var(--cyan)',   title:'Nota do Config', text:note});\n  if(version) items.push({ico:'fa-tag',     color:'var(--gold)',   title:'Versão',         text:'Config v'+version+' carregado'});\n  items.push({ico:'fa-shield-check',         color:'var(--green)', title:'Status do Sistema',text:'Interface inicializada com sucesso'});\n  items.push({ico:'fa-rectangle-ad',         color:adsOn?'var(--gold)':'var(--purple)', title:'Modo de Acesso', text:adsOn?'Free — assista anúncios para conectar':'VIP — acesso ilimitado ativo'});\n  document.getElementById('notifList').innerHTML=items.map(n=>`\n    <div style=\"display:flex;align-items:flex-start;gap:11px;padding:12px;border-radius:var(--r-md);background:var(--glass);border:1px solid var(--gb);\">\n      <div style=\"width:34px;height:34px;border-radius:9px;background:${n.color}22;display:flex;align-items:center;justify-content:center;flex-shrink:0\">\n        <i class=\"fa-solid ${n.ico}\" style=\"color:${n.color}\"><\/i>\n      <\/div>\n      <div style=\"flex:1\"><div style=\"font-weight:700;font-size:.86rem\">${n.title}<\/div>\n      <div style=\"font-size:.74rem;color:var(--muted);margin-top:2px\">${n.text}<\/div><\/div>\n    <\/div>`).join('');\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ THEME\n\/\/ ═══════════════════════════════════════════════════════\nfunction setTheme(t,el){\n  document.documentElement.setAttribute('data-theme',t);\n  document.querySelectorAll('.tsw').forEach(s=>s.classList.remove('active'));\n  el.classList.add('active');\n  toast('Tema: '+t,'in');\n}\nfunction setAccent(c){\n  document.documentElement.style.setProperty('--red',c);\n  const r=parseInt(c.slice(1,3),16),g=parseInt(c.slice(3,5),16),b=parseInt(c.slice(5,7),16);\n  document.documentElement.style.setProperty('--red-glow',`rgba(${r},${g},${b},.4)`);\n  document.documentElement.style.setProperty('--red-deep',`rgb(${Math.round(r*.65)},${Math.round(g*.65)},${Math.round(b*.65)})`);\n}\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ POLLING DE STATUS (fallback — só roda se o listener não foi ativado)\n\/\/ ═══════════════════════════════════════════════════════\nlet lastPolledState='';\nsetInterval(()=>{\n  if(listenerActive) return; \/\/ listener ativo → não faz poll\n  const s=A.getStatus();\n  if(s && s!==lastPolledState){ lastPolledState=s; updateStatusUI(s,''); }\n},2500);\n\n\/\/ ═══════════════════════════════════════════════════════\n\/\/ INIT\n\/\/ ═══════════════════════════════════════════════════════\n(function init(){\n  loadFromAndroid();\n  loadServers();\n  loadLogsFromApp();\n  loadCredentials();\n  \/\/ Estado inicial via bridge\n  const s=A.getStatus();\n  if(s) updateStatusUI(s,'');\n  toast('Yumeko BK carregado ⚔️','ok',3000);\n})();\n<\/script>\n<\/body>\n<\/html>@"
}
