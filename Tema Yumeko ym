       if(icon) icon.classList.remove('connecting-spinner');\n            \n            if (state === \"CONECTADO\") {\n                btn.classList.add('connected');\n                if(text) text.innerText = \"CONECTADO\";\n                if(icon) icon.setAttribute(\"data-lucide\", \"shield-check\");\n                if(statusLabel) { statusLabel.innerText = state; statusLabel.className = \"font-bold text-green-400\"; }\n                rings.forEach(r => { r.classList.remove('hide'); r.style.borderColor = \"#10b981\"; });\n            } \n            else if (state === \"PARANDO\") {\n                btn.classList.add('stopping');\n                if(text) text.innerText = \"PARANDO...\";\n                if(icon) icon.setAttribute(\"data-lucide\", \"power-off\");\n                if(statusLabel) { statusLabel.innerText = state; statusLabel.className = \"font-bold text-purple-400\"; }\n                rings.forEach(r => r.classList.add('hide'));\n            }\n            else if (state === \"DESCONECTADO\") {\n                if(text) text.innerText = \"CONECTAR\";\n                if(icon) icon.setAttribute(\"data-lucide\", \"power\");\n                if(statusLabel) { statusLabel.innerText = state; statusLabel.className = \"font-bold text-red-500\"; }\n                rings.forEach(r => { r.classList.add('hide'); r.style.borderColor = \"var(--theme-color)\"; });\n            } \n            else {\n                btn.classList.add('connecting');\n                if(text) text.innerText = state;\n                if(icon) { icon.setAttribute(\"data-lucide\", \"loader-2\"); icon.classList.add('connecting-spinner'); }\n                if(statusLabel) { statusLabel.innerText = state; statusLabel.className = \"font-bold text-yellow-400\"; }\n                rings.forEach(r => r.classList.add('hide'));\n            }\n            lucide.createIcons();\n        } catch(e) { console.error(\"onVpnStatus error:\", e); }\n    };\n    \n    window.onLogAdded = functio